---
import "@/styles/global.css";
import { getPageTitle } from "@/utils/ui";
import {
    Landmark,
    Home,
    ChartColumn,
    History,
    Menu,
    Tags,
    BanknoteArrowUp,
    BanknoteArrowDown,
    ReceiptText,
    Users,
    Building2,
    CalendarClock,
    Layers,
    Building,
    X,
    ChevronDown,
} from "@lucide/astro";
import Toaster from "@/lib/toast/Toaster.astro";
import UserNav from "@/components/UserNav.astro";
import BackupFreshnessNotice from "@/components/BackupFreshnessNotice.astro";

const { title, user } = Astro.props;
const currentPath = Astro.url.pathname;

interface NavLink {
    label: string;
    href: string;
    icon: any;
}

interface NavGroup {
    label: string;
    icon: any;
    baseHref: string;
    links: NavLink[];
}

const navGroups: NavGroup[] = [
    {
        label: "Finanzas",
        icon: Home,
        baseHref: "/",
        links: [
            { label: "Inicio", href: "/", icon: Home },
            { label: "Ingresos", href: "/ingresos", icon: BanknoteArrowUp },
            { label: "Egresos", href: "/egresos", icon: BanknoteArrowDown },
            { label: "Talonarios", href: "/talonarios", icon: ReceiptText },
            { label: "Reportes", href: "/reportes", icon: ChartColumn },
            { label: "Historial", href: "/historial", icon: History },
            { label: "Categorías", href: "/cuentas", icon: Tags },
        ],
    },
    {
        label: "RRHH",
        icon: Users,
        baseHref: "/rrhh",
        links: [
            { label: "Panel RRHH", href: "/rrhh", icon: Layers },
            { label: "Nómina", href: "/rrhh/personal", icon: Users },
            { label: "Salarios", href: "/rrhh/salarios", icon: CalendarClock },
            { label: "Sectores", href: "/rrhh/sectores", icon: Building2 },
        ],
    },
    {
        label: "Inmuebles",
        icon: Building,
        baseHref: "/inquilinos",
        links: [
            { label: "Inquilinos", href: "/inquilinos", icon: Building },
            { label: "Clientes", href: "/clientes", icon: Users },
        ],
    },
];

const isActiveLink = (href: string) => {
    if (href === "/") return currentPath === "/";
    return currentPath.startsWith(href);
};

const isActiveGroup = (group: NavGroup) => {
    if (group.baseHref === "/")
        return (
            currentPath === "/" ||
            group.links.some(
                (l) => l.href !== "/" && currentPath.startsWith(l.href),
            )
        );
    return currentPath.startsWith(group.baseHref);
};
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>{getPageTitle(title)}</title>
        <script is:inline>
            document.addEventListener("DOMContentLoaded", () => {
                // Mobile menu toggle
                const menuBtn = document.getElementById("mobile-menu-btn");
                const mobileMenu = document.getElementById("mobile-menu");
                menuBtn?.addEventListener("click", () => {
                    mobileMenu?.classList.toggle("hidden");
                });

                // Desktop group dropdowns
                document.querySelectorAll("[data-group-btn]").forEach((btn) => {
                    btn.addEventListener("click", (e) => {
                        e.stopPropagation();
                        const id = btn.getAttribute("data-group-btn");
                        const panel = document.getElementById(
                            `group-panel-${id}`,
                        );
                        const isOpen = !panel?.classList.contains("hidden");
                        // Close all
                        document
                            .querySelectorAll("[id^='group-panel-']")
                            .forEach((p) => p.classList.add("hidden"));
                        document
                            .querySelectorAll("[data-group-btn]")
                            .forEach((b) =>
                                b.setAttribute("data-open", "false"),
                            );
                        if (!isOpen) {
                            panel?.classList.remove("hidden");
                            btn.setAttribute("data-open", "true");
                        }
                    });
                });

                // Close on outside click
                document.addEventListener("click", () => {
                    document
                        .querySelectorAll("[id^='group-panel-']")
                        .forEach((p) => p.classList.add("hidden"));
                    document
                        .querySelectorAll("[data-group-btn]")
                        .forEach((b) => b.setAttribute("data-open", "false"));
                });

                // Mobile group accordion
                document
                    .querySelectorAll("[data-mobile-group-btn]")
                    .forEach((btn) => {
                        btn.addEventListener("click", () => {
                            const id = btn.getAttribute(
                                "data-mobile-group-btn",
                            );
                            const panel = document.getElementById(
                                `mobile-group-panel-${id}`,
                            );
                            panel?.classList.toggle("hidden");
                        });
                    });
            });
        </script>
    </head>
    <body class="flex flex-col min-h-screen bg-slate-50">
        <header class="border-b border-slate-200 bg-white sticky top-0 z-50">
            <div
                class="mx-auto flex gap-3 max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8"
            >
                <!-- Logo -->
                <div class="flex items-center gap-3 shrink-0">
                    <div class="bg-emerald-100 p-2 rounded-lg">
                        <Landmark class="size-5 text-emerald-600" />
                    </div>
                    <div>
                        <a href="/">
                            <h1
                                class="text-lg font-semibold text-slate-900 leading-tight"
                            >
                                Administración
                            </h1>
                            <p class="text-xs text-slate-500">
                                Trans Carrasco Tropical
                            </p>
                        </a>
                    </div>
                </div>

                <!-- Desktop Nav with grouped dropdowns -->
                <nav
                    class="hidden md:flex items-center gap-1 ml-auto bg-slate-100/80 rounded-xl p-1.5 border border-slate-200/60"
                >
                    {
                        navGroups.map((group, i) => {
                            const groupActive = isActiveGroup(group);
                            const singleLink = group.links.length === 1;
                            return singleLink ? (
                                <a
                                    href={group.links[0].href}
                                    class:list={[
                                        "flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200",
                                        groupActive
                                            ? "bg-white text-emerald-700 shadow-sm ring-1 ring-black/5"
                                            : "text-slate-600 hover:text-slate-900 hover:bg-white/60",
                                    ]}
                                >
                                    <group.icon
                                        class:list={[
                                            groupActive
                                                ? "size-4 text-emerald-600"
                                                : "size-4 text-slate-500",
                                        ]}
                                    />
                                    {group.label}
                                </a>
                            ) : (
                                <div class="relative">
                                    <button
                                        data-group-btn={i}
                                        data-open="false"
                                        class:list={[
                                            "flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200 cursor-pointer select-none",
                                            groupActive
                                                ? "bg-white text-emerald-700 shadow-sm ring-1 ring-black/5"
                                                : "text-slate-600 hover:text-slate-900 hover:bg-white/60",
                                        ]}
                                    >
                                        <group.icon
                                            class:list={[
                                                groupActive
                                                    ? "size-4 text-emerald-600"
                                                    : "size-4 text-slate-500",
                                            ]}
                                        />
                                        {group.label}
                                        <ChevronDown class="size-3 opacity-50" />
                                    </button>
                                    <div
                                        id={`group-panel-${i}`}
                                        class="hidden absolute left-0 mt-2 w-52 rounded-xl border border-slate-200 bg-white p-2 shadow-lg z-50"
                                    >
                                        {group.links.map((link) => {
                                            const active = isActiveLink(
                                                link.href,
                                            );
                                            return (
                                                <a
                                                    href={link.href}
                                                    class:list={[
                                                        "flex items-center gap-2.5 px-3 py-2 text-sm rounded-lg mb-0.5 last:mb-0 transition-colors",
                                                        active
                                                            ? "bg-emerald-50 text-emerald-700 font-medium"
                                                            : "text-slate-700 hover:bg-slate-50",
                                                    ]}
                                                >
                                                    <link.icon
                                                        class:list={[
                                                            active
                                                                ? "size-4 text-emerald-500"
                                                                : "size-4 text-slate-400",
                                                        ]}
                                                    />
                                                    {link.label}
                                                    {active && (
                                                        <span class="ml-auto w-1.5 h-1.5 rounded-full bg-emerald-500" />
                                                    )}
                                                </a>
                                            );
                                        })}
                                    </div>
                                </div>
                            );
                        })
                    }
                </nav>

                <div class="flex items-center gap-2">
                    <UserNav user={user} />
                    <button
                        id="mobile-menu-btn"
                        class="md:hidden p-2 text-slate-600 hover:bg-slate-100 rounded-lg transition-colors"
                        aria-label="Abrir menú"
                    >
                        <Menu class="size-5" />
                    </button>
                </div>
            </div>

            <!-- Mobile Menu -->
            <div
                id="mobile-menu"
                class="hidden md:hidden border-t border-slate-200 bg-white"
            >
                <nav class="mx-auto max-w-6xl flex flex-col p-2 gap-0.5">
                    {
                        navGroups.map((group, i) => {
                            const groupActive = isActiveGroup(group);
                            return (
                                <div>
                                    <button
                                        data-mobile-group-btn={i}
                                        class:list={[
                                            "w-full flex items-center gap-3 px-4 py-3 text-sm font-semibold rounded-lg transition-all duration-200",
                                            groupActive
                                                ? "bg-emerald-50 text-emerald-700"
                                                : "text-slate-700 hover:bg-slate-50",
                                        ]}
                                    >
                                        <group.icon
                                            class:list={[
                                                groupActive
                                                    ? "size-4 text-emerald-600"
                                                    : "size-4 text-slate-400",
                                            ]}
                                        />
                                        <span class="flex-1 text-left">
                                            {group.label}
                                        </span>
                                        <ChevronDown class="size-4 text-slate-400" />
                                    </button>
                                    <div
                                        id={`mobile-group-panel-${i}`}
                                        class:list={[
                                            "pl-4 space-y-0.5 mb-1",
                                            !groupActive && "hidden",
                                        ]}
                                    >
                                        {group.links.map((link) => {
                                            const active = isActiveLink(
                                                link.href,
                                            );
                                            return (
                                                <a
                                                    href={link.href}
                                                    class:list={[
                                                        "flex items-center gap-3 px-4 py-2.5 text-sm rounded-lg transition-colors",
                                                        active
                                                            ? "bg-white text-emerald-700 font-medium border border-emerald-100"
                                                            : "text-slate-600 hover:bg-slate-50 hover:text-slate-900",
                                                    ]}
                                                >
                                                    <link.icon
                                                        class:list={[
                                                            active
                                                                ? "size-4 text-emerald-500"
                                                                : "size-4 text-slate-400",
                                                        ]}
                                                    />
                                                    {link.label}
                                                    {active && (
                                                        <span class="ml-auto w-1.5 h-1.5 rounded-full bg-emerald-500" />
                                                    )}
                                                </a>
                                            );
                                        })}
                                    </div>
                                </div>
                            );
                        })
                    }
                </nav>
            </div>
        </header>

        <BackupFreshnessNotice userRole={user.role} />

        <main class="flex-1">
            <slot />
            <Toaster richColors position="top-center" />
        </main>

        <style>
            html,
            body {
                margin: 0;
                padding: 0;
                width: 100%;
            }
        </style>
    </body>
</html>
