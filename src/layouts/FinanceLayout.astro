---
import "@/styles/global.css";
import { getPageTitle } from "@/utils/ui";
import {
    Landmark,
    Home,
    ChartColumn,
    History,
    Menu,
    Tags,
    BanknoteArrowUp,
    BanknoteArrowDown,
    ReceiptText,
    ChevronsUpDown,
} from "@lucide/astro";
import Toaster from "@/lib/toast/Toaster.astro";
import UserNav from "@/components/UserNav.astro";
import BackupFreshnessNotice from "@/components/BackupFreshnessNotice.astro";
// import type { UserRole } from "@/auth/types";

const { title, user } = Astro.props;
const currentPath = Astro.url.pathname;

interface FinanceNavLink {
    label: string;
    href: string;
    icon: any;
}

const navLinks: FinanceNavLink[] = [
    { label: "Finanzas", href: "/", icon: Home },
    {
        label: "Ingresos",
        href: "/ingresos",
        icon: BanknoteArrowUp,
    },
    {
        label: "Egresos",
        href: "/egresos",
        icon: BanknoteArrowDown,
    },
    {
        label: "Talonarios",
        href: "/talonarios",
        icon: ReceiptText,
    },
    {
        label: "Reportes",
        href: "/reportes",
        icon: ChartColumn,
    },
    {
        label: "Historial",
        href: "/historial",
        icon: History,
    },
    {
        label: "Categorias",
        href: "/cuentas",
        icon: Tags,
    },
];

const visibleNavLinks = navLinks.slice(0, 3);
const extraNavLinks = navLinks.slice(3);

// Helper to check active state
const isActiveLink = (href: string) => {
    if (href === "/") {
        return currentPath === "/";
    }
    return currentPath.startsWith(href);
};
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>{getPageTitle(title)}</title>
        <script is:inline>
            // Mobile menu toggle
            document.addEventListener("DOMContentLoaded", () => {
                const menuBtn = document.getElementById("mobile-menu-btn");
                const mobileMenu = document.getElementById("mobile-menu");

                menuBtn?.addEventListener("click", () => {
                    mobileMenu?.classList.toggle("hidden");
                });

                const moreBtn = document.getElementById("mobile-more-btn");
                const moreMenu = document.getElementById("mobile-more-menu");
                moreBtn?.addEventListener("click", () => {
                    moreMenu?.classList.toggle("hidden");
                });
            });
        </script>
    </head>
    <body class="flex flex-col min-h-screen bg-slate-50">
        <header class="border-b border-slate-200 bg-white sticky top-0 z-50">
            <div
                class="mx-auto flex gap-3 max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8"
            >
                <!-- Logo Section -->
                <div class="flex items-center gap-3">
                    <div class="bg-emerald-100 p-2 rounded-lg">
                        <Landmark class="size-5 text-emerald-600" />
                    </div>
                    <div>
                        <a href="/">
                            <h1
                                class="text-lg font-semibold text-slate-900 leading-tight"
                            >
                                Administración
                            </h1>
                            <p class="text-xs text-slate-500">
                                Trans Carrasco Tropical
                            </p>
                        </a>
                    </div>
                </div>

                <!-- Desktop Navigation -->
                <nav
                    class="hidden md:flex items-center gap-1 ml-auto bg-slate-100/80 rounded-xl p-1.5 border border-slate-200/60"
                >
                    {
                        visibleNavLinks.map((link) => {
                            const isActive = isActiveLink(link.href);
                            return (
                                <a
                                    href={link.href}
                                    class:list={[
                                        "flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200",
                                        isActive
                                            ? "bg-white text-emerald-700 shadow-sm ring-1 ring-black/5"
                                            : "text-slate-600 hover:text-slate-900 hover:bg-white/60",
                                    ]}
                                >
                                    {link.icon && (
                                        <link.icon
                                            className={
                                                isActive
                                                    ? "size-4 text-emerald-600"
                                                    : "size-4 text-slate-500"
                                            }
                                        />
                                    )}
                                    {link.label}
                                </a>
                            );
                        })
                    }
                    {
                        extraNavLinks.length > 0 && (
                            <details class="relative">
                                <summary class="list-none flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200 text-slate-600 hover:text-slate-900 hover:bg-white/60 cursor-pointer">
                                    <ChevronsUpDown class="size-4" />
                                    Mas
                                </summary>
                                <div class="absolute right-0 mt-2 w-56 rounded-lg border border-slate-200 bg-white p-2 shadow-lg">
                                    {extraNavLinks.map((link) => {
                                        const isActive = isActiveLink(
                                            link.href,
                                        );
                                        return (
                                            <a
                                                href={link.href}
                                                class:list={[
                                                    "mb-1 last:mb-0 flex items-center gap-2 px-3 py-2 text-sm rounded-md transition-colors",
                                                    isActive
                                                        ? "bg-emerald-50 text-emerald-700"
                                                        : "text-slate-700 hover:bg-slate-50",
                                                ]}
                                            >
                                                {link.icon && (
                                                    <link.icon
                                                        className={
                                                            isActive
                                                                ? "size-4 text-emerald-600"
                                                                : "size-4 text-slate-500"
                                                        }
                                                    />
                                                )}
                                                {link.label}
                                            </a>
                                        );
                                    })}
                                </div>
                            </details>
                        )
                    }
                </nav>

                <div class="flex items-center gap-2">
                    <UserNav user={user} />

                    <button
                        id="mobile-menu-btn"
                        class="md:hidden p-2 text-slate-600 hover:bg-slate-100 rounded-lg transition-colors"
                        aria-label="Toggle menu"
                    >
                        <Menu class="size-5" />
                    </button>
                </div>
            </div>

            <!-- Mobile Menu -->
            <div
                id="mobile-menu"
                class="hidden md:hidden border-t border-slate-200 bg-white"
            >
                <nav
                    class="mx-auto max-w-6xl flex flex-col p-2 sm:px-6 lg:px-8 gap-1"
                >
                    {
                        visibleNavLinks.map((link) => {
                            const isActive = isActiveLink(link.href);
                            return (
                                <a
                                    href={link.href}
                                    class:list={[
                                        "flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-lg transition-all duration-200",
                                        isActive
                                            ? "bg-emerald-50 text-emerald-700 border border-emerald-100"
                                            : "text-slate-600 hover:text-slate-900 hover:bg-slate-50",
                                    ]}
                                >
                                    {link.icon && (
                                        <link.icon
                                            className={
                                                isActive
                                                    ? "size-4 text-emerald-600"
                                                    : "size-4 text-slate-400"
                                            }
                                        />
                                    )}
                                    <span>{link.label}</span>
                                    {isActive && (
                                        <span class="ml-auto w-1.5 h-1.5 rounded-full bg-emerald-500" />
                                    )}
                                </a>
                            );
                        })
                    }
                    {
                        extraNavLinks.length > 0 && (
                            <>
                                <button
                                    id="mobile-more-btn"
                                    type="button"
                                    class="flex items-center justify-between gap-3 px-4 py-3 text-sm font-medium rounded-lg transition-all duration-200 text-slate-600 hover:text-slate-900 hover:bg-slate-50"
                                >
                                    <span>Mas opciones</span>
                                </button>
                                <div
                                    id="mobile-more-menu"
                                    class="hidden space-y-1"
                                >
                                    {extraNavLinks.map((link) => {
                                        const isActive = isActiveLink(
                                            link.href,
                                        );
                                        return (
                                            <a
                                                href={link.href}
                                                class:list={[
                                                    "ml-3 flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-lg transition-all duration-200",
                                                    isActive
                                                        ? "bg-emerald-50 text-emerald-700 border border-emerald-100"
                                                        : "text-slate-600 hover:text-slate-900 hover:bg-slate-50",
                                                ]}
                                            >
                                                {link.icon && (
                                                    <link.icon
                                                        className={
                                                            isActive
                                                                ? "size-4 text-emerald-600"
                                                                : "size-4 text-slate-400"
                                                        }
                                                    />
                                                )}
                                                <span>{link.label}</span>
                                            </a>
                                        );
                                    })}
                                </div>
                            </>
                        )
                    }
                </nav>
            </div>
        </header>
        <BackupFreshnessNotice userRole={user.role} />

        <main class="flex-1">
            <slot />
            <Toaster richColors position="top-center" />
        </main>

        <style>
            html,
            body {
                margin: 0;
                padding: 0;
                width: 100%;
            }
        </style>
    </body>
</html>
