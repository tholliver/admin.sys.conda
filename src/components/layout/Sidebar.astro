---
import { Landmark, ChevronDown } from "@lucide/astro";
import { navGroups, type NavGroup } from "@/config/nav";

const { currentPath } = Astro.props;

const isActiveLink = (href: string) => {
    if (href === "/") return currentPath === "/";
    return currentPath.startsWith(href);
};

const isActiveGroup = (group: NavGroup) => {
    if (group.baseHref === "/")
        return (
            currentPath === "/" ||
            group.links.some(
                (l) => l.href !== "/" && currentPath.startsWith(l.href),
            )
        );
    return currentPath.startsWith(group.baseHref);
};
---

<aside
    id="app-sidebar"
    data-collapsed="false"
    class="sidebar-shell"
    aria-label="Barra de navegación"
>
    <!-- Header -->
    <div class="sidebar-header">
        <div class="sidebar-brand">
            <div class="brand-icon">
                <Landmark class="size-4 text-emerald-600" />
            </div>
            <div class="sidebar-label brand-text">
                <p class="brand-name">Administración</p>
                <p class="brand-sub">Trans Carrasco Tropical</p>
            </div>
        </div>
    </div>

    <!-- Nav -->
    <nav class="sidebar-nav" aria-label="Menú principal">
        {
            navGroups.map((group, i) => {
                const groupActive = isActiveGroup(group);
                // FIX: point to first real child link, not a ghost baseHref
                const collapsedHref = group.links[0].href;

                return (
                    <div class="nav-group">
                        <button
                            data-accordion-btn={i}
                            data-href={collapsedHref}
                            data-open={groupActive ? "true" : "false"}
                            aria-controls={`accordion-panel-${i}`}
                            aria-expanded={groupActive ? "true" : "false"}
                            data-tooltip={group.label}
                            class:list={[
                                "nav-group-trigger",
                                groupActive && "nav-group-trigger--active",
                            ]}
                        >
                            <group.icon
                                class:list={[
                                    "nav-icon",
                                    groupActive
                                        ? "nav-icon--active"
                                        : "nav-icon--muted",
                                ]}
                            />
                            <span class="sidebar-label nav-group-label">
                                {group.label}
                            </span>
                            <ChevronDown class="sidebar-label sidebar-chevron nav-chevron" />
                        </button>

                        <div
                            id={`accordion-panel-${i}`}
                            class:list={[
                                "nav-subnav",
                                !groupActive && "hidden",
                            ]}
                        >
                            {group.links.map((link) => {
                                const active = isActiveLink(link.href);
                                return (
                                    <a
                                        href={link.href}
                                        class:list={[
                                            "nav-link",
                                            active
                                                ? "nav-link--active"
                                                : "nav-link--idle",
                                        ]}
                                    >
                                        <link.icon
                                            class:list={[
                                                "nav-icon",
                                                active
                                                    ? "nav-icon--active"
                                                    : "nav-icon--muted",
                                            ]}
                                        />
                                        <span class="sidebar-label">
                                            {link.label}
                                        </span>
                                        {active && (
                                            <span
                                                class="sidebar-label nav-active-dot"
                                                aria-hidden="true"
                                            />
                                        )}
                                    </a>
                                );
                            })}
                        </div>
                    </div>
                );
            })
        }
    </nav>
</aside>

<style>
    /* ── Shell ───────────────────────────────────────────── */
    .sidebar-shell {
        position: fixed;
        inset: 0 auto 0 0;
        height: 100vh;
        width: var(--sidebar-width);
        display: flex;
        flex-direction: column;
        background: var(--background);
        border-right: 1px solid var(--border);
        transition: width 220ms cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
        z-index: 50;
    }

    #app-sidebar[data-collapsed="true"] {
        width: var(--sidebar-collapsed-width);
    }

    /* Hide labels/subnav/chevron when collapsed */
    #app-sidebar[data-collapsed="true"] .sidebar-label,
    #app-sidebar[data-collapsed="true"] .nav-subnav,
    #app-sidebar[data-collapsed="true"] .sidebar-chevron {
        display: none;
    }

    #app-sidebar[data-collapsed="true"] .nav-group-trigger {
        justify-content: center;
    }

    #app-sidebar[data-collapsed="true"] .sidebar-brand {
        justify-content: center;
    }

    /* ── Header ──────────────────────────────────────────── */
    .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        padding: 0.875rem 0.75rem 0.875rem 1rem;
        border-bottom: 1px solid var(--border);
        position: relative;
        min-height: 56px;
    }

    .sidebar-brand {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        min-width: 0;
    }

    .brand-icon {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 0.5rem;
        background: oklch(0.96 0.04 150);
        border: 1px solid oklch(0.88 0.08 150);
    }

    .brand-text {
        min-width: 0;
    }

    .brand-name {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--foreground);
        line-height: 1.3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .brand-sub {
        font-size: 0.6875rem;
        color: var(--muted-foreground);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ── Nav ─────────────────────────────────────────────── */
    .sidebar-nav {
        flex: 1;
        padding: 0.5rem 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: thin;
        scrollbar-color: var(--border) transparent;
    }

    .nav-group {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
    }

    /* Group trigger — shadcn SidebarMenuButton feel */
    .nav-group-trigger {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        width: 100%;
        padding: 0.5rem 0.625rem;
        border-radius: 0.5rem;
        border: none;
        background: transparent;
        color: var(--muted-foreground);
        font-size: 0.8125rem;
        font-weight: 500;
        cursor: pointer;
        text-align: left;
        transition:
            background 140ms,
            color 140ms;
        position: relative;
    }

    .nav-group-trigger:hover {
        background: var(--secondary);
        color: var(--foreground);
    }

    .nav-group-trigger--active {
        background: var(--secondary);
        color: var(--foreground);
        font-weight: 600;
    }

    /* Subnav */
    .nav-subnav {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        padding-left: 1rem;
        margin-left: 0.875rem;
        border-left: 1px solid var(--border);
    }

    .nav-subnav.hidden {
        display: none;
    }

    /* Links */
    .nav-link {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.4rem 0.625rem;
        border-radius: 0.4rem;
        font-size: 0.8125rem;
        text-decoration: none;
        transition:
            background 140ms,
            color 140ms;
        position: relative;
    }

    .nav-link--idle {
        color: var(--muted-foreground);
    }

    .nav-link--idle:hover {
        background: var(--secondary);
        color: var(--foreground);
    }

    .nav-link--active {
        background: oklch(0.95 0.04 150 / 0.7);
        color: oklch(0.38 0.14 150);
        font-weight: 500;
    }

    /* Icons */
    .nav-icon {
        flex-shrink: 0;
        width: 1rem;
        height: 1rem;
    }

    .nav-icon--active {
        color: oklch(0.5 0.16 150);
    }

    .nav-icon--muted {
        color: var(--muted-foreground);
        opacity: 0.75;
    }

    .nav-active-dot {
        margin-left: auto;
        width: 0.375rem;
        height: 0.375rem;
        border-radius: 9999px;
        background: oklch(0.55 0.18 150);
        flex-shrink: 0;
    }

    .nav-group-label {
        flex: 1;
    }

    .nav-chevron {
        width: 0.875rem;
        height: 0.875rem;
        flex-shrink: 0;
        color: var(--muted-foreground);
        transition: transform 200ms ease;
        opacity: 0.6;
    }

    [data-open="true"] .nav-chevron {
        transform: rotate(180deg);
    }

    /* ── Mobile ──────────────────────────────────────────── */
    @media (max-width: 1024px) {
        .sidebar-shell {
            position: fixed;
            inset: 0 auto 0 0;
            transform: translateX(-100%);
            width: min(90vw, var(--sidebar-width));
            transition: transform 220ms cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 4px 0 24px rgba(0, 0, 0, 0.08);
        }

        .sidebar-shell.sidebar-mobile-open {
            transform: translateX(0);
        }
    }
</style>
