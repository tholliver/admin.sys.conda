<!-- SidebarScript.astro — all sidebar JS in one place, zero inline script in Layout -->
<script is:inline>
    (function () {
        const STORAGE_KEY = "financeSidebarCollapsed";
        const SUBMENU_STORAGE_PREFIX = "financeSubmenu_";
        const MOBILE_QUERY = "(max-width: 1024px)";

        function applyCollapsed(value) {
            const sidebar = document.getElementById("app-sidebar");
            const body = document.body;
            if (!sidebar) return;
            sidebar.setAttribute("data-collapsed", value);
            body.setAttribute("data-sidebar-collapsed", value);
        }

        function initSidebar() {
            const sidebar = document.getElementById("app-sidebar");
            const mobileToggleBtn = document.getElementById("sidebar-mobile-btn");
            const desktopToggleBtns = document.querySelectorAll(
                "[data-sidebar-desktop-toggle]",
            );
            const mobileOverlay = document.getElementById("sidebar-overlay");
            const media = window.matchMedia(MOBILE_QUERY);

            if (!sidebar) return;

            const setToggleExpanded = (expanded) => {
                const value = String(expanded);
                mobileToggleBtn?.setAttribute("aria-expanded", value);
                desktopToggleBtns.forEach((btn) =>
                    btn.setAttribute("aria-expanded", value),
                );
            };

            // --- Restore persisted state ---
            const stored = localStorage.getItem(STORAGE_KEY);
            const restoreDesktopState = () => {
                if (stored === "true" || stored === "false") {
                    applyCollapsed(stored);
                    setToggleExpanded(stored === "false");
                }
            };

            const applyMobileDefaults = () => {
                applyCollapsed("false");
                setToggleExpanded(false);
            };

            const syncViewport = () => {
                if (media.matches) {
                    applyMobileDefaults();
                } else {
                    restoreDesktopState();
                }
            };

            syncViewport();

            const toggleMobile = () => {
                sidebar.classList.toggle("sidebar-mobile-open");
                mobileOverlay?.classList.toggle("hidden");
                document.body.classList.toggle("overflow-hidden");
                document.body.classList.toggle("sidebar-mobile-open");
                const isOpen = sidebar.classList.contains(
                    "sidebar-mobile-open",
                );
                setToggleExpanded(isOpen);
            };

            const toggleDesktop = () => {
                const isCollapsed =
                    sidebar.getAttribute("data-collapsed") === "true";
                const next = String(!isCollapsed);
                applyCollapsed(next);
                localStorage.setItem(STORAGE_KEY, next);
                setToggleExpanded(next === "false");
            };

            mobileToggleBtn?.addEventListener("click", () => {
                if (media.matches) {
                    toggleMobile();
                } else {
                    toggleDesktop();
                }
            });
            desktopToggleBtns.forEach((btn) => {
                btn.addEventListener("click", () => {
                    if (!media.matches) {
                        toggleDesktop();
                    }
                });
            });
            mobileOverlay?.addEventListener("click", () => {
                if (media.matches) toggleMobile();
            });

            media.addEventListener("change", () => {
                // Reset mobile sheet state when crossing breakpoints
                sidebar.classList.remove("sidebar-mobile-open");
                mobileOverlay?.classList.add("hidden");
                document.body.classList.remove(
                    "overflow-hidden",
                    "sidebar-mobile-open",
                );
                syncViewport();
            });

            // --- Independent accordion (each group toggles on its own) ---
            document.querySelectorAll("[data-accordion-btn]").forEach((btn) => {
                const id = btn.getAttribute("data-accordion-btn");
                const panel = document.getElementById(
                    `accordion-panel-${id}`,
                );

                // Restore submenu state from localStorage
                if (panel) {
                    const storedSubmenu = localStorage.getItem(`${SUBMENU_STORAGE_PREFIX}${id}`);
                    if (storedSubmenu !== null) {
                        const isOpen = storedSubmenu === "true";
                        if (!isOpen) {
                            panel.classList.add("hidden");
                            btn.setAttribute("data-open", "false");
                            btn.setAttribute("aria-expanded", "false");
                        }
                    }
                }

                btn.addEventListener("click", () => {
                    // When collapsed: navigate to the group's first real link
                    if (sidebar.getAttribute("data-collapsed") === "true") {
                        const href = btn.getAttribute("data-href");
                        if (href) window.location.href = href;
                        return;
                    }

                    if (!panel) return;

                    const isOpen = btn.getAttribute("data-open") === "true";

                    if (isOpen) {
                        // Close this group with animation
                        btn.setAttribute("data-open", "false");
                        btn.setAttribute("aria-expanded", "false");
                        localStorage.setItem(`${SUBMENU_STORAGE_PREFIX}${id}`, "false");

                        panel.style.maxHeight = panel.scrollHeight + "px";
                        requestAnimationFrame(() => {
                            panel.style.maxHeight = "0";
                        });
                    } else {
                        // Open this group with animation
                        btn.setAttribute("data-open", "true");
                        btn.setAttribute("aria-expanded", "true");
                        localStorage.setItem(`${SUBMENU_STORAGE_PREFIX}${id}`, "true");

                        panel.classList.remove("hidden");
                        panel.style.maxHeight = "0";
                        requestAnimationFrame(() => {
                            panel.style.maxHeight = panel.scrollHeight + "px";
                        });
                    }

                    // Clean up inline style after transition
                    panel.addEventListener("transitionend", function handler() {
                        panel.removeEventListener("transitionend", handler);
                        if (btn.getAttribute("data-open") === "true") {
                            panel.style.maxHeight = "none";
                        }
                    }, { once: true });
                });
            });

            // --- Tooltips (collapsed mode only) — uses shared tooltip.ts action ---
            let tooltipDestroyFns = [];

            function bindTooltips() {
                tooltipDestroyFns.forEach((fn) => fn());
                tooltipDestroyFns = [];

                const isCollapsed = sidebar.getAttribute("data-collapsed") === "true";
                if (!isCollapsed) return;

                import("/src/lib/actions/tooltip.ts").then(({ tooltip: tooltipAction }) => {
                    document.querySelectorAll("[data-tooltip]").forEach((el) => {
                        const content = el.getAttribute("data-tooltip") ?? "";
                        const instance = tooltipAction(el, { content, side: "right" });
                        if (instance?.destroy) tooltipDestroyFns.push(instance.destroy);
                    });
                });
            }

            bindTooltips();

            const collapseObserver = new MutationObserver(() => bindTooltips());
            collapseObserver.observe(sidebar, { attributes: true, attributeFilter: ["data-collapsed"] });
        }

        document.addEventListener("DOMContentLoaded", initSidebar);
    })();
</script>
