---
import { PanelLeft } from "@lucide/astro";
import UserNav from "@/components/UserNav.astro";

const { title, user } = Astro.props;
---

<header class="topbar">
    <div class="topbar-inner">
        <!-- Mobile hamburger -->
        <button
            id="sidebar-mobile-btn"
            class="mobile-menu-btn"
            aria-label="Alternar barra lateral"
            aria-expanded="false"
        >
            <PanelLeft class="size-5" />
        </button>

        <!-- Breadcrumb -->
        <div class="topbar-breadcrumb">
            <span class="topbar-breadcrumb-root">Panel</span>
            <span class="topbar-breadcrumb-sep" aria-hidden="true">/</span>
            <span class="topbar-breadcrumb-current">{title}</span>
        </div>

        <!-- User nav -->
        <div class="topbar-actions">
            <UserNav user={user} />
        </div>
    </div>
</header>

<style>
    .topbar {
        position: sticky;
        top: 0;
        z-index: 40;
        background: oklch(1 0 0 / 0.92);
        border-bottom: 1px solid var(--border);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .topbar-inner {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.625rem 1.5rem;
        min-height: 56px;
    }

    .mobile-menu-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 0.4rem;
        border: 1px solid var(--border);
        background: var(--background);
        color: var(--foreground);
        cursor: pointer;
        transition: background 140ms;
        flex-shrink: 0;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
        position: relative;
        z-index: 60;
    }

    .mobile-menu-btn:hover {
        background: var(--secondary);
        color: var(--foreground);
    }

    .topbar-breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.8125rem;
    }

    .topbar-breadcrumb-root {
        color: var(--muted-foreground);
    }

    @media (max-width: 480px) {
        .topbar-breadcrumb-root,
        .topbar-breadcrumb-sep {
            display: none;
        }
    }

    .topbar-breadcrumb-sep {
        color: var(--border);
        user-select: none;
    }

    .topbar-breadcrumb-current {
        font-weight: 600;
        color: var(--foreground);
    }

    .topbar-actions {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
</style>
