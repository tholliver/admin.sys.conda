---
import { PanelLeft } from "@lucide/astro";
import GenerateDebtsWidget from "@/components/svelte/GenerateDebtsWidget.svelte";
import { getHoursSinceLastBackup } from "@/lib/server/backup.service";
import { db } from "@/db";
import { employees, employeeFees, tenants, tenantPayments } from "@/db/schema";
import { and, eq, isNull, inArray, count } from "drizzle-orm";

const { title, user } = Astro.props;

const ADMIN_ROLES = ["ADMIN", "ADMON", "ACTS", "ACCO"];
const canSeeAlerts = ADMIN_ROLES.includes(user?.role ?? "");

// ── Backup alert ───────────────────────────────────────────────────────
const BACKUP_WARN_HOURS     = 24;
const BACKUP_CRITICAL_HOURS = 72;

let backupLevel: "warning" | "critical" | null = null;
let backupLabel = "";

if (canSeeAlerts) {
    try {
        const hours = await getHoursSinceLastBackup();
        if (hours === null) {
            backupLevel = "critical";
            backupLabel = "Sin respaldos registrados";
        } else if (hours > BACKUP_WARN_HOURS) {
            backupLevel = hours > BACKUP_CRITICAL_HOURS ? "critical" : "warning";
            backupLabel = `Último respaldo hace ${hours}h`;
        }
    } catch {
        backupLevel = "critical";
        backupLabel = "No se pudo verificar respaldos";
    }
}

// ── Pending payments alert ─────────────────────────────────────────────
let gapCount     = 0;
let missingTotal = 0;
let overdueTotal = 0;
let missingEmp   = 0;
let missingTen   = 0;
let overdueEmp   = 0;
let overdueTen   = 0;
let period       = "";

if (canSeeAlerts) {
    try {
        const now = new Date();
        period = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;

        const [
            unpaidEmpRow,
            unpaidTenRow,
            activeEmpCount,
            activeEmpGenRow,
            activeTenCount,
            activeTenGenRow,
        ] = await Promise.all([
            db.select({ n: count() }).from(employeeFees).where(eq(employeeFees.status, "pendiente")),
            db.select({ n: count() }).from(tenantPayments).where(eq(tenantPayments.status, "pendiente")),
            db.select({ n: count() }).from(employees).where(
                and(isNull(employees.deletedAt), inArray(employees.status, ["activo", "suspendido", "licencia"]))
            ),
            db.select({ n: count() }).from(employeeFees).where(eq(employeeFees.period, period)),
            db.select({ n: count() }).from(tenants).where(
                and(isNull(tenants.deletedAt), inArray(tenants.status, ["activo", "moroso"]))
            ),
            db.select({ n: count() }).from(tenantPayments).where(eq(tenantPayments.period, period)),
        ]);

        overdueEmp   = Number(unpaidEmpRow[0]?.n   ?? 0);
        overdueTen   = Number(unpaidTenRow[0]?.n   ?? 0);
        missingEmp   = Math.max(0, Number(activeEmpCount[0]?.n ?? 0) - Number(activeEmpGenRow[0]?.n ?? 0));
        missingTen   = Math.max(0, Number(activeTenCount[0]?.n ?? 0) - Number(activeTenGenRow[0]?.n ?? 0));
        missingTotal = missingEmp + missingTen;
        overdueTotal = overdueEmp + overdueTen;
        gapCount     = missingTotal + overdueTotal;
    } catch {
        // Silently fail — topbar must never crash the layout
    }
}

const unpaidEmp = overdueEmp;
const unpaidTen = overdueTen;

const showWidget = canSeeAlerts && (
    gapCount > 0 ||
    backupLevel !== null
);
---

<header class="topbar">
    <div class="topbar-inner">

        <button
            id="sidebar-mobile-btn"
            class="mobile-menu-btn"
            aria-label="Alternar barra lateral"
            aria-expanded="false"
        >
            <PanelLeft class="size-5" />
        </button>

        <div class="topbar-breadcrumb">
            <span class="topbar-breadcrumb-root">Panel</span>
            <span class="topbar-breadcrumb-sep" aria-hidden="true">/</span>
            <span class="topbar-breadcrumb-current">{title}</span>
        </div>

        <div class="topbar-actions">
            {showWidget && (
                <GenerateDebtsWidget
                    client:load
                    {missingEmp}
                    {missingTen}
                    unpaidEmp={unpaidEmp}
                    unpaidTen={unpaidTen}
                    currentPeriod={period}
                    backupLevel={backupLevel}
                    backupLabel={backupLabel}
                />
            )}
        </div>
    </div>
</header>

<style>
    .topbar {
        position: sticky;
        top: 0;
        z-index: 40;
        background: oklch(1 0 0 / 0.92);
        border-bottom: 1px solid var(--border);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .topbar-inner {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.625rem 1.5rem;
        min-height: 56px;
    }

    .mobile-menu-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 0.4rem;
        border: 1px solid var(--border);
        background: var(--background);
        color: var(--foreground);
        cursor: pointer;
        transition: background 140ms;
        flex-shrink: 0;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
        position: relative;
        z-index: 60;
    }

    .mobile-menu-btn:hover { background: var(--secondary); }

    .topbar-breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.8125rem;
    }

    .topbar-breadcrumb-root { color: var(--muted-foreground); }

    @media (max-width: 480px) {
        .topbar-breadcrumb-root,
        .topbar-breadcrumb-sep { display: none; }
    }

    .topbar-breadcrumb-sep { color: var(--border); user-select: none; }

    .topbar-breadcrumb-current { font-weight: 600; color: var(--foreground); }

    .topbar-actions {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }
</style>
