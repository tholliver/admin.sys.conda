---
const { user } = Astro.props;

const getInitials = (name: string) => {
    if (!name) return "??";
    return name
        .split(" ")
        .map((n) => n[0])
        .join("")
        .toUpperCase()
        .slice(0, 2);
};
---

<div class="relative inline-block text-left">
    <button
        type="button"
        class="flex items-center gap-3 px-2 py-1 rounded-lg hover:bg-gray-100 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20"
        data-user-button
    >
        <div
            class="flex items-center justify-center w-10 h-10 rounded-full bg-blue-600 text-white font-semibold text-sm"
        >
            {getInitials(user.name || "")}
        </div>
        <div class="hidden md:flex flex-col text-left">
            <span class="text-sm font-medium text-gray-900 leading-tight"
                >{user.name}</span
            >
            <span class="text-xs text-gray-500 truncate max-w-38"
                >{user.email}</span
            >
        </div>
    </button>

    <div
        class="hidden absolute right-0 mt-2 w-56 origin-top-right rounded-xl bg-white border border-gray-200 shadow-xl z-50 overflow-hidden"
        data-user-menu
    >
        <div class="py-1">
            <a
                href="/panel"
                class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors"
            >
                <svg
                    class="w-5 h-5 text-gray-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                    ></path>
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span>Panel principal</span>
            </a>

            <a
                href={`/panel/profile/${user.id}`}
                class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors border-b border-gray-100"
            >
                <svg
                    class="w-5 h-5 text-gray-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5.121 17.804A9 9 0 0112 15a9 9 0 016.879 2.804M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                    ></path>
                </svg>
                <span>Configuración</span>
            </a>

            <button
                type="button"
                class="w-full flex items-center gap-3 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-colors"
                data-signout
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                    ></path>
                </svg>
                <span>Cerrar sesión</span>
            </button>
        </div>
    </div>
</div>

<script>
import { authClient } from "@/auth/auth-client";
import { navigate } from "astro:transitions/client";

    const setupMenu = () => {
        const button = document.querySelector("[data-user-button]");
        const menu = document.querySelector("[data-user-menu]");
        const signoutBtn = document.querySelector("[data-signout]");

        const toggleMenu = (event: Event) => {
            event.stopPropagation();
            menu?.classList.toggle("hidden");
        };

        const closeMenu = (event: Event) => {
            if (
                !button?.contains(event.target as Node) &&
                !menu?.contains(event.target as Node)
            ) {
                menu?.classList.add("hidden");
            }
        };

        button?.addEventListener("click", toggleMenu);
        document.addEventListener("click", closeMenu);

        // Signout Logic
        signoutBtn?.addEventListener("click", async () => {
            console.log("Signing out...");
            await authClient.signOut({
                fetchOptions: { onSuccess: () => navigate("/login") },
            });
            // Add your auth logout logic here
        });
    };

    // Run on first load and after Astro swaps (if using View Transitions)
    setupMenu();
    document.addEventListener("astro:after-swap", setupMenu);
</script>
