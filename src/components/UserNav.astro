---
const { user } = Astro.locals
if (!user) return

const getInitials = (name: string) => {
  if (!name) return '??'
  return name
    .split(' ')
    .map((n) => n[0])
    .join('')
    .toUpperCase()
    .slice(0, 2)
}
---

<div id="user-nav" class="user-nav-container">
  <div class="user-nav-wrapper">
    <button
      id="user-menu-trigger"
      class="user-menu-trigger"
      aria-haspopup="true"
      aria-expanded="false"
    >
      <div class="user-avatar">{getInitials(user.name || '')}</div>

      <div class="user-info-wrapper">
        <div class="user-name">{user.name}</div>
        <div class="user-email">{user.email}</div>
      </div>

      <svg
        class="user-trigger-arrow"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"></path>
      </svg>

      <span class="user-tooltip">{user.name}</span>
    </button>

    <div id="user-dropdown" class="user-dropdown">
      <div class="dropdown-content">
        <a href="/respaldo" class="dropdown-item">
          <svg
            class="dropdown-icon"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path>
          </svg>
          <span>Sis. y respaldo</span>
        </a>

        <a href={`/panel/profile/${user.id}`} class="dropdown-item">
          <svg
            class="dropdown-icon"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span>Configuracion</span>
        </a>

        <button id="signout-btn" class="dropdown-item">
          <svg
            class="dropdown-icon"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
            ></path>
          </svg>
          <span>Cerrar sesión</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .user-nav-container {
    padding: 0;
    flex-shrink: 0;
  }

  .user-nav-wrapper {
    position: relative;
  }

  .user-menu-trigger {
    position: relative;
    width: 100%;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0.55rem;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
    color: var(--color-foreground);
    text-align: left;
  }

  .user-menu-trigger:hover {
    background: var(--color-accent);
    border-color: var(--color-border);
  }

  .user-trigger-arrow {
    width: 1rem;
    height: 1rem;
    color: var(--color-muted-foreground);
    flex-shrink: 0;
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }

  .user-menu-trigger[aria-expanded='true'] .user-trigger-arrow {
    transform: rotate(90deg);
    color: var(--color-foreground);
  }

  .user-avatar {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    background-color: var(--color-primary);
    color: var(--color-primary-foreground);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .user-info-wrapper {
    flex: 1;
    min-width: 0;
    text-align: left;
    transition:
      opacity 0.2s ease,
      width 0.2s ease;
    overflow: hidden;
  }

  .user-name {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--color-foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.15;
  }

  .user-email {
    font-size: 0.73rem;
    color: var(--color-muted-foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.15;
  }

  .user-tooltip {
    position: absolute;
    left: calc(100% + 0.5rem);
    padding: 0.25rem 0.5rem;
    background-color: var(--color-popover);
    color: var(--color-popover-foreground);
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    font-size: 0.75rem;
    white-space: nowrap;
    z-index: 60;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    display: none;
  }

  .user-dropdown {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 0;
    width: 100%;
    min-width: 200px;
    background: var(--color-popover);
    color: var(--color-popover-foreground);
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    box-shadow:
      0 10px 15px -3px rgba(0, 0, 0, 0.12),
      0 4px 6px -2px rgba(0, 0, 0, 0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s ease;
    z-index: 100;
  }

  .user-dropdown.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-content {
    padding: 0.4rem;
  }

  .dropdown-item {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 0.75rem;
    font-size: 0.84rem;
    color: inherit;
    background: transparent;
    border: none;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: background-color 0.2s ease;
    text-decoration: none;
    text-align: left;
  }

  .dropdown-item:hover {
    background: var(--color-accent);
  }

  .dropdown-icon {
    width: 1rem;
    height: 1rem;
    color: var(--color-muted-foreground);
    flex-shrink: 0;
  }

  :global(#app-sidebar[data-collapsed='true']) .user-info-wrapper {
    opacity: 0;
    width: 0;
    overflow: hidden;
    display: none; /* add this */
  }

  :global(#app-sidebar[data-collapsed='true']) .user-menu-trigger {
    justify-content: center;
    align-items: center;
    gap: 0;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    margin: 0 auto;
    display: flex;
  }

  :global(#app-sidebar[data-collapsed='true']) .user-trigger-arrow {
    display: none;
  }

  :global(#app-sidebar[data-collapsed='true']) .user-menu-trigger:hover .user-tooltip {
    opacity: 1;
    display: block;
  }

  :global(#app-sidebar[data-collapsed='false']) .user-tooltip {
    display: none;
  }

  :global(#app-sidebar[data-collapsed='true']) .user-dropdown {
    position: fixed;
    bottom: 0.75rem;
    left: calc(var(--sidebar-collapsed-width) + 0.5rem);
    width: 14rem;
    transform: none;
    z-index: 9999;
    top: auto;
    right: auto;
  }

  @media (max-width: 768px) {
    :global(#app-sidebar[data-collapsed='true']) .user-info-wrapper {
      opacity: 1;
      width: auto;
    }

    :global(#app-sidebar[data-collapsed='true']) .user-menu-trigger {
      justify-content: flex-start;
      width: 100%;
      height: auto;
      margin: 0;
      padding: 0.5rem;
      gap: 0.625rem;
    }

    :global(#app-sidebar[data-collapsed='true']) .user-tooltip {
      display: none !important;
    }

    :global(#app-sidebar[data-collapsed='true']) .user-trigger-arrow {
      display: block;
    }

    :global(#app-sidebar[data-collapsed='true']) .user-dropdown {
      position: absolute;
      bottom: calc(100% + 0.5rem);
      left: 0;
      width: 100%;
      transform: translateY(4px);
    }

    :global(#app-sidebar[data-collapsed='true']) .user-dropdown.show {
      transform: translateY(0);
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client'
  import { authClient } from '@/auth/auth-client'

  function initUserNav() {
    const trigger = document.getElementById('user-menu-trigger')
    const dropdown = document.getElementById('user-dropdown')
    const signoutBtn = document.getElementById('signout-btn')

    if (!trigger || !dropdown || trigger.dataset.initialized === 'true') return
    trigger.dataset.initialized = 'true'

    function handleTriggerClick(e: any) {
      e.stopPropagation()
      const isOpen = !dropdown?.classList.contains('show')
      dropdown?.classList.toggle('show', isOpen)
      trigger?.setAttribute('aria-expanded', String(isOpen))
    }

    function handleGlobalClick(e: any) {
      const target = e.target
      if (!(target instanceof Node)) return

      if (!trigger?.contains(target) && !dropdown?.contains(target)) {
        dropdown?.classList.remove('show')
        trigger?.setAttribute('aria-expanded', 'false')
      }
    }

    async function handleSignOut() {
      await authClient.signOut({
        fetchOptions: { onSuccess: () => navigate('/login') },
      })
    }

    trigger.addEventListener('click', handleTriggerClick)
    document.addEventListener('click', handleGlobalClick)
    signoutBtn?.addEventListener('click', handleSignOut)
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initUserNav)
  } else {
    initUserNav()
  }

  document.addEventListener('astro:after-swap', initUserNav)
</script>
