---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"input"> & {
    class?: string;
    "class:list"?:
        | string
        | Record<string, boolean>
        | Array<string | Record<string, boolean> | null | undefined | false>;
};

const { class: className, "class:list": classList, ...inputProps } =
    Astro.props as Props;
---

<div class="relative">
    <input
        type="date"
        class:list={[
            "w-full p-2 pr-10 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-300 border border-gray-300 dark:border-gray-600 focus:border-blue-500 focus:ring-blue-500 appearance-none date-input-icon",
            className,
            classList,
        ]}
        placeholder="dd/mm/aaaa"
        {...inputProps}
    />
    <div
        class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none"
    >
        <svg
            class="h-5 w-5 text-gray-400 dark:text-gray-500"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path>
        </svg>
    </div>
</div>
