---
// src/pages/finance/ingresos.astro
import { db } from "@/db";
import {
    ArrowDown,
    TrendingUp,
} from "@lucide/astro";
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { cashboxes, transactions, transactionCategories, invoiceRanges } from "@/db/schema";
import { eq, sql, asc, desc, and } from "drizzle-orm";
import { formatter } from "@/utils/timex";
import { formatBOB } from "@/utils/formatters";
import DepositForm from '@/components/svelte/finance/DepositForm.svelte';
import { realTransactionFilter } from "@/services/finances/transaction-patterns";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");

const activeTransactionCategories = await db
    .select({
        id: transactionCategories.id,
        name: transactionCategories.name,
        code: transactionCategories.code,
        type: transactionCategories.type,
        description: transactionCategories.description,
        icon: transactionCategories.icon,
        status: transactionCategories.status,
        requiresAuthorization: transactionCategories.requiresAuthorization,
        invoiceRangeId: transactionCategories.invoiceRangeId,
        invoiceRangeCode: invoiceRanges.code,
        invoiceRangePrefix: invoiceRanges.prefix,
        invoiceRangeCurrent: invoiceRanges.current,
        invoiceRangeEnd: invoiceRanges.rangeEnd,
        invoiceRangeIsActive: invoiceRanges.isActive,
    })
    .from(transactionCategories)
    .leftJoin(invoiceRanges, eq(transactionCategories.invoiceRangeId, invoiceRanges.id))
    .where(and(eq(transactionCategories.status, true), eq(transactionCategories.type, "income")))
    .orderBy(asc(transactionCategories.sortOrder));

const recentDeposits = await db
    .select({
        id: transactions.id,
        concept: transactions.concept,
        amount: transactions.amount,
        reference: transactions.reference,
        createdAt: transactions.createdAt,
        cashboxName: cashboxes.name,
    })
    .from(transactions)
    .innerJoin(cashboxes, eq(transactions.cashboxId, cashboxes.id))
    .where(and(eq(transactions.type, "deposit"), realTransactionFilter))
    .orderBy(desc(transactions.createdAt))
    .limit(10);

const [todaysSummary] = await db
    .select({
        totalDeposits: sql<string>`
        COALESCE(ROUND(SUM(${transactions.amount}), 2)::numeric, 0)::text
      `,
        depositCount: sql<number>`COUNT(*)`,
    })
    .from(transactions)
    .where(
        and(
            eq(transactions.type, "deposit"),
            sql`DATE(${transactions.createdAt}) = CURRENT_DATE`,
            realTransactionFilter,
            // gte(transactions.createdAt, startOfDay),
            // lt(transactions.createdAt, endOfDay),
        ),
    );

const summary = todaysSummary || { totalDeposits: "0.00", depositCount: 0 };
---

<FinanceLayout title="Registro de Ingresos" user={user}>
    <div class="min-h-screen bg-linear-to-br from-slate-50 to-slate-100">
                {/* Main Form Section */}
                <div class="lg:col-span-2 space-y-6">
                    {/* Form Card */}
                    <div
                        class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm"
                    >
                        <!-- <h2
                            class="mb-6 flex items-center gap-2 text-lg font-semibold text-slate-900"
                        >
                            <Plus class="h-5 w-5 text-green-600" />
                            Nuevo Ingreso
                        </h2> -->
                        {/* Header */}
                        <div class="mb-3">
                            <div class="flex items-center gap-3">
                                <div class="rounded-lg bg-green-100 p-3">
                                    <ArrowDown
                                        class="size-4 text-green-600"
                                    />
                                </div>
                                <div>
                                    <h1
                                        class="text-lg font-bold text-slate-900"
                                    >
                                        Ingresos
                                    </h1>
                                    <p class="text-sm text-slate-600">
                                        Registra ingresos
                                    </p>
                                </div>
                            </div>
                        </div>
                        <DepositForm
                          concepts={activeTransactionCategories as any}
                          client:load
                        />
                    </div>

                    {/* Recent Deposits */}
                    <div
                        class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm"
                    >
                        <div class="flex justify-between ">
                            <h3 class="mb-4 text-lg font-semibold text-slate-900">
                            Ingresos Recientes
                        </h3>
                        <span class="text-sm text-slate-500">
                            Mostrando ultimos {recentDeposits.length} ingresos
                        </span>
                        </div>
                        {
                            recentDeposits.length === 0 ? (
                                <p class="text-slate-500 text-center py-8">
                                    No hay ingresos registrados
                                </p>
                            ) : (
                                <div
                                    data-testid="recent-deposits-list"
                                    class="space-y-3"
                                >
                                    {recentDeposits.map((tx) => (
                                    <div class="flex items-center justify-between rounded-lg bg-slate-50 p-3 border border-slate-200 gap-3">

                                      <div class="shrink-0">
                                          <div class="rounded-lg bg-green-100 p-2.5">
                                      <TrendingUp class="w-5 h-5 text-green-600"/>
                                          </div>
                                      </div>
                                      <div class="flex-1 min-w-0">
                                        <div class="flex items-baseline justify-between gap-2 mb-1">
                                          <p data-testid="deposit-concept" class="font-medium text-slate-900 truncate">
                                            {tx.concept}
                                          </p>
                                          <p class="font-semibold text-green-600 shrink-0">
                                            + {formatBOB(tx.amount)}
                                          </p>
                                        </div>

                                        <!-- Row 2: Cashbox, Reference & Date -->
                                        <div class="flex items-center gap-2 text-xs text-slate-600">
                                          <span>{tx.cashboxName}</span>
                                          {tx.reference && (
                                            <>
                                              <span>•</span>
                                              <span class="truncate">{tx.reference}</span>
                                            </>
                                          )}
                                          <span class="ml-auto text-slate-500 shrink-0">
                                            {formatter.format(tx.createdAt)}
                                          </span>
                                        </div>
                                      </div>
                                    </div>
                                    ))}
                                </div>
                            )
                        }
                    </div>
                </div>

                {/* Sidebar */}
                <div class="space-y-6">
                    {/* Today's Summary */}
                    <div
                        class="rounded-lg border border-green-200 bg-linear-to-br from-green-50 to-green-100 p-6 shadow-sm"
                    >
                        <h3 class="font-semibold text-green-900 mb-4">
                            Resumen del Día
                        </h3>
                        <div class="space-y-4">
                            <div>
                                <p class="text-sm text-green-700">
                                    Total Ingresos
                                </p>
                                <p
                                    data-testid="total-deposits"
                                    class="text-3xl font-bold text-green-600"
                                >
                                     {formatBOB(summary.totalDeposits)}

                                </p>
                            </div>
                            <div class="border-t border-green-200 pt-4">
                                <p class="text-sm text-green-700">
                                    Transacciones
                                </p>
                                <p
                                    class="text-2xl font-semibold text-green-900"
                                >
                                    {summary.depositCount}
                                </p>
                            </div>
                        </div>
                    </div>

                    {/* Info Box */}
                    <div
                        class="rounded-lg border border-blue-200 bg-blue-50 p-6"
                    >
                        <h4 class="font-semibold text-blue-900 mb-3">
                            Instrucciones
                        </h4>
                        <ul class="space-y-2 text-sm text-blue-700">
                            <li class="flex gap-2">
                                <span class="font-bold">1.</span>
                                <span>Seleccione la caja correcta</span>
                            </li>
                            <li class="flex gap-2">
                                <span class="font-bold">2.</span>
                                <span>Describa el cuenta del ingreso</span>
                            </li>
                            <li class="flex gap-2">
                                <span class="font-bold">3.</span>
                                <span>Ingrese el monto exacto</span>
                            </li>
                            <li class="flex gap-2">
                                <span class="font-bold">4.</span>
                                <span>Agregue referencia si es necesario</span>
                            </li>
                        </ul>
                    </div>

                    {/* Active Cashboxes */}
                    <!-- <div
                        class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm"
                    >
                        <h4 class="font-semibold text-slate-900 mb-3">
                            Cajas Activas
                        </h4>
                        <div class="space-y-2">
                            {
                                concepts.map((box) => (
                                    <div class="flex items-center justify-between rounded-lg bg-slate-50 p-3">
                                        <div>
                                            <p class="text-sm font-medium text-slate-900">
                                                {box.name}
                                            </p>
                                            <p class="text-xs text-slate-600">
                                                {box.code}
                                            </p>
                                        </div>
                                        <p class="text-sm font-semibold text-slate-900">
                                        {formatBOB(box.balance)}
                                        </p>
                                    </div>
                                ))
                            }
                        </div>
                    </div> -->
                </div>
    </div>
</FinanceLayout>
