---
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { actions, isActionError } from "astro:actions";
import { db } from "@/db";
import { cashboxes, sectors, employees } from "@/db/schema";
import { eq, asc, and, count } from "drizzle-orm";
import { Building2, Wallet, Users, Link } from "@lucide/astro";
import CreateSectorDialog from "@/components/svelte/dialogs/CreateSectorDialog.svelte";
import EditSectorDialog from "@/components/svelte/dialogs/EditSectorDialog.svelte";
import SectorCashboxAssignDialog from "@/components/svelte/rrhh/SectorCashboxAssignDialog.svelte";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");
if (!["ADMIN", "ADMON"].includes(user.role ?? "")) return Astro.redirect("/");

const linkResult = Astro.getActionResult(actions.sector.linkSectorCashbox);
const successMsg = !linkResult?.error && linkResult?.data?.message ? linkResult.data.message : null;
const errorMsg = isActionError(linkResult?.error) ? linkResult.error.message : null;

// All sectors (active + inactive) with their cashbox info
const allSectors = await db
  .select({
    id: sectors.id,
    name: sectors.name,
    description: sectors.description,
    isActive: sectors.isActive,
    cashboxId: sectors.cashboxId,
    cashboxName: cashboxes.name,
    cashboxCode: cashboxes.code,
  })
  .from(sectors)
  .leftJoin(cashboxes, eq(cashboxes.id, sectors.cashboxId))
  .orderBy(asc(sectors.name));

// Employee counts per sector
const empStats = await db
  .select({
    sectorId: employees.sectorId,
    employeeCount: count(employees.id),
  })
  .from(employees)
  .where(eq(employees.status, "activo"))
  .groupBy(employees.sectorId);

const empCountBySector = new Map(empStats.map((e) => [e.sectorId, e.employeeCount]));

// All active cashboxes for the link dialog
const allActiveCashboxes = await db
  .select({
    id: cashboxes.id,
    name: cashboxes.name,
    code: cashboxes.code,
    balance: cashboxes.balance,
    status: cashboxes.status,
  })
  .from(cashboxes)
  .where(eq(cashboxes.status, "activo"))
  .orderBy(asc(cashboxes.name));

const activeSectors = allSectors.filter((s) => s.isActive);
const inactiveSectors = allSectors.filter((s) => !s.isActive);

// Default cashbox (GEN) for "unlinked" fallback
const [defaultCashbox] = await db
  .select({ id: cashboxes.id, name: cashboxes.name })
  .from(cashboxes)
  .where(and(eq(cashboxes.code, "GEN"), eq(cashboxes.status, "activo")))
  .limit(1);
---

<FinanceLayout title="Sectores" user={user}>
  <!-- Header -->
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-xs text-slate-500 mb-1">RRHH</p>
      <div class="flex items-center gap-2">
        <Building2 class="h-5 w-5 text-slate-400" />
        <h1 class="text-xl font-bold text-slate-900">Sectores</h1>
      </div>
      <p class="text-sm text-slate-500 mt-0.5">
        Administre sectores, su personal y la caja a la que están vinculados.
      </p>
    </div>
    <CreateSectorDialog
      triggerLabel="Nuevo sector"
      triggerClass="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-3 py-2 text-xs font-semibold text-white hover:bg-emerald-700 transition-colors shrink-0"
      client:load
    />
  </div>

  <!-- Feedback banners -->
  {successMsg && (
    <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">{successMsg}</div>
  )}
  {errorMsg && (
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">{errorMsg}</div>
  )}

  <!-- Summary strip -->
  <div class="grid grid-cols-3 gap-3">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-500">Sectores activos</p>
      <p class="text-2xl font-bold text-slate-900 mt-0.5">{activeSectors.length}</p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-500">Cajas asignadas</p>
      <p class="text-2xl font-bold text-slate-900 mt-0.5">
        {new Set(activeSectors.map((s) => s.cashboxId)).size}
      </p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-500">Inactivos</p>
      <p class="text-2xl font-bold text-slate-400 mt-0.5">{inactiveSectors.length}</p>
    </div>
  </div>

  <!-- Active sectors table -->
  <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
    <div class="px-5 py-3 border-b border-slate-100 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-slate-800">Sectores activos</h2>
      <span class="text-xs text-slate-400">{activeSectors.length} sectores</span>
    </div>

    {activeSectors.length === 0 ? (
      <div class="p-10 text-center text-slate-400">
        <Building2 class="h-8 w-8 mx-auto mb-2 opacity-30" />
        <p class="text-sm">No hay sectores activos. Crea el primero.</p>
      </div>
    ) : (
      <div class="divide-y divide-slate-100">
        {activeSectors.map((sector) => {
          const empCount = empCountBySector.get(sector.id) ?? 0;
          const sectorAsOption = [{ id: sector.id, name: sector.name }];

          return (
            <div class="flex items-center gap-4 px-5 py-3.5 hover:bg-slate-50/60 transition-colors">
              <!-- Icon + Name -->
              <div class="flex items-center gap-2.5 min-w-0 flex-1">
                <div class="shrink-0 w-7 h-7 rounded-lg bg-slate-100 flex items-center justify-center">
                  <Building2 class="h-3.5 w-3.5 text-slate-500" />
                </div>
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-slate-900 truncate">{sector.name}</p>
                  {sector.description && (
                    <p class="text-xs text-slate-400 truncate">{sector.description}</p>
                  )}
                </div>
              </div>

              <!-- Cashbox badge -->
              <div class="hidden sm:flex items-center gap-1.5 shrink-0">
                <Wallet class="h-3.5 w-3.5 text-slate-400" />
                <span class="text-xs text-slate-600 font-medium">
                  {sector.cashboxName ?? "—"}
                </span>
                {sector.cashboxCode && (
                  <span class="font-mono text-[10px] text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded">
                    {sector.cashboxCode}
                  </span>
                )}
              </div>

              <!-- Staff count -->
              <div class="hidden sm:flex items-center gap-1 shrink-0">
                <Users class="h-3.5 w-3.5 text-slate-400" />
                <span class="text-xs text-slate-600">{empCount}</span>
              </div>

              <!-- Actions -->
              <div class="flex items-center gap-1.5 shrink-0">
                <!-- Vincular/Reasignar caja -->
                <SectorCashboxAssignDialog
                  sectors={sectorAsOption as any}
                  cashboxes={allActiveCashboxes as any}
                  initialSectorId={sector.id}
                  initialCashboxId={sector.cashboxId}
                  lockSector={true}
                  triggerLabel="Vincular caja"
                  triggerClass="inline-flex items-center gap-1 rounded-lg border border-blue-200 bg-blue-50 px-2.5 py-1.5 text-xs font-medium text-blue-700 hover:bg-blue-100 transition-colors"
                  title="Vincular sector a caja"
                  description="Seleccione la caja a la que pertenecerá este sector."
                  client:load
                />

                <!-- Editar / desactivar -->
                <EditSectorDialog
                  sectorId={sector.id}
                  initialName={sector.name}
                  initialDescription={sector.description}
                  triggerLabel="Editar"
                  triggerClass="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-100 transition-colors"
                  client:load
                />
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>

  <!-- Inactive sectors — collapsed -->
  {inactiveSectors.length > 0 && (
    <details class="group rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
      <summary class="flex cursor-pointer items-center justify-between px-5 py-3 select-none hover:bg-slate-50 transition-colors">
        <span class="text-sm font-semibold text-slate-500">
          Sectores inactivos ({inactiveSectors.length})
        </span>
        <svg class="h-4 w-4 text-slate-400 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </summary>

      <div class="divide-y divide-slate-100 border-t border-slate-100">
        {inactiveSectors.map((sector) => {
          const empCount = empCountBySector.get(sector.id) ?? 0;

          return (
            <div class="flex items-center gap-4 px-5 py-3 opacity-60">
              <div class="flex items-center gap-2.5 min-w-0 flex-1">
                <div class="shrink-0 w-7 h-7 rounded-lg bg-slate-100 flex items-center justify-center">
                  <Building2 class="h-3.5 w-3.5 text-slate-400" />
                </div>
                <div class="min-w-0">
                  <p class="text-sm font-medium text-slate-500 truncate">{sector.name}</p>
                  {sector.description && (
                    <p class="text-xs text-slate-400 truncate">{sector.description}</p>
                  )}
                </div>
              </div>
              <span class="hidden sm:block text-xs text-slate-400">{sector.cashboxName ?? "—"}</span>
              <div class="hidden sm:flex items-center gap-1">
                <Users class="h-3.5 w-3.5 text-slate-300" />
                <span class="text-xs text-slate-400">{empCount}</span>
              </div>
              <span class="text-[10px] bg-slate-100 text-slate-400 rounded-full px-2 py-0.5 font-medium">Inactivo</span>
            </div>
          );
        })}
      </div>
    </details>
  )}
</FinanceLayout>