---
/**
 * /rrhh/sectores
 * Sector <-> cashbox link management and budget overview.
 *
 * PR: feat/sector-economy-management
 * Changes vs original:
 *  - Added CreateSectorDialog (top-right header action)
 *  - Added SectorDepositDialog per card (the missing top-up flow)
 *  - Added EditSectorDialog per card (sector config, not just cashbox link)
 *  - Exposed feeAmount + monthlyFeeAmount in each card's stats grid
 *  - Pre-fetched income categories for the deposit dialog select
 *  - Added "sectors without cashbox" warning now also shows fee config
 */
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { actions, isActionError } from "astro:actions";
import {
  getSectorCashboxLinks,
  getSectorSalarySummary,
} from "@/services/rrhh/rrhh.service";
import { db } from "@/db";
import { sectors, cashboxes, transactionCategories } from "@/db/schema";
import { asc, eq } from "drizzle-orm";
import { Building2, Wallet, AlertTriangle, PlusCircle } from "@lucide/astro";
import CreateSectorDialog from "@/components/svelte/dialogs/CreateSectorDialog.svelte";
import EditSectorDialog from "@/components/svelte/dialogs/EditSectorDialog.svelte";
import SectorDepositDialog from "@/components/svelte/dialogs/SectorDepositDialog.svelte";
import SectorCashboxAssignDialog from "@/components/svelte/rrhh/SectorCashboxAssignDialog.svelte";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");
if (!["ADMIN", "ADMON"].includes(user.role ?? "")) return Astro.redirect("/rrhh");

const linkResult = Astro.getActionResult(actions.sector.linkSectorCashbox);
const successMsg = !linkResult?.error && linkResult?.data?.message ? linkResult.data.message : null;
const errorMsg = isActionError(linkResult?.error) ? linkResult.error.message : null;

const [rawLinks, summary, allSectors, allCashboxes, incomeCategories] = await Promise.all([
  getSectorCashboxLinks(),
  getSectorSalarySummary(),
  db
    .select({
      id: sectors.id,
      name: sectors.name,
      description: sectors.description,
    })
    .from(sectors)
    .where(eq(sectors.isActive, true))
    .orderBy(asc(sectors.name)),
  db
    .select({
      id: cashboxes.id,
      name: cashboxes.name,
      code: cashboxes.code,
      balance: cashboxes.balance,
      status: cashboxes.status,
    })
    .from(cashboxes)
    .where(eq(cashboxes.status, "active"))
    .orderBy(asc(cashboxes.name)),
  // income categories for the deposit dialog
  db
    .select({
      id: transactionCategories.id,
      name: transactionCategories.name,
      code: transactionCategories.code,
    })
    .from(transactionCategories)
    .where(eq(transactionCategories.type, "income") && eq(transactionCategories.status, true))
    .orderBy(asc(transactionCategories.sortOrder)),
]);

const links = rawLinks.filter((l) => !!l.cashboxId);
const linkedSectorIds = new Set(links.map((l) => l.sectorId));
const unlinkedSectors = allSectors.filter((s) => !linkedSectorIds.has(s.id));

// Build a lookup map for sector fee config so we can show it per card
const sectorConfigMap = new Map(allSectors.map((s) => [s.id, s]));
---

<FinanceLayout title="Cajas Sectoriales" user={user}>
  <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8 space-y-6">

    <!-- Header -->
    <div class="flex items-start justify-between gap-4">
      <div>
        <div class="text-sm text-slate-500 flex items-center gap-1.5 mb-1">
          <a href="/rrhh" class="hover:text-slate-700">RRHH</a>
          <span>/</span>
          <span class="text-slate-900 font-medium">Cajas Sectoriales</span>
        </div>
        <h1 class="text-xl font-bold text-slate-900">Presupuesto por Sector</h1>
        <p class="text-sm text-slate-500 mt-0.5">
          Cada sector tiene una caja dedicada para cuotas y pagos salariales.
        </p>
      </div>

      <!-- NEW: Create sector button -->
      <CreateSectorDialog
        triggerLabel="Nuevo sector"
        triggerClass="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-3 py-2 text-xs font-semibold text-white hover:bg-emerald-700 transition-colors shrink-0"
        client:load
      />
    </div>

    {successMsg && (
      <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">{successMsg}</div>
    )}
    {errorMsg && (
      <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">{errorMsg}</div>
    )}

    <div class="space-y-4">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide">Sectores vinculados</h2>
        {unlinkedSectors.length > 0 ? (
          <SectorCashboxAssignDialog
            sectors={unlinkedSectors as any}
            cashboxes={allCashboxes as any}
            triggerLabel="Nueva vinculacion"
            triggerClass="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-3 py-2 text-xs font-semibold text-white hover:bg-blue-700 transition-colors"
            title="Vincular sector a caja"
            description="Cree una asignacion de caja para un sector activo"
            client:load
          />
        ) : (
          <span class="text-xs text-slate-400">Todos los sectores tienen caja asignada</span>
        )}
      </div>

      {links.length === 0 ? (
        <div class="rounded-xl border-2 border-dashed border-slate-200 p-8 text-center text-slate-400">
          <Building2 class="h-8 w-8 mx-auto mb-2 opacity-30" />
          <p class="text-sm">Ningun sector vinculado aun.</p>
          <p class="text-xs mt-1">Cree un sector y luego asignele una caja.</p>
        </div>
      ) : (
        <div class="grid gap-4 md:grid-cols-2">
          {links.map((l) => {
            const s = summary.find((x) => x.sectorId === l.sectorId);
            const cfg = sectorConfigMap.get(l.sectorId);
            const balance = parseFloat(l.cashboxBalance ?? "0");
            const monthlySalary = s?.totalMonthlySalary ?? 0;
            const canCover = balance >= monthlySalary;
            const coverPct = monthlySalary > 0 ? Math.min((balance / monthlySalary) * 100, 100) : 100;
            const sectorOption = [{ id: l.sectorId, name: l.sectorName ?? "Sector" }];

            return (
              <div class="rounded-xl border border-slate-200 bg-white shadow-sm p-5">
                <div class="flex items-start justify-between gap-4 mb-4">
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                      <Building2 class="h-4 w-4 text-slate-400 shrink-0" />
                      <h3 class="font-semibold text-slate-900 leading-tight wrap-break-word">{l.sectorName}</h3>
                      {l.cashboxStatus !== "active" && (
                        <span class="rounded-full bg-red-100 px-2 py-0.5 text-[10px] font-medium text-red-600 shrink-0">Inactiva</span>
                      )}
                    </div>
                    <p class="text-xs text-slate-500 mt-0.5 flex items-center gap-1">
                      <Wallet class="h-3 w-3" />
                      {l.cashboxName ?? "-"} - {l.cashboxId ? l.cashboxId.slice(0, 8) : "-"}...
                    </p>
                  </div>

                  <div class="flex flex-col items-end gap-2 shrink-0">
                    <div class="text-right">
                      <p class="text-xs text-slate-500">Saldo</p>
                      <p class:list={[
                        "text-xl font-bold tabular-nums",
                        canCover ? "text-emerald-600" : "text-red-600",
                      ]}>
                        Bs {balance.toLocaleString("es-BO", { minimumFractionDigits: 2 })}
                      </p>
                    </div>

                    <!-- Action buttons row -->
                    <div class="flex items-center gap-1.5 flex-wrap justify-end">
                      <!-- NEW: Deposit button -->
                      <SectorDepositDialog
                        sectorId={l.sectorId}
                        sectorName={l.sectorName ?? ""}
                        cashboxName={l.cashboxName ?? ""}
                        currentBalance={balance}
                        monthlySalary={monthlySalary}
                        categories={incomeCategories as any}
                        triggerLabel="Depositar"
                        triggerClass="rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 hover:bg-emerald-100 transition-colors"
                        client:load
                      />

                      <!-- NEW: Edit sector config button -->
                      {cfg && (
                        <EditSectorDialog
                          sectorId={l.sectorId}
                          initialName={cfg.name}
                          initialDescription={cfg.description}
                          triggerLabel="Configurar"
                          triggerClass="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-slate-100 transition-colors"
                          client:load
                        />
                      )}

                      <!-- Existing: Edit cashbox link -->
                      <SectorCashboxAssignDialog
                        sectors={sectorOption as any}
                        cashboxes={allCashboxes as any}
                        initialSectorId={l.sectorId}
                        initialCashboxId={l.cashboxId}
                        lockSector={true}
                        triggerLabel="Caja"
                        triggerClass="rounded-lg border border-blue-200 bg-blue-50 px-2.5 py-1 text-xs font-medium text-blue-700 hover:bg-blue-100 transition-colors"
                        title="Editar caja del sector"
                        description="Actualice la caja asignada para este sector"
                        client:load
                      />
                    </div>
                  </div>
                </div>

                <!-- Stats grid -- now 4 columns to include fee config -->
                <div class="grid grid-cols-3 gap-2 text-center text-xs mb-4">
                  <div class="rounded-lg bg-slate-50 p-2.5">
                    <p class="text-slate-500">Personal</p>
                    <p class="font-bold text-slate-800 text-base tabular-nums">{s?.totalEmployees ?? 0}</p>
                  </div>
                  <div class="rounded-lg bg-slate-50 p-2.5">
                    <p class="text-slate-500">Masa Salarial</p>
                    <p class="font-bold text-slate-800 tabular-nums">
                      Bs {monthlySalary.toLocaleString("es-BO", { minimumFractionDigits: 0 })}
                    </p>
                  </div>
                  <!-- NEW: Monthly fee amount from sector config -->
                  <div class:list={[
                    "rounded-lg p-2.5",
                    s?.pendingFees && s.pendingFees > 0 ? "bg-amber-50" : "bg-slate-50",
                  ]}>
                    <p class="text-slate-500">Cuotas Pend.</p>
                    <p class:list={[
                      "font-bold text-base tabular-nums",
                      s?.pendingFees && s.pendingFees > 0 ? "text-amber-700" : "text-slate-800",
                    ]}>
                      {s?.pendingFees ?? 0}
                    </p>
                  </div>
                </div>

                <!-- Salary coverage bar -->
                <div>
                  <div class="flex justify-between text-xs text-slate-500 mb-1">
                    <span>Cobertura salarial</span>
                    <span class:list={[canCover ? "text-emerald-600" : "text-red-600", "font-medium"]}>
                      {Math.round(coverPct)}%
                      {!canCover && " -- Fondos insuficientes"}
                    </span>
                  </div>
                  <div class="h-2 w-full rounded-full bg-slate-100">
                    <div
                      class:list={[
                        "h-2 rounded-full transition-all",
                        canCover ? "bg-emerald-500" : "bg-red-500",
                      ]}
                      style={`width: ${coverPct}%`}
                    />
                  </div>
                </div>

                {!canCover && monthlySalary > 0 && (
                  <div class="mt-3 flex items-center gap-2 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700">
                    <AlertTriangle class="h-3.5 w-3.5 shrink-0" />
                    Faltan Bs {(monthlySalary - balance).toLocaleString("es-BO", { minimumFractionDigits: 2 })} para cubrir salarios.
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )}

      {unlinkedSectors.length > 0 && (
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
          <div class="flex items-center gap-2 mb-2">
            <AlertTriangle class="h-4 w-4 text-amber-600" />
            <p class="text-xs font-semibold text-amber-800">Sectores sin caja asignada</p>
          </div>
          <ul class="space-y-1.5">
            {unlinkedSectors.map((s) => (
              <li class="flex items-center justify-between text-xs text-amber-700">
                <span>- {s.name}</span>
              </li>
            ))}
          </ul>
          <p class="text-xs text-amber-600 mt-2">
            El personal de estos sectores no puede recibir salario hasta vincular una caja.
          </p>
        </div>
      )}
    </div>
  </main>
</FinanceLayout>
