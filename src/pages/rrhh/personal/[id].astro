---
/**
 * /rrhh/personal/[id]
 * Employee profile: details, fee history, and granular debt resolution.
 * Linked from auditoria → "Ver salarios" (now points here instead of /rrhh/salarios).
 */
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { actions, isActionError } from "astro:actions";
import {
    getEmployeeById,
    getFeesWithEmployees,
    formatPeriod,
    currentPeriod,
} from "@/services/rrhh/rrhh.service";
import { auditEmployeeFees } from "@/services/audit.service";
import PayFeeDialog from "@/components/svelte/rrhh/PayFeeDialog.svelte";
import {
    ArrowLeft,
    Users,
    Building2,
    Calendar,
    IdCard,
    TriangleAlert,
    PlusCircle,
    ReceiptText,
    Banknote,
} from "@lucide/astro";
import { bob, date } from "@/utils";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");
const ALLOWED = ["ADMIN", "ADMON"] as const;
if (!ALLOWED.includes(user.role as any)) return Astro.redirect("/rrhh");
const canEdit = true; // only ADMIN/ADMON reach this page

const idParam = Astro.params.id ?? "";
const employeeId = Number(idParam);
if (!Number.isInteger(employeeId) || employeeId <= 0) return Astro.redirect("/rrhh/personal");

// Action results
const createFeeResult = Astro.getActionResult(actions.rrhh.createEmployeeFee);
const payFeeResult    = Astro.getActionResult(actions.rrhh.payEmployeeFee);

const successMsg =
    (!createFeeResult?.error && createFeeResult?.data?.message) ||
    (!payFeeResult?.error    && payFeeResult?.data?.message)    ||
    null;
const errorMsg =
    (isActionError(createFeeResult?.error) && createFeeResult.error.message) ||
    (isActionError(payFeeResult?.error)    && payFeeResult.error.message)    ||
    null;

const today = currentPeriod();

const [employee, allGaps, allFees] = await Promise.all([
    getEmployeeById(employeeId),
    auditEmployeeFees(today),
    getFeesWithEmployees({ employeeId, status: "all" }),
]);

if (!employee) return Astro.redirect("/rrhh/personal");

// Gaps for this employee only
const gaps        = allGaps.filter((g) => g.employeeId === employeeId);
const missingGaps = gaps.filter((g) => g.kind === "missing");
const pendingGaps = gaps.filter((g) => g.kind === "pending") as Extract<typeof gaps[number], { kind: "pending" }>[];

// Cashbox for this employee
const defaultCashbox = employee.cashboxId
    ? { id: employee.cashboxId, name: employee.cashboxName, balance: 0 }
    : null;
const defaultCashboxId = defaultCashbox?.id ?? "";

// Fee history stats
const paidFees    = allFees.filter((f) => f.status === "pagado");
const totalPaid   = paidFees.reduce((s, f) => s + Number(f.amount), 0);
const pendingCount = allFees.filter((f) => f.status === "pendiente" || f.status === "parcial").length;
const lastPaidFee = paidFees.sort((a, b) => b.period.localeCompare(a.period))[0] ?? null;

const STATUS_COLORS: Record<string, string> = {
    pendiente: "bg-amber-100 text-amber-700",
    pagado:    "bg-emerald-100 text-emerald-700",
    parcial:   "bg-blue-100 text-blue-700",
    anulado:   "bg-slate-100 text-slate-400",
};
const STATUS_LABELS: Record<string, string> = {
    pendiente: "Pendiente", pagado: "Pagado", parcial: "Parcial", anulado: "Anulado",
};
const EMP_STATUS_COLORS: Record<string, string> = {
    activo:    "bg-emerald-100 text-emerald-700",
    suspendido:"bg-amber-100 text-amber-700",
    baja:      "bg-red-100 text-red-700",
    licencia:  "bg-blue-100 text-blue-700",
};

const fmtPeriod = (p: string) =>
    new Date(Number(p.slice(0,4)), Number(p.slice(5,7)) - 1)
        .toLocaleDateString("es-BO", { month: "long", year: "numeric" });
---

<FinanceLayout title={`Personal — ${employee.fullName}`} user={user}>

    <!-- Flash -->
    {successMsg && (
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">✓ {successMsg}</div>
    )}
    {errorMsg && (
        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">✗ {errorMsg}</div>
    )}

    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <a href="/rrhh/personal" class="inline-flex items-center gap-2 text-xs font-medium text-slate-500 hover:text-slate-700">
                <ArrowLeft class="h-4 w-4" />
                Volver a Personal
            </a>
            <h1 class="text-2xl font-bold text-slate-900 mt-2">{employee.fullName}</h1>
            <div class="flex items-center gap-2 mt-1">
                <span class:list={["rounded-full px-2.5 py-0.5 text-xs font-semibold", EMP_STATUS_COLORS[employee.status] ?? "bg-slate-100 text-slate-500"]}>
                    {employee.status}
                </span>
                <span class="text-xs text-slate-400">{employee.chargeTitle}</span>
                <span class="text-xs text-slate-300">·</span>
                <span class="text-xs text-slate-400">{employee.cashboxName}</span>
            </div>
        </div>
        <div class="text-right">
            <p class="text-xs text-slate-500">Salario base</p>
            <p class="text-xl font-bold text-slate-900 font-mono">{bob(Number(employee.baseSalary))}</p>
        </div>
    </div>

    <!-- KPIs -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs text-slate-500 uppercase tracking-wide mb-2">Total Pagado</p>
            <p class="text-2xl font-bold text-slate-900 tabular-nums">{bob(totalPaid)}</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs text-slate-500 uppercase tracking-wide mb-2">Cuotas Pendientes</p>
            <p class="text-3xl font-bold text-amber-700 tabular-nums">{pendingCount}</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs text-slate-500 uppercase tracking-wide mb-2">Último Pago</p>
            <p class="text-lg font-semibold text-slate-900">
                {lastPaidFee ? formatPeriod(lastPaidFee.period) : "Sin pagos"}
            </p>
        </div>
    </div>

    <!-- Employee details -->
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="font-semibold text-slate-900 mb-4 flex items-center gap-2">
            <Users class="h-4 w-4 text-slate-400" />
            Datos del Empleado
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
            <div class="flex items-start gap-3">
                <IdCard class="h-4 w-4 text-slate-400 mt-0.5" />
                <div>
                    <p class="text-xs text-slate-500">CI</p>
                    <p class="font-medium text-slate-900">{employee.ci ?? "-"}</p>
                </div>
            </div>
            <div class="flex items-start gap-3">
                <Building2 class="h-4 w-4 text-slate-400 mt-0.5" />
                <div>
                    <p class="text-xs text-slate-500">Caja</p>
                    <p class="font-medium text-slate-900">{employee.cashboxName}</p>
                </div>
            </div>
            <div class="flex items-start gap-3">
                <Calendar class="h-4 w-4 text-slate-400 mt-0.5" />
                <div>
                    <p class="text-xs text-slate-500">Fecha de ingreso</p>
                    <p class="font-medium text-slate-900">{date(employee.hireDate)}</p>
                </div>
            </div>
            {employee.terminationDate && (
                <div class="flex items-start gap-3">
                    <Calendar class="h-4 w-4 text-slate-400 mt-0.5" />
                    <div>
                        <p class="text-xs text-slate-500">Baja</p>
                        <p class="font-medium text-slate-900">{date(employee.terminationDate)}</p>
                    </div>
                </div>
            )}
            <div class="flex items-start gap-3">
                <Banknote class="h-4 w-4 text-slate-400 mt-0.5" />
                <div>
                    <p class="text-xs text-slate-500">Tipo</p>
                    <p class="font-medium text-slate-900 capitalize">{employee.employeeType}</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════
         DEBT SECTION — anchor from auditoria
         ══════════════════════════════════════════ -->
    {gaps.length > 0 && (
        <div id="deudas" class="rounded-xl border border-red-200 bg-white shadow-sm overflow-hidden scroll-mt-6">
            <div class="px-5 py-4 border-b border-red-100 flex items-center gap-2 bg-red-50/60">
                <TriangleAlert class="size-4 text-red-500" />
                <h2 class="font-semibold text-red-800 text-sm">
                    Deudas detectadas — {gaps.length} período{gaps.length !== 1 ? "s" : ""} sin resolver
                </h2>
            </div>

            <div class="divide-y divide-slate-100">

                <!-- Missing: create fee as pending -->
                {missingGaps.length > 0 && (
                    <div class="px-5 py-4">
                        <p class="text-xs font-semibold text-red-600 uppercase tracking-wide mb-3 flex items-center gap-1.5">
                            <span class="inline-block size-2 rounded-full bg-red-400"></span>
                            Sin registro — crear cuota como pendiente
                        </p>
                        <div class="flex flex-wrap gap-2">
                            {missingGaps.map((gap) => (
                                <form method="POST" action={actions.rrhh.createEmployeeFee}>
                                    <input type="hidden" name="employeeId" value={gap.employeeId} />
                                    <input type="hidden" name="period"     value={gap.period} />
                                    <input type="hidden" name="amount"     value={gap.expectedAmount} />
                                    <input type="hidden" name="cashboxId"  value={defaultCashboxId} />
                                    <button
                                        type="submit"
                                        onclick={`return confirm('Crear cuota\\n\\n${employee.fullName}\\nPeríodo: ${fmtPeriod(gap.period)}\\nMonto: Bs ${gap.expectedAmount}\\n\\nQuedará como PENDIENTE.')`}
                                        class="inline-flex items-center gap-1.5 rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-medium text-red-700 hover:bg-red-100 transition-colors"
                                    >
                                        <PlusCircle class="size-3 shrink-0" />
                                        {fmtPeriod(gap.period)}
                                        <span class="text-red-400 font-mono">Bs {gap.expectedAmount}</span>
                                    </button>
                                </form>
                            ))}
                        </div>
                    </div>
                )}

                <!-- Pending: pay via PayFeeDialog -->
                {pendingGaps.length > 0 && (
                    <div class="px-5 py-4">
                        <p class="text-xs font-semibold text-amber-600 uppercase tracking-wide mb-3 flex items-center gap-1.5">
                            <span class="inline-block size-2 rounded-full bg-amber-400"></span>
                            Registradas sin pagar — liquidar cuota
                        </p>
                        <div class="flex flex-wrap gap-2">
                            {pendingGaps.map((gap) => {
                                // Find the actual fee row so PayFeeDialog gets feeId
                                const feeRow = allFees.find(
                                    (f) => f.period === gap.period && (f.status === "pendiente" || f.status === "parcial")
                                );
                                if (!feeRow) return null;
                                return (
                                    <PayFeeDialog
                                        client:load
                                        fee={{
                                            id:     feeRow.id,
                                            amount: feeRow.amount,
                                            period: feeRow.period,
                                            status: feeRow.status,
                                            employee: {
                                                fullName:    employee.fullName,
                                                ci:          employee.ci ?? "",
                                                cashboxId:   employee.cashboxId ?? null,
                                                cashboxName: employee.cashboxName,
                                                chargeTitle: employee.chargeTitle,
                                            },
                                        }}
                                        cashbox={defaultCashbox}
                                        currentPeriod={today}
                                        periodLabel={formatPeriod(feeRow.period)}
                                    />
                                );
                            })}
                        </div>
                    </div>
                )}

            </div>
        </div>
    )}

    <!-- Fee history -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
            <div class="flex items-center gap-2">
                <ReceiptText class="h-5 w-5 text-slate-400" />
                <h2 class="font-semibold text-slate-900">Historial de Cuotas</h2>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-xs text-slate-500">{allFees.length} registro(s)</span>
                <a
                    href={`/rrhh/salarios?employeeId=${employeeId}`}
                    class="text-xs text-violet-600 hover:text-violet-800 hover:underline"
                >
                    Ver en Salarios →
                </a>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 text-xs text-slate-500 border-b border-slate-100">
                    <tr>
                        <th class="py-3 px-5 text-left font-medium">Período</th>
                        <th class="py-3 px-4 text-right font-medium">Monto</th>
                        <th class="py-3 px-4 text-center font-medium">Estado</th>
                        {canEdit && <th class="py-3 px-4 text-right font-medium">Acción</th>}
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    {allFees.length === 0 ? (
                        <tr>
                            <td colspan="4" class="py-10 text-center text-slate-400 text-sm">Sin cuotas registradas.</td>
                        </tr>
                    ) : (
                        allFees
                            .sort((a, b) => b.period.localeCompare(a.period))
                            .map((fee) => (
                                <tr class="hover:bg-slate-50/60 transition-colors">
                                    <td class="py-3.5 px-5 font-mono text-slate-700 capitalize">
                                        {formatPeriod(fee.period)}
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-mono font-semibold text-slate-700">
                                        {bob(Number(fee.amount))}
                                    </td>
                                    <td class="py-3.5 px-4 text-center">
                                        <span class:list={["rounded-full px-2.5 py-0.5 text-xs font-semibold", STATUS_COLORS[fee.status] ?? "bg-slate-100 text-slate-500"]}>
                                            {STATUS_LABELS[fee.status] ?? fee.status}
                                        </span>
                                    </td>
                                    {canEdit && (
                                        <td class="py-3.5 px-4 text-right">
                                            {(fee.status === "pendiente" || fee.status === "parcial") ? (
                                                <PayFeeDialog
                                                    client:load
                                                    fee={{
                                                        id:     fee.id,
                                                        amount: fee.amount,
                                                        period: fee.period,
                                                        status: fee.status,
                                                        employee: {
                                                            fullName:    employee.fullName,
                                                            ci:          employee.ci ?? "",
                                                            cashboxId:   employee.cashboxId ?? null,
                                                            cashboxName: employee.cashboxName,
                                                            chargeTitle: employee.chargeTitle,
                                                        },
                                                    }}
                                                    cashbox={defaultCashbox}
                                                    currentPeriod={today}
                                                    periodLabel={formatPeriod(fee.period)}
                                                />
                                            ) : (
                                                <span class="text-xs text-slate-300">—</span>
                                            )}
                                        </td>
                                    )}
                                </tr>
                            ))
                    )}
                </tbody>
            </table>
        </div>
    </div>

</FinanceLayout>
