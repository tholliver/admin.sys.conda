---
/**
 * /rrhh
 * ─────────────────────────────────────────────────────────────
 * RRHH main dashboard: employee headcount, pending salaries,
 * cashbox summaries, and quick-access cards.
 */
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import {
    getEmployeeCountByType,
    currentPeriod,
    formatPeriod,
    MAX_DIRECTORIO,
    MAX_PLANTA,
} from "@/services/rrhh/rrhh.service";
import { getFeeSummaryByPeriod } from "@/services/rrhh/rrhh.service";
import {
    Users,
    UserCheck,
    Wallet,
    AlertCircle,
    TrendingDown,
    ChevronRight,
    CalendarClock,
    BadgeDollarSign,
    ClipboardList,
} from "@lucide/astro";
import CreateEmployeeDialog from "@/components/svelte/rrhh/CreateEmployeeDialog.svelte";
import { db } from "@/db";
import { cashboxes, employees, employeeFees } from "@/db/schema";
import { asc, eq, sql, count } from "drizzle-orm";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");

const ALLOWED = ["ADMIN"] as const;
if (!ALLOWED.includes(user.role)) return Astro.redirect("/panel");

const period = Astro.url.searchParams.get("period") ?? currentPeriod();

const [counts, feeSummary, allCashboxes, cashboxSummary] = await Promise.all([
    getEmployeeCountByType(),
    getFeeSummaryByPeriod(period),
    db
        .select({ id: cashboxes.id, name: cashboxes.name, balance: cashboxes.balance, status: cashboxes.status })
        .from(cashboxes)
        .where(eq(cashboxes.status, "activo"))
        .orderBy(asc(cashboxes.name)),
    db
        .select({
            cashboxId: employees.cashboxId,
            totalEmployees: count(),
            totalMonthlySalary: sql<number>`COALESCE(SUM(${employees.baseSalary}), 0)`,
        })
        .from(employees)
        .where(eq(employees.status, "activo"))
        .groupBy(employees.cashboxId),
]);

// Enrich cashbox summary with pending fees and balance
const pendingFeesByCashbox = await db
    .select({
        cashboxId: employees.cashboxId,
        pendingCount: count(),
    })
    .from(employeeFees)
    .innerJoin(employees, eq(employees.id, employeeFees.employeeId))
    .where(eq(employeeFees.status, "pendiente"))
    .groupBy(employees.cashboxId);

const pendingMap = new Map(pendingFeesByCashbox.map((r) => [r.cashboxId!, Number(r.pendingCount)]));
const summaryMap = new Map(cashboxSummary.map((s) => [s.cashboxId, { employees: Number(s.totalEmployees), salary: Number(s.totalMonthlySalary) }]));

const enrichedCashboxes = allCashboxes.map((cb) => ({
    ...cb,
    balance: Number(cb.balance ?? 0),
    totalEmployees: summaryMap.get(cb.id)?.employees ?? 0,
    totalMonthlySalary: summaryMap.get(cb.id)?.salary ?? 0,
    pendingFees: pendingMap.get(cb.id) ?? 0,
}));

const pendingRow = feeSummary.find((r) => r.status === "pendiente");
const pendingCount = Number(pendingRow?.total ?? 0);
const pendingAmount = Number(pendingRow?.totalAmount ?? 0);

const paidRow = feeSummary.find((r) => r.status === "pagado");
const paidCount = Number(paidRow?.total ?? 0);

const totalFees = feeSummary.reduce((s, r) => s + Number(r.total), 0);
const paidPct = totalFees > 0 ? Math.round((paidCount / totalFees) * 100) : 0;
---

<FinanceLayout title="RRHH — Personal" user={user}>
    <div class="bg-slate-50 min-h-screen space-y-4">
        <!-- ── 1. HEADER ─────────────────────────────────────────────────── -->
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">
                    Recursos Humanos
                </h1>
                <p class="text-sm text-slate-500 mt-0.5">
                    Personal, salarios y cajas
                </p>
            </div>
            <CreateEmployeeDialog
                cashboxes={allCashboxes}
                directorioCount={counts.directorio}
                plantaCount={counts.planta}
                maxDirectorio={MAX_DIRECTORIO}
                maxPlanta={MAX_PLANTA}
                client:load
            />
        </div>

        <!-- ── 2. KPI ROW ──────────────────────────────────────────────────── -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <!-- Directorio -->
            <div class="rounded-xl border-2 border-blue-200 bg-blue-50 p-5">
                <div class="flex items-center justify-between mb-3">
                    <p
                        class="text-xs font-semibold uppercase tracking-wide text-blue-600"
                    >
                        Directorio
                    </p>
                    <div class="rounded-lg bg-blue-100 p-1.5">
                        <UserCheck class="h-4 w-4 text-blue-600" />
                    </div>
                </div>
                <p class="text-3xl font-bold text-blue-900 tabular-nums">
                    {counts.directorio}
                    <span class="text-lg font-normal text-blue-400"
                        >/{MAX_DIRECTORIO}</span
                    >
                </p>
                <div class="mt-2 h-1.5 w-full rounded-full bg-blue-200">
                    <div
                        class="h-1.5 rounded-full bg-blue-500 transition-all"
                        style={`width: ${Math.min((counts.directorio / MAX_DIRECTORIO) * 100, 100)}%`}
                    >
                    </div>
                </div>
            </div>

            <!-- Planta -->
            <div class="rounded-xl border-2 border-violet-200 bg-violet-50 p-5">
                <div class="flex items-center justify-between mb-3">
                    <p
                        class="text-xs font-semibold uppercase tracking-wide text-violet-600"
                    >
                        Planta
                    </p>
                    <div class="rounded-lg bg-violet-100 p-1.5">
                        <Users class="h-4 w-4 text-violet-600" />
                    </div>
                </div>
                <p class="text-3xl font-bold text-violet-900 tabular-nums">
                    {counts.planta}
                    <span class="text-lg font-normal text-violet-400"
                        >/{MAX_PLANTA}</span
                    >
                </p>
                <div class="mt-2 h-1.5 w-full rounded-full bg-violet-200">
                    <div
                        class="h-1.5 rounded-full bg-violet-500 transition-all"
                        style={`width: ${Math.min((counts.planta / MAX_PLANTA) * 100, 100)}%`}
                    >
                    </div>
                </div>
            </div>

            <!-- Pending Salaries -->
            <div class="rounded-xl border-2 border-amber-200 bg-amber-50 p-5">
                <div class="flex items-center justify-between mb-3">
                    <p
                        class="text-xs font-semibold uppercase tracking-wide text-amber-600"
                    >
                        Salarios Pendientes
                    </p>
                    <div class="rounded-lg bg-amber-100 p-1.5">
                        <AlertCircle class="h-4 w-4 text-amber-600" />
                    </div>
                </div>
                <p class="text-3xl font-bold text-amber-900 tabular-nums">
                    {pendingCount}
                </p>
                <p class="text-xs text-amber-600 mt-1 tabular-nums">
                    Bs {
                        pendingAmount.toLocaleString("es-BO", {
                            minimumFractionDigits: 2,
                        })
                    } pendiente
                </p>
            </div>

            <!-- Paid This Period -->
            <div
                class="rounded-xl border-2 border-emerald-200 bg-emerald-50 p-5"
            >
                <div class="flex items-center justify-between mb-3">
                    <p
                        class="text-xs font-semibold uppercase tracking-wide text-emerald-600"
                    >
                        Pagados ({formatPeriod(period)})
                    </p>
                    <div class="rounded-lg bg-emerald-100 p-1.5">
                        <BadgeDollarSign class="h-4 w-4 text-emerald-600" />
                    </div>
                </div>
                <p class="text-3xl font-bold text-emerald-900 tabular-nums">
                    {paidCount}
                </p>
                <div class="mt-2 flex items-center gap-2">
                    <div class="flex-1 h-1.5 rounded-full bg-emerald-200">
                        <div
                            class="h-1.5 rounded-full bg-emerald-500"
                            style={`width: ${paidPct}%`}
                        >
                        </div>
                    </div>
                    <span class="text-xs text-emerald-600">{paidPct}%</span>
                </div>
            </div>
        </div>

        <!-- ── 3. QUICK ACTIONS ────────────────────────────────────────────── -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <a
                href="/rrhh/personal"
                class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:shadow-md hover:border-blue-300 transition-all"
            >
                <div class="flex items-center justify-between mb-3">
                    <div class="rounded-lg bg-blue-100 p-2">
                        <ClipboardList class="h-5 w-5 text-blue-600" />
                    </div>
                    <ChevronRight
                        class="h-4 w-4 text-slate-400 group-hover:text-blue-500 transition-colors"
                    />
                </div>
                <p class="font-semibold text-slate-900">Nómina</p>
                <p class="text-xs text-slate-500 mt-0.5">
                    Ver todo el personal
                </p>
            </a>

            <a
                href="/rrhh/salarios"
                class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:shadow-md hover:border-amber-300 transition-all"
            >
                <div class="flex items-center justify-between mb-3">
                    <div class="rounded-lg bg-amber-100 p-2">
                        <CalendarClock class="h-5 w-5 text-amber-600" />
                    </div>
                    <ChevronRight
                        class="h-4 w-4 text-slate-400 group-hover:text-amber-500 transition-colors"
                    />
                </div>
                <p class="font-semibold text-slate-900">Salarios del Período</p>
                <p class="text-xs text-slate-500 mt-0.5">
                    Gestionar cuotas y pagos
                </p>
            </a>
        </div>

        <!-- ── 4. CASHBOX SUMMARY TABLE ────────────────────────────────────── -->
        <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
            <div
                class="flex items-center justify-between px-6 py-4 border-b border-slate-100"
            >
                <div class="flex items-center gap-2">
                    <Wallet class="h-5 w-5 text-slate-400" />
                    <h2 class="text-base font-semibold text-slate-900">
                        Resumen por Caja
                    </h2>
                </div>
                <a
                    href="/cajas"
                    class="text-xs text-blue-600 hover:underline font-medium"
                >
                    Ver detalle
                </a>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead
                        class="bg-slate-50 text-slate-500 text-xs border-b border-slate-100"
                    >
                        <tr>
                            <th class="py-3 px-5 text-left font-medium"
                                >Caja</th
                            >
                            <th class="py-3 px-4 text-center font-medium"
                                >Personal</th
                            >
                            <th class="py-3 px-4 text-right font-medium"
                                >Masa Salarial/Mes</th
                            >
                            <th class="py-3 px-4 text-right font-medium"
                                >Saldo Caja</th
                            >
                            <th class="py-3 px-4 text-center font-medium"
                                >Cuotas Pendientes</th
                            >
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {
                            enrichedCashboxes.length === 0 ? (
                                <tr>
                                    <td
                                        colspan="5"
                                        class="py-10 text-center text-sm text-slate-400"
                                    >
                                        No hay cajas activas configuradas.
                                    </td>
                                </tr>
                            ) : (
                                enrichedCashboxes.map((cb) => {
                                    const canCover =
                                        cb.balance >= cb.totalMonthlySalary;
                                    return (
                                        <tr class="hover:bg-slate-50/60 transition-colors">
                                            <td class="py-3.5 px-5">
                                                <span class="font-medium text-slate-900">
                                                    {cb.name}
                                                </span>
                                            </td>
                                            <td class="py-3.5 px-4 text-center">
                                                <span class="font-mono text-slate-700">
                                                    {cb.totalEmployees}
                                                </span>
                                            </td>
                                            <td class="py-3.5 px-4 text-right font-mono text-slate-700">
                                                Bs{" "}
                                                {cb.totalMonthlySalary.toLocaleString(
                                                    "es-BO",
                                                    {
                                                        minimumFractionDigits: 2,
                                                    },
                                                )}
                                            </td>
                                            <td class="py-3.5 px-4 text-right">
                                                <span
                                                    class:list={[
                                                        "font-mono font-semibold",
                                                        canCover
                                                            ? "text-emerald-600"
                                                            : "text-red-600",
                                                    ]}
                                                >
                                                    Bs{" "}
                                                    {cb.balance.toLocaleString(
                                                        "es-BO",
                                                        {
                                                            minimumFractionDigits: 2,
                                                        },
                                                    )}
                                                </span>
                                                {!canCover &&
                                                    cb.totalMonthlySalary >
                                                        0 && (
                                                        <div class="flex items-center justify-end gap-1 mt-0.5">
                                                            <TrendingDown class="h-3 w-3 text-red-400" />
                                                            <span class="text-[10px] text-red-400">
                                                                Fondos
                                                                insuficientes
                                                            </span>
                                                        </div>
                                                    )}
                                            </td>
                                            <td class="py-3.5 px-4 text-center">
                                                {cb.pendingFees > 0 ? (
                                                    <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-700">
                                                        {cb.pendingFees}
                                                    </span>
                                                ) : (
                                                    <span class="text-emerald-500 text-xs">
                                                        ✓ Al día
                                                    </span>
                                                )}
                                            </td>
                                        </tr>
                                    );
                                })
                            )
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</FinanceLayout>
