---
import { db } from "@/db";
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { formatter } from "@/utils/timex";
import {
    formatBOB,
    formatTransactionCurrency,
} from "@/services/finances/helpers";
import {
    TrendingUp,
    TrendingDown,
    BanknoteArrowDown,
    BanknoteArrowUp,
    ArrowUpRight,
    ArrowDownLeft,
    FileText,
    Calendar,
    CalendarRange,
    History,
    Vault,
    Activity,
} from "@lucide/astro";
import TxStatusBadge from "@/components/financial/TxStatusBadge.astro";
import {
    getBalanceSummary,
    getDailySummary,
    getMonthlySummary,
} from "@/services/finances/box-queries";
import { LucideExternalLink } from "@lucide/svelte";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");

const FINANCE_ROLES = ["ADMIN", "ADMON", "ACTS", "ACCO"] as const;
if (!FINANCE_ROLES.includes(user.role as any)) return Astro.redirect("/panel");

// Single parallel fetch — no sequential awaits
const [balanceSummary, dailySummary, monthlySummary, recentTransactions] =
    await Promise.all([
        getBalanceSummary(),
        getDailySummary(),
        getMonthlySummary(),
        db.query.transactions.findMany({
            orderBy: (trx, { desc }) => [desc(trx.createdAt)],
            limit: 20,
        }),
    ]);

// Quick actions only for roles that can record transactions
const canRecord = (["ADMON"] as const).includes(user.role as any);

const now = new Date();
const monthFrom = new Date(now.getFullYear(), now.getMonth(), 1)
    .toISOString()
    .split("T")[0];
const monthTo = new Date(now.getFullYear(), now.getMonth() + 1, 0)
    .toISOString()
    .split("T")[0];

const inc = parseFloat(monthlySummary.totalIncome);
const out = parseFloat(monthlySummary.totalOutcome);
const total = inc + out;
const incPct = total > 0 ? Math.round((inc / total) * 100) : 50;
const outPct = 100 - incPct;
---

<FinanceLayout title="Administración" user={user}>
    <div class="bg-slate-50 min-h-screen">
        <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8 space-y-6">
            {
                /* ── 1. BALANCE + TODAY ─────────────────────────────────────────── */
            }
            <div class="flex flex-col sm:flex-row gap-4">
                {
                    /* Balance card — filled with extra stats from the same query */
                }
                <div
                    class="flex-1 rounded-xl border-2 border-blue-200 bg-linear-to-br from-blue-50 to-white p-6 flex flex-col justify-between gap-6"
                >
                    <div>
                        <p
                            class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1"
                        >
                            Saldo Actual
                        </p>
                        <div
                            class="text-4xl font-bold text-slate-900 tabular-nums"
                        >
                            <a
                                href="/reportes"
                                class="group inline-flex items-center gap-3 transition-colors duration-200 hover:text-blue-600"
                            >
                                {formatBOB(String(balanceSummary.totalBalance))}
                                <LucideExternalLink
                                    size={18}
                                    class="text-blue-400 opacity-0 transition-all duration-200 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0"
                                />
                            </a>
                        </div>
                    </div>

                    {
                        /* Bottom stat row — uses data already fetched by getBalanceSummary */
                    }
                    <div
                        class="flex items-center gap-6 pt-4 border-t border-blue-100"
                    >
                        <div class="flex items-center gap-2">
                            <div class="rounded-lg bg-blue-100 p-2">
                                <Vault class="h-4 w-4 text-blue-600" />
                            </div>
                            <div>
                                <p class="text-xs text-slate-500">
                                    Caja Principal
                                </p>
                                <p class="text-sm font-semibold text-slate-800">
                                    {balanceSummary.activeBoxes} activa{
                                        balanceSummary.activeBoxes !== 1
                                            ? "s"
                                            : ""
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="rounded-lg bg-emerald-100 p-2">
                                <Activity class="h-4 w-4 text-emerald-600" />
                            </div>
                            <div>
                                <p class="text-xs text-slate-500">
                                    Operaciones Hoy
                                </p>
                                <p class="text-sm font-semibold text-slate-800">
                                    {dailySummary.totalTransactions} transacción{
                                        dailySummary.totalTransactions !== 1
                                            ? "es"
                                            : ""
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                {/* Today ops */}
                <div class="flex gap-4 sm:flex-col sm:w-52">
                    <div
                        class="flex-1 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-4"
                    >
                        <section class="flex items-center justify-between">
                            <p class="text-xs font-medium text-emerald-600">
                                Ingresos Hoy
                            </p>
                            <p class="text-xs text-emerald-600 opacity-70">
                                {dailySummary.incomeCount} op{
                                    dailySummary.incomeCount !== 1 ? "s" : ""
                                }
                            </p>
                        </section>
                        <p
                            class="text-xl font-bold text-emerald-700 tabular-nums mt-1"
                        >
                            {formatBOB(String(dailySummary.totalIncome))}
                        </p>
                    </div>
                    <div
                        class="flex-1 rounded-xl border border-red-200 bg-red-50 px-4 py-4"
                    >
                        <section class="flex items-center justify-between">
                            <p class="text-xs font-medium text-red-600">
                                Egresos Hoy
                            </p>
                            <p class="text-xs text-red-600 opacity-70">
                                {dailySummary.outcomeCount} op{
                                    dailySummary.outcomeCount !== 1 ? "s" : ""
                                }
                            </p>
                        </section>
                        <p
                            class="text-xl font-bold text-red-700 tabular-nums mt-1"
                        >
                            {formatBOB(String(dailySummary.totalOutcome))}
                        </p>
                    </div>
                </div>
            </div>

            {
                /* ── 2. QUICK ACTIONS — only for roles that record transactions ── */
            }
            {
                canRecord && (
                    <div class="grid gap-4 sm:grid-cols-2">
                        <a href="/ingresos">
                            <button class="h-28 w-full flex flex-col items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl transition-colors shadow-sm">
                                <BanknoteArrowDown class="h-7 w-7" />
                                <div class="text-center leading-tight">
                                    <p class="font-semibold">
                                        Registrar Ingreso
                                    </p>
                                    <p class="text-xs opacity-80">
                                        Pasajes, servicios, etc.
                                    </p>
                                </div>
                            </button>
                        </a>
                        <a href="/egresos">
                            <button class="h-28 w-full flex flex-col items-center justify-center gap-2 bg-red-600 hover:bg-red-700 text-white rounded-xl transition-colors shadow-sm">
                                <BanknoteArrowUp class="h-7 w-7" />
                                <div class="text-center leading-tight">
                                    <p class="font-semibold">
                                        Registrar Egreso
                                    </p>
                                    <p class="text-xs opacity-80">
                                        Gastos, pagos, etc.
                                    </p>
                                </div>
                            </button>
                        </a>
                    </div>
                )
            }

            {
                /* ── 3. MONTHLY REPORT ───────────────────────────────────────────── */
            }
            <div
                class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"
            >
                {/* Header row */}
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-2">
                        <CalendarRange class="h-4 w-4 text-slate-400" />
                        <p
                            class="text-xs font-semibold text-slate-500 uppercase tracking-wide"
                        >
                            Reporte Mensual
                        </p>
                        <span class="text-xs text-slate-400">·</span>
                        <p class="text-xs text-slate-500 capitalize">
                            {monthlySummary.monthLabel}
                        </p>
                    </div>
                    <a
                        href={`/finanzas/ingresos?from=${monthFrom}&to=${monthTo}`}
                        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50 transition-colors"
                    >
                        Ver análisis
                        <ArrowUpRight class="h-3 w-3" />
                    </a>
                </div>

                {/* Single compact row: net balance + income + outcome */}
                <div
                    class="grid grid-cols-3 gap-4 mb-5 pb-5 border-b border-slate-100"
                >
                    <div>
                        <p class="text-xs font-medium text-slate-500 mb-1">
                            Balance Neto
                        </p>
                        <p
                            class:list={[
                                "text-2xl font-bold tabular-nums",
                                parseFloat(monthlySummary.netChange) >= 0
                                    ? "text-emerald-600"
                                    : "text-red-600",
                            ]}
                        >
                            {
                                parseFloat(monthlySummary.netChange) >= 0
                                    ? "+"
                                    : ""
                            }{formatBOB(monthlySummary.netChange)}
                        </p>
                    </div>
                    <div>
                        <section class="flex items-center justify-between">
                            <p class="text-xs font-medium text-emerald-600">
                                Ingresos del Mes
                            </p>
                            <p class="text-xs text-emerald-600 opacity-70">
                                {monthlySummary.incomeCount} ops
                            </p>
                        </section>
                        <p
                            class="text-xl font-bold text-emerald-600 tabular-nums mt-1"
                        >
                            {formatBOB(monthlySummary.totalIncome)}
                        </p>
                    </div>
                    <div>
                        <section class="flex items-center justify-between">
                            <p class="text-xs font-medium text-red-600">
                                Egresos del Mes
                            </p>
                            <p class="text-xs text-red-600 opacity-70">
                                {monthlySummary.outcomeCount} ops
                            </p>
                        </section>
                        <p
                            class="text-xl font-bold text-red-600 tabular-nums mt-1"
                        >
                            {formatBOB(monthlySummary.totalOutcome)}
                        </p>
                    </div>
                </div>

                <div class="mb-6">
                    <div
                        class="flex h-2.5 w-full overflow-hidden rounded-full bg-slate-100"
                    >
                        <div
                            class="bg-emerald-500 transition-all duration-500"
                            style={`width: ${incPct}%`}
                        >
                        </div>
                        <div
                            class="bg-red-400 transition-all duration-500"
                            style={`width: ${outPct}%`}
                        >
                        </div>
                    </div>
                    <div
                        class="mt-2 flex justify-between text-xs text-slate-500"
                    >
                        <span class="flex items-center gap-1">
                            <span
                                class="inline-block h-2 w-2 rounded-full bg-emerald-500"
                            ></span>
                            Ingresos {incPct}%
                        </span>
                        <span class="flex items-center gap-1">
                            Egresos {outPct}%
                            <span
                                class="inline-block h-2 w-2 rounded-full bg-red-400"
                            ></span>
                        </span>
                    </div>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                    <a
                        href="/finanzas/ingresos"
                        class="rounded-lg border border-emerald-200 bg-emerald-50 p-4 transition-all hover:shadow-md hover:border-emerald-300"
                    >
                        <TrendingUp class="h-5 w-5 text-emerald-600 mb-2" />
                        <p class="text-sm font-semibold text-slate-900">
                            Análisis de Ingresos
                        </p>
                        <p class="text-xs text-slate-500 mt-0.5">
                            Tendencias y categorías
                        </p>
                    </a>
                    <a
                        href="/finanzas/gastos"
                        class="rounded-lg border border-red-200 bg-red-50 p-4 transition-all hover:shadow-md hover:border-red-300"
                    >
                        <TrendingDown class="h-5 w-5 text-red-600 mb-2" />
                        <p class="text-sm font-semibold text-slate-900">
                            Análisis de Gastos
                        </p>
                        <p class="text-xs text-slate-500 mt-0.5">
                            Desglose por categoría
                        </p>
                    </a>
                    <a
                        href="/finanzas/diario"
                        class="rounded-lg border border-blue-200 bg-blue-50 p-4 transition-all hover:shadow-md hover:border-blue-300"
                    >
                        <Calendar class="h-5 w-5 text-blue-600 mb-2" />
                        <p class="text-sm font-semibold text-slate-900">
                            Reporte Diario
                        </p>
                        <p class="text-xs text-slate-500 mt-0.5">
                            Resumen de hoy
                        </p>
                    </a>
                    <a
                        href="/finanzas/semanal"
                        class="rounded-lg border border-amber-200 bg-amber-50 p-4 transition-all hover:shadow-md hover:border-amber-300"
                    >
                        <FileText class="h-5 w-5 text-amber-600 mb-2" />
                        <p class="text-sm font-semibold text-slate-900">
                            Reporte Semanal
                        </p>
                        <p class="text-xs text-slate-500 mt-0.5">
                            Vista de la semana
                        </p>
                    </a>
                </div>
            </div>

            {
                /* ── 4. RECENT TRANSACTIONS ─────────────────────────────────────── */
            }
            <div
                class="rounded-xl border border-slate-200 bg-white shadow-sm p-6"
            >
                <div class="flex items-center justify-between mb-5">
                    <div>
                        <h2 class="text-lg font-bold text-slate-900">
                            Transacciones Recientes
                        </h2>
                        <p class="text-sm text-slate-500">
                            Últimas {recentTransactions.length} operaciones
                        </p>
                    </div>
                    <a
                        href="/historial"
                        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors"
                    >
                        <History class="h-4 w-4" />
                        Ver Todo
                    </a>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left">
                        <thead
                            class="bg-slate-50 text-slate-500 border-b border-slate-200"
                        >
                            <tr>
                                <th class="py-3 px-4 font-medium">Cuenta</th>
                                <th
                                    class="py-3 px-4 font-medium hidden md:table-cell"
                                    >Descripción</th
                                >
                                <th class="py-3 px-4 font-medium">Estado</th>
                                <th
                                    class="py-3 px-4 font-medium hidden sm:table-cell"
                                    >Fecha</th
                                >
                                <th class="py-3 px-4 font-medium text-right"
                                    >Monto</th
                                >
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            {
                                recentTransactions.map((tx) => (
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="py-3 px-4">
                                            <div class="flex items-center gap-3">
                                                <div
                                                    class:list={[
                                                        "p-1.5 rounded-full shrink-0",
                                                        tx.type === "deposit"
                                                            ? "bg-green-100 text-green-600"
                                                            : "bg-red-100 text-red-600",
                                                    ]}
                                                >
                                                    {tx.type === "deposit" ? (
                                                        <ArrowUpRight class="h-3.5 w-3.5" />
                                                    ) : (
                                                        <ArrowDownLeft class="h-3.5 w-3.5" />
                                                    )}
                                                </div>
                                                <span class="font-medium text-slate-900 truncate max-w-40">
                                                    {tx.concept}
                                                </span>
                                            </div>
                                        </td>
                                        <td
                                            class="py-3 px-4 text-slate-500 max-w-32 truncate hidden md:table-cell"
                                            title={tx.description || ""}
                                        >
                                            {tx.description || "—"}
                                        </td>
                                        <td class="py-3 px-4">
                                            <TxStatusBadge status={tx.status} />
                                        </td>
                                        <td class="py-3 px-4 text-slate-500 whitespace-nowrap hidden sm:table-cell">
                                            {formatter.format(tx.createdAt)}
                                        </td>
                                        <td
                                            class:list={[
                                                "py-3 px-4 text-right font-semibold whitespace-nowrap",
                                                tx.type === "deposit"
                                                    ? "text-green-600"
                                                    : "text-red-600",
                                            ]}
                                        >
                                            {formatTransactionCurrency(
                                                tx.amount,
                                                tx.type,
                                            )}
                                        </td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</FinanceLayout>
