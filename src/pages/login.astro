---
import Layout from "@/layouts/Layout.astro";
import { Check } from "@lucide/astro";

const passwordChanged = Astro.url.searchParams.get("changed");
const sessionsRevoked = Astro.url.searchParams.get("revoked");

const user = Astro.locals.user;
if (user) return Astro.redirect("/");
---

<Layout title="Iniciar Sesión" class="bg-slate-900">
    <div
        class="min-h-screen flex items-center justify-center py-8"
    >
        <div
            class="w-full max-w-md rounded-xl border border-border bg-card text-card-foreground shadow-2xl overflow-hidden"
        >
            <!-- Header -->
            <div
                class="space-y-2 text-center bg-primary text-primary-foreground py-8"
            >
                <h1 class="text-2xl font-bold">Bienvenido ADMIN</h1>
                <p class="text-sm opacity-90">
                    Sindicato de Transportes Carrasco Tropical
                </p>
            </div>

            <div class="px-8 py-6">
                <form id="loginForm" method="post" class="space-y-6">
                    <!-- Success Alert -->
                    {
                        passwordChanged && (
                            <div class="flex items-start gap-3 rounded-lg border border-green-500/30 bg-green-500/10 p-4 text-green-700 dark:text-green-400">
                                <Check class="size-5 mt-0.5 shrink-0" />
                                <div class="flex flex-col gap-1">
                                    <p class="text-sm font-medium">
                                        Contraseña actualizada correctamente.
                                    </p>
                                    {sessionsRevoked && (
                                        <span class="text-xs text-muted-foreground">
                                            Has sido desconectado de todos los
                                            dispositivos por seguridad.
                                        </span>
                                    )}
                                </div>
                            </div>
                        )
                    }

                    <!-- Email -->
                    <div class="space-y-2">
                        <label for="email" class="block text-sm font-medium"
                            >Correo electrónico</label
                        >
                        <div class="relative">
                            <svg
                                class="absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-muted-foreground"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                                ></path>
                            </svg>
                            <input
                                id="email"
                                name="email"
                                type="email"
                                autocomplete="email"
                                placeholder="correo@ejemplo.com"
                                class="flex h-10 w-full rounded-md border border-border bg-background px-3 pl-10 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 ring-offset-background transition"
                            />
                        </div>
                    </div>

                    <!-- Contraseña -->
                    <div class="space-y-2">
                        <label for="password" class="block text-sm font-medium"
                            >Contraseña</label
                        >
                        <div class="relative">
                            <svg
                                class="absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-muted-foreground"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                                ></path>
                            </svg>
                            <input
                                id="password"
                                name="password"
                                type="password"
                                autocomplete="current-password"
                                placeholder="Ingrese su contraseña"
                                class="flex h-10 w-full rounded-md border border-border bg-background px-3 pl-10 pr-10 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 ring-offset-background transition"
                            />
                            <button
                                type="button"
                                id="togglePassword"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-[#0047FF] p-1 rounded-full transition-colors"
                            >
                                <svg
                                    id="eyeIcon"
                                    class="h-5 w-5"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                                    ></path>
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                                    ></path>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- Remember / Recover -->
                    <div class="flex items-center justify-between text-sm">
                        <label
                            class="flex items-center gap-2 text-muted-foreground"
                        >
                            <input
                                type="checkbox"
                                name="rememberMe"
                                class="h-4 w-4 rounded border-border text-primary focus:ring-ring focus:ring-offset-background"
                            />
                            Recordarme
                        </label>
                        <a
                            href="/admin/forgot-password"
                            class="font-medium text-primary hover:underline"
                        >
                            Olvidé mi contraseña
                        </a>
                    </div>

                    <!-- Submit -->
                    <button
                        id="submitBtn"
                        type="submit"
                        class="inline-flex h-12 w-full items-center justify-center rounded-md bg-destructive text-destructive-foreground font-semibold text-lg shadow hover:bg-destructive/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 ring-offset-background transition"
                    >
                        Iniciar Sesión
                    </button>
                </form>
            </div>
        </div>
    </div>
</Layout>

<script>
    import { signIn } from "@/auth/auth-client";
    import { toast } from "@/lib/toast";

    const ERROR_MESSAGES: Record<string, string> = {
        INVALID_EMAIL_OR_PASSWORD: "Correo o contraseña incorrectos",
        USER_NOT_FOUND: "No existe una cuenta con este correo",
        EMAIL_NOT_VERIFIED: "Debes verificar tu correo antes de continuar",
        SESSION_EXPIRED: "Tu sesión ha expirado. Inicia sesión nuevamente.",
        TOO_MANY_REQUESTS: "Demasiadas solicitudes. Inténtalo más tarde.",
    };

    document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById(
            "loginForm",
        ) as HTMLFormElement | null;
        const submitBtn = document.getElementById(
            "submitBtn",
        ) as HTMLButtonElement | null;
        const passwordInput = document.getElementById(
            "password",
        ) as HTMLInputElement | null;
        const togglePasswordBtn = document.getElementById(
            "togglePassword",
        ) as HTMLButtonElement | null;
        const eyeIcon = document.getElementById(
            "eyeIcon",
        ) as HTMLElement | null;

        if (!form || !submitBtn) return;

        // --- Password toggle ---
        let showPassword = false;
        togglePasswordBtn?.addEventListener("click", () => {
            showPassword = !showPassword;
            if (passwordInput)
                passwordInput.type = showPassword ? "text" : "password";
            if (eyeIcon) {
                eyeIcon.innerHTML = showPassword
                    ? `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>`
                    : `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>`;
            }
        });

        // --- Loading state ---
        const setLoading = (loading: boolean, text = "Iniciando...") => {
            submitBtn!.disabled = loading;
            submitBtn!.textContent = loading ? text : "Iniciar Sesión";
        };

        // --- Banned UI ---
        const setBlocked = (message: string) => {
            form.style.display = "none";
            const blocked = document.createElement("div");
            blocked.className =
                "flex flex-col items-center gap-4 py-6 text-center";
            blocked.innerHTML = `
                <div class="flex items-center justify-center w-14 h-14 rounded-full bg-destructive/10">
                    <svg class="w-7 h-7 text-destructive" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                    </svg>
                </div>
                <div class="space-y-1">
                    <p class="font-semibold text-destructive text-base">Cuenta suspendida</p>
                    <p class="text-sm text-muted-foreground max-w-xs">${message}</p>
                </div>
                <a href="mailto:soporte@example.com"
                    class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:underline mt-1">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    Contactar soporte
                </a>
            `;
            form.parentElement!.appendChild(blocked);
        };

        // --- Submit ---
        form.addEventListener("submit", async (e: SubmitEvent) => {
            e.preventDefault();

            const formData = new FormData(form);
            const email = formData.get("email")?.toString().trim();
            const password = formData.get("password")?.toString().trim();
            const rememberMe = formData.get("rememberMe") === "on";

            if (!email || !password) {
                toast.error("Por favor completa todos los campos");
                return;
            }

            setLoading(true);
            let hasError = false;

            try {
                await signIn.email({
                    email,
                    password,
                    rememberMe,
                    callbackURL: "/",
                    fetchOptions: {
                        onError: (ctx) => {
                            hasError = true;
                            const err = ctx.error;

                            if (err.code === "BANNED_USER") {
                                setBlocked(
                                    "Tu cuenta ha sido suspendida. Si crees que es un error, contacta al soporte.",
                                );
                                return;
                            }

                            const message =
                                ERROR_MESSAGES[err.code ?? ""] ??
                                (err.status === 429
                                    ? ERROR_MESSAGES.TOO_MANY_REQUESTS
                                    : "Verifica tus credenciales");

                            toast.error("Error de autenticación", {
                                description: message,
                            });
                        },
                        onSuccess: () => {
                            submitBtn!.textContent = "Redirigiendo...";
                            // window.location.href = redirectTo;
                        },
                    },
                });
            } catch (error) {
                hasError = true;
                console.error(error);
                toast.error("Error inesperado", {
                    description: "Error al conectar. Intente nuevamente.",
                });
            } finally {
                if (hasError) setLoading(false);
            }
        });
    });
</script>
