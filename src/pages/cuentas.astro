---
import { db } from "@/db";
import { actions, isActionError } from "astro:actions";
import { transactionCategories, invoiceRanges } from "@/db/schema";
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { eq, asc, and, desc } from "drizzle-orm";
import {
  CircleDollarSign, HandCoins, Receipt, Wallet, Banknote, PiggyBank,
  CreditCard, BadgeDollarSign, ShoppingBag, Wrench, Bus, CarFront, Route,
  Map, Landmark, Ticket, Users, IdCard, Fuel, Shield, BadgeCheck, FileText,
  ClipboardList, CalendarCheck, Hammer, TriangleAlert, Building2, Handshake,
  Zap, Trash2, Search,
} from "@lucide/astro";
import CreateCategoryDialog from "@/components/categories/CreateCategoryDialog.svelte";
import EditCategoryDialog   from "@/components/categories/EditCategoryDialog.svelte";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");

const disableResult  = Astro.getActionResult(actions.finance.disableTransactionCategory);
const activateResult = Astro.getActionResult(actions.finance.activateTransactionCategory);
const sortResult     = Astro.getActionResult(actions.finance.setCategorySortOrder);
const deleteResult   = Astro.getActionResult(actions.finance.deleteTransactionCategory);

const statusError =
  isActionError(disableResult?.error)  ? disableResult.error.message :
  isActionError(activateResult?.error) ? activateResult.error.message :
  isActionError(deleteResult?.error)   ? deleteResult.error.message   : null;

const statusSuccess =
  !disableResult?.error  && disableResult?.data?.message  ? disableResult.data.message  :
  !activateResult?.error && activateResult?.data?.message ? activateResult.data.message :
  !deleteResult?.error   && deleteResult?.data?.message   ? deleteResult.data.message   : null;

const sortSuccess = !sortResult?.error && sortResult?.data?.message ? sortResult.data.message : null;
const sortError   = isActionError(sortResult?.error) ? sortResult.error.message : null;

const categories = await db
  .select()
  .from(transactionCategories)
  .orderBy(
    desc(transactionCategories.status),
    asc(transactionCategories.type),
    asc(transactionCategories.sortOrder),
    asc(transactionCategories.name),
  );

const activeParents     = categories.filter((c) => c.status);
const quickIncomeCount  = categories.filter(c => c.type === "income"  && c.status && c.sortOrder <= 6).length;
const quickOutcomeCount = categories.filter(c => c.type === "outcome" && c.status && c.sortOrder <= 6).length;

const availableRanges = await db
  .select({ id: invoiceRanges.id, category: invoiceRanges.category, prefix: invoiceRanges.prefix, current: invoiceRanges.current, rangeEnd: invoiceRanges.rangeEnd })
  .from(invoiceRanges)
  .where(and(eq(invoiceRanges.isSystem, false), eq(invoiceRanges.isActive, true)))
  .orderBy(asc(invoiceRanges.category));

const ICON_COMPONENTS = {
  "circle-dollar-sign": CircleDollarSign, "hand-coins": HandCoins,
  wallet: Wallet, banknote: Banknote, "credit-card": CreditCard,
  receipt: Receipt, "piggy-bank": PiggyBank, "badge-dollar-sign": BadgeDollarSign,
  "shopping-bag": ShoppingBag, wrench: Wrench, bus: Bus, "car-front": CarFront,
  route: Route, map: Map, landmark: Landmark, ticket: Ticket, users: Users,
  "id-card": IdCard, fuel: Fuel, shield: Shield, "badge-check": BadgeCheck,
  "file-text": FileText, "clipboard-list": ClipboardList,
  "calendar-check": CalendarCheck, hammer: Hammer,
  "alert-triangle": TriangleAlert, "building-2": Building2, handshake: Handshake,
} as const;

const DEFAULT_ICON = { income: CircleDollarSign, outcome: HandCoins } as const;
const resolveIcon  = (icon: string | null, type: "income" | "outcome") =>
  ICON_COMPONENTS[icon as keyof typeof ICON_COMPONENTS] ?? DEFAULT_ICON[type];
---

<FinanceLayout title="Cuentas de transacciones" user={user}>

  <div class="space-y-4">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-xl font-bold text-slate-900">Cuentas de transacciones</h1>
        <p class="text-sm text-slate-500 mt-0.5">Define las cuentas que clasifican ingresos y egresos.</p>
      </div>
      <CreateCategoryDialog activeParents={activeParents as any} availableRanges={availableRanges as any} client:load />
    </div>

    {statusSuccess && <p class="rounded-md border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-700">{statusSuccess}</p>}
    {statusError   && <p class="rounded-md border border-red-200   bg-red-50   px-3 py-2 text-sm text-red-700">{statusError}</p>}
    {sortSuccess   && <p class="rounded-md border border-blue-200  bg-blue-50  px-3 py-2 text-sm text-blue-700">{sortSuccess}</p>}
    {sortError     && <p class="rounded-md border border-red-200   bg-red-50   px-3 py-2 text-sm text-red-700">{sortError}</p>}

    <section class="rounded-lg border border-slate-200 bg-white shadow-sm">
      <div class="flex flex-wrap items-center gap-2 px-5 py-3 border-b border-slate-100 bg-slate-50/50">
        <div class="flex items-center gap-2 text-xs text-slate-500 shrink-0">
          <div class="flex items-center gap-1">
            <Zap class="h-3 w-3 text-amber-500" />
            <span class="hidden xl:inline">Acceso rapido</span>
          </div>
          <span class="text-sm text-slate-400 shrink-0 hidden md:inline">{categories.length} total</span>
        </div>

        <div class="flex items-center gap-2 flex-1 min-w-[200px]">
          <div class="relative flex-1 max-w-sm md:max-w-none">
            <Search class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" />
            <input
              id="category-search"
              type="text"
              autocomplete="off"
              placeholder="Buscar..."
              class="w-full rounded-md border border-input bg-background pl-9 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
            />
          </div>

          <div class="flex gap-1 rounded-lg border border-slate-200 bg-slate-50 p-1 shrink-0">
            <button type="button" id="tab-income" data-tab="income"
              class="tab-btn flex items-center justify-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium transition-all bg-white text-emerald-700 shadow-sm border border-emerald-200">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              Ingresos
              <span class="ml-0.5 rounded-full bg-emerald-100 px-1.5 py-0.5 text-[10px] font-semibold text-emerald-600">
                {categories.filter(c => c.type === "income").length}
              </span>
            </button>
            <button type="button" id="tab-outcome" data-tab="outcome"
              class="tab-btn flex items-center justify-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium transition-all text-slate-500 hover:text-slate-700">
              <span class="h-1.5 w-1.5 rounded-full bg-red-400"></span>
              Egresos
              <span class="ml-0.5 rounded-full bg-red-100 px-1.5 py-0.5 text-[10px] font-semibold text-red-600">
                {categories.filter(c => c.type === "outcome").length}
              </span>
            </button>
          </div>
        </div>
      </div>

      <div class="max-h-[70vh] overflow-auto">
        <table class="w-full text-left">
          <thead class="sticky top-0 border-b border-slate-200 bg-white text-slate-500 text-xs">
            <tr>
              <th class="px-2 py-2.5 font-medium w-9 text-center"><Zap class="h-3 w-3 text-amber-400 mx-auto" /></th>
              <th class="px-3 py-2.5 font-medium">Tipo</th>
              <th class="px-3 py-2.5 font-medium">Nombre</th>
              <th class="px-3 py-2.5 font-medium text-right">
                <span class="flex items-center justify-end gap-2">
                  Acciones
                  <span class="flex items-center gap-1 text-[10px] font-normal text-slate-400">
                    <span class="inline-flex items-center gap-0.5 text-emerald-600">
                      <span class="h-1 w-1 rounded-full bg-emerald-400"></span>
                      Ing. {quickIncomeCount}/6
                    </span>
                    <span class="inline-flex items-center gap-0.5 text-red-600">
                      <span class="h-1 w-1 rounded-full bg-red-400"></span>
                      Egr. {quickOutcomeCount}/6
                    </span>
                  </span>
                </span>
              </th>
            </tr>
          </thead>
          <tbody id="categories-tbody" class="divide-y divide-slate-100">
            {categories.map((cat) => {
              const Icon       = resolveIcon(cat.icon, cat.type as "income" | "outcome");
              const isIncome   = cat.type === "income";
              const isQuick    = cat.sortOrder <= 6;
              const quickCount = isIncome ? quickIncomeCount : quickOutcomeCount;
              const canPromote = !isQuick && cat.status && quickCount < 6;
              const canDemote  = isQuick  && cat.status;
              const badgeClass = isIncome
                ? "bg-emerald-50 text-emerald-600"
                : "bg-red-50 text-red-600";
              const dotClass = isIncome ? "bg-emerald-400" : "bg-red-400";
              const badgeNum = isIncome ? "bg-emerald-100 text-emerald-700" : "bg-red-100 text-red-700";
              const zapColor = isIncome ? "text-emerald-400" : "text-red-400";
              return (
                <tr class={`category-row ${cat.status ? '' : 'opacity-40'} hover:bg-slate-50/60 transition-colors`} data-type={cat.type} data-name={cat.name.toLowerCase()}>
                  <td class="px-2 py-2.5 text-center">
                    {isQuick && cat.status ? (
                      <div class="flex flex-col items-center gap-0.5">
                        <span class={`inline-flex h-5 w-5 items-center justify-center rounded text-[10px] font-bold ${badgeNum}`}>{cat.sortOrder}</span>
                        <Zap class={`h-2.5 w-2.5 ${zapColor}`} />
                      </div>
                    ) : (
                      <span class="text-[10px] font-mono text-slate-300">{cat.sortOrder === 999 ? '—' : cat.sortOrder}</span>
                    )}
                  </td>
                  <td class="px-3 py-2.5">
                    <span class={`inline-flex items-center gap-1 text-[10px] font-medium rounded-full px-2 py-0.5 ${isIncome ? 'bg-emerald-50 text-emerald-700' : 'bg-red-50 text-red-700'}`}>
                      <span class={`h-1.5 w-1.5 rounded-full ${dotClass}`}></span>
                      {isIncome ? 'Ingreso' : 'Egreso'}
                    </span>
                  </td>
                  <td class="px-3 py-2.5">
                    <div class="flex items-center gap-2">
                      <span class={`shrink-0 flex h-6 w-6 items-center justify-center rounded ${badgeClass}`}>
                        <Icon class="h-3.5 w-3.5" />
                      </span>
                      <span class="text-slate-900 text-xs font-medium leading-tight">{cat.name}</span>
                    </div>
                  </td>
                  <td class="px-3 py-2.5">
                    <div class="flex items-center justify-end gap-1 flex-wrap">
                      {canPromote && (
                        <form method="POST" action={actions.finance.setCategorySortOrder} class="inline">
                          <input type="hidden" name="categoryId" value={cat.id} />
                          <input type="hidden" name="sortOrder"  value="1" />
                          <button type="submit" class="flex items-center gap-0.5 rounded border border-amber-200 bg-amber-50 px-1.5 py-1 text-[10px] font-medium text-amber-700 hover:bg-amber-100 transition-colors">
                            <Zap class="h-2.5 w-2.5" /> Fijar
                          </button>
                        </form>
                      )}
                      {canDemote && (
                        <form method="POST" action={actions.finance.setCategorySortOrder} class="inline">
                          <input type="hidden" name="categoryId" value={cat.id} />
                          <input type="hidden" name="sortOrder"  value="999" />
                          <button type="submit" class="flex items-center gap-0.5 rounded border border-slate-200 bg-white px-1.5 py-1 text-[10px] font-medium text-slate-500 hover:bg-slate-100 transition-colors">
                            <Zap class="h-2.5 w-2.5" /> Quitar
                          </button>
                        </form>
                      )}
                      <EditCategoryDialog category={cat as any} activeParents={activeParents as any} availableRanges={availableRanges as any} client:load />
                      <form method="POST" action={cat.status ? actions.finance.disableTransactionCategory : actions.finance.activateTransactionCategory} class="inline">
                        <input type="hidden" name="categoryId" value={cat.id} />
                        <button type="submit" disabled={cat.status && cat.isSystem}
                          onclick={cat.status ? "return confirm('¿Desactivar esta cuenta?');" : "return confirm('¿Activar esta cuenta?');"}
                          class:list={["rounded px-2 py-1 text-[10px] font-medium text-white disabled:cursor-not-allowed disabled:bg-slate-300 transition-colors", cat.status ? "bg-slate-500 hover:bg-slate-600" : "bg-emerald-600 hover:bg-emerald-700"]}>
                          {cat.status ? "Desactivar" : "Activar"}
                        </button>
                      </form>
                      {!cat.isSystem && (
                        <form method="POST" action={actions.finance.deleteTransactionCategory} class="inline">
                          <input type="hidden" name="categoryId" value={cat.id} />
                          <button type="submit"
                            onclick={`return confirm('¿Eliminar permanentemente "${cat.name}"?\\nEsta acción no se puede deshacer.');`}
                            class="rounded border border-red-200 bg-red-50 p-1 text-red-600 hover:bg-red-100 transition-colors"
                            title="Eliminar permanentemente">
                            <Trash2 class="h-3 w-3" />
                          </button>
                        </form>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <div id="no-results" class="hidden py-12 text-center text-sm text-slate-400">
          <Search class="h-8 w-8 mx-auto mb-2 opacity-40" />
          <p>No se encontraron cuentas</p>
        </div>
      </div>
    </section>
  </div>

</FinanceLayout>

<script>
  let activeTab = 'income';

  function applyFilters() {
    const query = (document.getElementById('category-search') as HTMLInputElement | null)?.value?.toLowerCase().trim() ?? '';
    const rows = document.querySelectorAll<HTMLTableRowElement>('#categories-tbody .category-row');
    let visibleCount = 0;
    rows.forEach(row => {
      const name = row.dataset.name ?? '';
      const type = row.dataset.type ?? '';
      const show = query ? name.includes(query) : type === activeTab;
      row.classList.toggle('hidden', !show);
      if (show) visibleCount++;
    });
    const noResults = document.getElementById('no-results');
    if (noResults) noResults.classList.toggle('hidden', visibleCount > 0);
  }

  document.getElementById('category-search')?.addEventListener('input', applyFilters);

  document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach(btn => {
    btn.addEventListener('click', () => {
      activeTab = btn.dataset.tab!;
      (['income', 'outcome'] as const).forEach(t => {
        const b = document.getElementById(`tab-${t}`);
        if (!b) return;
        const active = t === activeTab;
        b.className = [
          'tab-btn flex-1 sm:flex-initial flex items-center justify-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium transition-all',
          active
            ? t === 'income'
              ? 'bg-white text-emerald-700 shadow-sm border border-emerald-200'
              : 'bg-white text-red-700 shadow-sm border border-red-200'
            : 'text-slate-500 hover:text-slate-700',
        ].join(' ');
      });
      applyFilters();
    });
  });
</script>
