---
// src/pages/transferencias.astro
import { db } from "@/db";
import { ArrowLeftRight, TrendingUp, TrendingDown, Info } from "@lucide/astro";
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { cashboxes, transactions } from "@/db/schema";
import { eq, desc, and, sql, or } from "drizzle-orm";
import { formatter } from "@/utils/timex";
import TransferForm from "@/components/svelte/finance/TransferForm.svelte";
import { formatBOB } from "@/utils/formatters";
import { CASHBOX_STATUS } from "@/db/finance.types";
import { internalTransferLegFilter } from "@/services/finances/transaction-patterns";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");

const activeCashboxes = await db
    .select({
        id: cashboxes.id,
        name: cashboxes.name,
        code: cashboxes.code,
        balance: cashboxes.balance,
    })
    .from(cashboxes)
    .where(eq(cashboxes.status, CASHBOX_STATUS.ACTIVE));

const recentTransfers = await db
    .select({
        id: transactions.id,
        concept: transactions.concept,
        amount: transactions.amount,
        createdAt: transactions.createdAt,
        cashboxName: cashboxes.name,
    })
    .from(transactions)
    .innerJoin(cashboxes, eq(transactions.cashboxId, cashboxes.id))
    .where(
        and(
            eq(transactions.type, "withdraw"),
            internalTransferLegFilter,
        ),
    )
    .orderBy(desc(transactions.createdAt))
    .limit(15);

const [todaysSummary] = await db
    .select({
        totalTransferred: sql<string>`
            COALESCE(ROUND(SUM(${transactions.amount}), 2)::numeric, 0)::text
        `,
        transferCount: sql<number>`COUNT(*)`,
    })
    .from(transactions)
    .where(
        and(
            eq(transactions.type, "withdraw"),
            internalTransferLegFilter,
            sql`DATE(${transactions.createdAt}) = CURRENT_DATE`,
        ),
    );

const summary = todaysSummary || { totalTransferred: "0.00", transferCount: 0 };
---

<FinanceLayout title="Transferencias entre Cajas" user={user}>
    <div class="min-h-screen bg-linear-to-br from-slate-50 to-slate-100">
        <div class="grid gap-8 lg:grid-cols-3">
            {/* Form Column */}
            <div class="lg:col-span-2 space-y-6">
                <div
                    class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm"
                >
                    <div class="mb-6 flex items-center gap-3">
                        <div
                            class="flex h-10 w-10 items-center justify-center rounded-lg bg-violet-100"
                        >
                            <ArrowLeftRight class="h-5 w-5 text-violet-600" />
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-slate-900">
                                Nueva Transferencia
                            </h2>
                            <p class="text-sm text-slate-500">
                                Mueve fondos entre cajas de forma atómica y
                                auditada
                            </p>
                        </div>
                    </div>
                    <TransferForm
                        cashboxes={activeCashboxes as any}
                        client:load
                    />
                </div>

                {/* Recent Transfers */}
                <div
                    class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm"
                >
                    <div class="flex justify-between mb-4">
                        <h3 class="text-lg font-semibold text-slate-900">
                            Transferencias Recientes
                        </h3>
                        <span class="text-sm text-slate-500">
                            Últimas {recentTransfers.length}
                        </span>
                    </div>
                    {
                        recentTransfers.length === 0 ? (
                            <p class="text-slate-500 text-center py-8">
                                No hay transferencias registradas
                            </p>
                        ) : (
                            <div class="space-y-3">
                                {recentTransfers.map((tx) => (
                                    <div class="flex items-center gap-3 rounded-lg bg-slate-50 p-4 border border-slate-200 hover:border-slate-300 transition">
                                        <div class="shrink-0">
                                            <div class="rounded-lg bg-violet-100 p-2.5">
                                                <ArrowLeftRight class="h-5 w-5 text-violet-600" />
                                            </div>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-baseline justify-between gap-2 mb-1">
                                                <p class="font-medium text-slate-900 truncate">
                                                    {tx.concept}
                                                </p>
                                                <p class="font-semibold text-violet-600 shrink-0">
                                                    {formatBOB(tx.amount)}
                                                </p>
                                            </div>
                                            <div class="flex items-center gap-2 text-xs text-slate-500">
                                                <span>{tx.cashboxName}</span>
                                                <span>•</span>
                                                <span class="ml-auto shrink-0">
                                                    {formatter.format(
                                                        tx.createdAt,
                                                    )}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        )
                    }
                </div>
            </div>

            {/* Sidebar */}
            <div class="space-y-6">
                {/* Today's Summary */}
                <div
                    class="rounded-lg border border-violet-200 bg-linear-to-br from-violet-50 to-violet-100 p-6 shadow-sm"
                >
                    <h3 class="font-semibold text-violet-900 mb-4">
                        Resumen del Día
                    </h3>
                    <div class="space-y-4">
                        <div>
                            <p class="text-sm text-violet-700">
                                Total Transferido
                            </p>
                            <p class="text-3xl font-bold text-violet-600">
                                {formatBOB(summary.totalTransferred)}
                            </p>
                        </div>
                        <div class="border-t border-violet-200 pt-4">
                            <p class="text-sm text-violet-700">Operaciones</p>
                            <p class="text-2xl font-semibold text-violet-900">
                                {summary.transferCount}
                            </p>
                        </div>
                    </div>
                </div>

                {/* Info */}
                <div class="rounded-lg border border-blue-200 bg-blue-50 p-6">
                    <div class="flex gap-2 mb-3">
                        <Info class="h-5 w-5 text-blue-600 shrink-0" />
                        <h4 class="font-semibold text-blue-900">
                            ¿Cómo funciona?
                        </h4>
                    </div>
                    <ul class="space-y-2 text-sm text-blue-700">
                        <li>• Se debita de la caja origen en un solo paso</li>
                        <li>• Se acredita a la caja destino simultáneamente</li>
                        <li>• Ambos movimientos quedan en el historial</li>
                        <li>• No hay riesgo de saldo inconsistente</li>
                    </ul>
                </div>

                {/* Cashbox Balances */}
                <div
                    class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm"
                >
                    <h4 class="font-semibold text-slate-900 mb-3">
                        Saldos Actuales
                    </h4>
                    <div class="space-y-3">
                        {
                            activeCashboxes.map((box) => {
                                const balance = parseFloat(
                                    box.balance?.toString() ?? "0",
                                );
                                const isCritical = balance < 100;
                                return (
                                    <div
                                        class={`rounded-lg p-3 ${isCritical ? "bg-red-50 border border-red-200" : "bg-slate-50 border border-slate-200"}`}
                                    >
                                        <div class="flex items-center justify-between">
                                            <div>
                                                <p class="text-sm font-medium text-slate-900">
                                                    {box.name}
                                                </p>
                                                <p class="text-xs text-slate-500">
                                                    {box.code}
                                                </p>
                                            </div>
                                            <p
                                                class={`text-sm font-semibold ${isCritical ? "text-red-600" : "text-green-600"}`}
                                            >
                                                {formatBOB(balance)}
                                            </p>
                                        </div>
                                    </div>
                                );
                            })
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</FinanceLayout>
