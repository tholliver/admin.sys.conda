---
// src/pages/transferencias.astro
import { db } from "@/db";
import { ArrowLeftRight, Info, ArrowRight, Wallet } from "@lucide/astro";
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { cashboxes, transactions } from "@/db/schema";
import { eq, and, sql } from "drizzle-orm";
import { formatter } from "@/utils/timex";
import TransferForm from "@/components/svelte/finance/TransferForm.svelte";
import { CASHBOX_STATUS, GEN_CASHBOX_CODE } from "@/db/finance.types";
import { internalTransferLegFilter } from "@/services/finances/transaction-patterns";
import {
  getGenAdvanceSummary,
  getTotalNetAdvanceFromGen,
  getAllInterCashboxTransfers,
} from "@/services/finances/cashbox-transfers.service";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");

const fromParam = Astro.url.searchParams.get("from") ?? "";
const toParam   = Astro.url.searchParams.get("to")   ?? "";

// advanceSummary
const [activeCashboxes, totalAdvance, recentTransfers] = await Promise.all([
  db
    .select({ id: cashboxes.id, name: cashboxes.name, code: cashboxes.code, balance: cashboxes.balance })
    .from(cashboxes)
    .where(eq(cashboxes.status, CASHBOX_STATUS.ACTIVE)),
  // getGenAdvanceSummary(),
  getTotalNetAdvanceFromGen(),
  getAllInterCashboxTransfers({ from: fromParam || undefined, to: toParam || undefined, limit: 25 }),
]);

const [todaysSummary] = await db
  .select({
    totalTransferred: sql<string>`COALESCE(ROUND(SUM(${transactions.amount}), 2)::numeric, 0)::text`,
    transferCount:    sql<number>`COUNT(*)`,
  })
  .from(transactions)
  .where(
    and(
      eq(transactions.type, "withdraw"),
      internalTransferLegFilter,
      sql`DATE(${transactions.createdAt} AT TIME ZONE 'America/La_Paz') = CURRENT_DATE`,
    ),
  );

const summary = todaysSummary ?? { totalTransferred: "0.00", transferCount: 0 };
const bsFormat = (n: string | number) =>
  "Bs " + Number(n).toLocaleString("es-BO", { minimumFractionDigits: 2 });
---

<FinanceLayout title="Transferencias entre Cajas" user={user}>
  <div class="space-y-6">

    <div class="flex items-center justify-between gap-4">
      <div>
        <h1 class="text-xl font-bold text-slate-900">Transferencias</h1>
        <p class="text-sm text-slate-500 mt-0.5">Movimientos entre cajas — todo queda registrado</p>
      </div>
      <a
        href="/cajas/reporte-avances"
        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 transition-colors"
      >
        Reporte avances GEN
        <ArrowRight class="h-3.5 w-3.5" />
      </a>
    </div>

    <!-- {advanceSummary.length > 0 && (
      <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
        <div class="flex items-center justify-between gap-3 mb-3">
          <div class="flex items-center gap-2">
            <Wallet class="h-4 w-4 text-amber-600" />
            <p class="text-sm font-semibold text-amber-900">Avances netos activos desde GEN</p>
          </div>
          <span class="text-sm font-bold text-amber-700 tabular-nums">{bsFormat(totalAdvance)}</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2">
          {advanceSummary.map((row) => (
            <a href={`/cajas/reporte-avances?cashboxId=${row.cashboxId}`}
               class="rounded-lg bg-white border border-amber-200 px-3 py-2 hover:border-amber-400 transition-colors">
              <p class="text-xs font-semibold text-slate-700 truncate">{row.cashboxName}</p>
              <p class="text-[10px] font-mono text-slate-400">{row.cashboxCode}</p>
              <p class="text-sm font-bold text-amber-700 mt-0.5 tabular-nums">{bsFormat(row.netAdvance)}</p>
              <p class="text-[10px] text-slate-400">{row.transferCount} mov.</p>
            </a>
          ))}
        </div>
      </div>
    )} -->

    <div class="grid gap-6 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-5">

        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="mb-5 flex items-center gap-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-violet-100">
              <ArrowLeftRight class="h-4 w-4 text-violet-600" />
            </div>
            <div>
              <h2 class="text-base font-semibold text-slate-900">Nueva Transferencia</h2>
              <p class="text-xs text-slate-500">Mueve fondos entre cajas de forma atómica</p>
            </div>
          </div>
          <TransferForm cashboxes={activeCashboxes as any} client:load />
        </div>

        <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
          <div class="flex items-center justify-between px-5 py-3.5 border-b border-slate-100">
            <h3 class="text-sm font-semibold text-slate-900">Historial</h3>
            <form method="GET" class="flex items-center gap-2">
              <input type="date" name="from" value={fromParam}
                class="rounded border border-slate-200 text-xs px-2 py-1 text-slate-700 focus:outline-none focus:ring-1 focus:ring-violet-300" />
              <span class="text-xs text-slate-400">—</span>
              <input type="date" name="to" value={toParam}
                class="rounded border border-slate-200 text-xs px-2 py-1 text-slate-700 focus:outline-none focus:ring-1 focus:ring-violet-300" />
              <button type="submit" class="rounded bg-slate-100 text-xs px-2 py-1 text-slate-600 hover:bg-slate-200 transition-colors">
                Filtrar
              </button>
              {(fromParam || toParam) && (
                <a href="/transferencias" class="text-xs text-slate-400 hover:text-slate-600">✕</a>
              )}
            </form>
          </div>

          {recentTransfers.length === 0 ? (
            <div class="py-12 text-center text-slate-400 text-sm">No hay transferencias en este rango.</div>
          ) : (
            <table class="w-full text-sm">
              <thead class="bg-slate-50 border-b border-slate-100">
                <tr>
                  <th class="py-2.5 px-5 text-left text-xs font-medium text-slate-500">Concepto</th>
                  <th class="py-2.5 px-4 text-left text-xs font-medium text-slate-500">Origen → Destino</th>
                  <th class="py-2.5 px-4 text-right text-xs font-medium text-slate-500">Monto</th>
                  <th class="py-2.5 px-4 text-right text-xs font-medium text-slate-500">Fecha</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50">
                {recentTransfers.map((tx) => {
                  const fromGen = tx.fromCashboxCode === GEN_CASHBOX_CODE;
                  const toGen   = tx.toCashboxCode   === GEN_CASHBOX_CODE;
                  return (
                    <tr class="hover:bg-slate-50/70 transition-colors">
                      <td class="py-3 px-5">
                        <p class="font-medium text-slate-800 text-xs truncate max-w-44">{tx.concept}</p>
                        {tx.notes && <p class="text-[11px] text-slate-400 truncate">{tx.notes}</p>}
                      </td>
                      <td class="py-3 px-4">
                        <div class="flex items-center gap-1 text-[10px]">
                          <span class:list={["font-mono rounded px-1.5 py-0.5 font-bold",
                            fromGen ? "bg-amber-100 text-amber-700" : "bg-slate-100 text-slate-600"
                          ]}>{tx.fromCashboxCode}</span>
                          <ArrowRight class="h-2.5 w-2.5 text-slate-300 shrink-0" />
                          <span class:list={["font-mono rounded px-1.5 py-0.5 font-bold",
                            toGen ? "bg-amber-100 text-amber-700" : "bg-slate-100 text-slate-600"
                          ]}>{tx.toCashboxCode}</span>
                        </div>
                      </td>
                      <td class="py-3 px-4 text-right">
                        <span class="font-bold text-violet-700 tabular-nums text-xs">{bsFormat(tx.amount)}</span>
                      </td>
                      <td class="py-3 px-4 text-right text-[11px] text-slate-400 whitespace-nowrap">
                        {formatter.format(tx.createdAt)}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          )}
        </div>
      </div>

      <div class="space-y-4">
        <div class="rounded-xl border border-violet-200 bg-violet-50 p-5">
          <p class="text-xs font-semibold text-violet-600 uppercase tracking-wide mb-2">Hoy</p>
          <p class="text-2xl font-bold text-violet-700 tabular-nums">{bsFormat(summary.totalTransferred)}</p>
          <p class="text-xs text-violet-500 mt-0.5">{summary.transferCount} transferencia{summary.transferCount !== 1 ? "s" : ""}</p>
        </div>

        <div class="rounded-xl border border-blue-100 bg-blue-50 p-4">
          <div class="flex gap-2 mb-2">
            <Info class="h-4 w-4 text-blue-500 shrink-0 mt-0.5" />
            <p class="text-xs font-semibold text-blue-800">Sobre los avances</p>
          </div>
          <p class="text-xs text-blue-700 leading-relaxed">
            Las transferencias desde GEN hacia otras cajas son avances internos —
            no dinero que sale de la empresa. El panel superior muestra el neto
            acumulado que cada caja tiene "prestado" de GEN.
          </p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-3">Saldos actuales</p>
          <div class="space-y-1.5">
            {activeCashboxes
              .sort((a, b) => (a.code === GEN_CASHBOX_CODE ? -1 : b.code === GEN_CASHBOX_CODE ? 1 : 0))
              .map((box) => {
                const isGen = box.code === GEN_CASHBOX_CODE;
                const balance = parseFloat(box.balance?.toString() ?? "0");
                return (
                  <div class:list={[
                    "flex items-center justify-between rounded-lg px-3 py-2",
                    isGen ? "bg-amber-50 border border-amber-200" : "bg-slate-50 border border-slate-100"
                  ]}>
                    <div>
                      <p class:list={["text-xs font-semibold leading-tight", isGen ? "text-amber-800" : "text-slate-700"]}>{box.name}</p>
                      <p class="text-[10px] font-mono text-slate-400">{box.code}</p>
                    </div>
                    <p class:list={["text-xs font-bold tabular-nums", isGen ? "text-amber-700" : balance < 0 ? "text-red-600" : "text-slate-700"]}>
                      {bsFormat(balance)}
                    </p>
                  </div>
                );
              })}
          </div>
        </div>
      </div>
    </div>
  </div>
</FinanceLayout>
