---
// src/pages/reportes/gastos.astro
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { getDetailedExpenseReport } from "@/services/finances/report-queries";
import { getPercentage } from "@/services/finances/finance-ui-helpers";
import { DollarSign, TrendingDown, ChartPie, FileText } from "@lucide/astro";
import { formatBOB } from "@/utils/formatters";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login");

// Default to current month
const now = new Date();
const startDate = new Date(now.getFullYear(), now.getMonth(), 1);
const endDate = new Date(now.getFullYear(), now.getMonth() + 1, 0, 23, 59, 59);

const expenseReport = await getDetailedExpenseReport(startDate, endDate);
---

<FinanceLayout title="Gastos Detallados" user={user}>
    <div class="px-4 py-2 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-8 flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold text-slate-900">
                    Gastos Detallados
                </h1>
                <p class="mt-2 text-slate-600">
                    Análisis completo de egresos - {
                        now.toLocaleDateString("es-BO", {
                            month: "long",
                            year: "numeric",
                        })
                    }
                </p>
            </div>
            <button
                onclick="window.print()"
                class="rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700"
            >
                Exportar
            </button>
        </div>

        <!-- Summary Cards -->
        <div class="mb-8 grid gap-4 sm:grid-cols-3">
            <div class="rounded-lg border border-red-200 bg-red-50 p-6">
                <div class="flex items-center justify-between mb-2">
                    <p class="text-sm font-medium text-red-700">
                        Total Gastado
                    </p>
                    <DollarSign class="h-5 w-5 text-red-600" />
                </div>
                <p class="text-3xl font-bold text-red-900">
                    {formatBOB(expenseReport.totalExpenses)}
                </p>
            </div>

            <div class="rounded-lg border border-slate-200 bg-white p-6">
                <div class="flex items-center justify-between mb-2">
                    <p class="text-sm font-medium text-slate-600">
                        Transacciones
                    </p>
                    <FileText class="h-5 w-5 text-slate-400" />
                </div>
                <p class="text-3xl font-bold text-slate-900">
                    {expenseReport.expenseCount}
                </p>
            </div>

            <div class="rounded-lg border border-slate-200 bg-white p-6">
                <div class="flex items-center justify-between mb-2">
                    <p class="text-sm font-medium text-slate-600">Promedio</p>
                    <TrendingDown class="h-5 w-5 text-slate-400" />
                </div>
                <p class="text-3xl font-bold text-slate-900">
                    {formatBOB(expenseReport.avgExpenseAmount)}
                </p>
            </div>
        </div>

        <div class="mb-8 grid gap-6 lg:grid-cols-2">
            <!-- Category Breakdown -->
            <div class="rounded-lg border border-slate-200 bg-white p-6">
                <div class="flex items-center gap-2 mb-6">
                    <ChartPie class="h-5 w-5 text-red-600" />
                    <h2 class="text-lg font-semibold text-slate-900">
                        Por Categoría
                    </h2>
                </div>

                <div class="space-y-4">
                    {
                        expenseReport.categoryBreakdown.map((cat) => (
                            <div>
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex-1">
                                        <p class="text-sm font-medium text-slate-900">
                                            {cat.categoryName}
                                        </p>
                                        <p class="text-xs text-slate-500">
                                            {cat.transactionCount} gastos ·
                                            Promedio {formatBOB(cat.avgAmount)}
                                        </p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm font-bold text-red-600">
                                            {formatBOB(cat.totalAmount)}
                                        </p>
                                        <p class="text-xs text-slate-500">
                                            {cat.percentage.toFixed(1)}%
                                        </p>
                                    </div>
                                </div>
                                <div class="bg-slate-100 rounded-full h-2">
                                    <div
                                        class="bg-red-500 h-2 rounded-full transition-all"
                                        style={`width: ${cat.percentage}%`}
                                    />
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>

            <!-- Top Expenses -->
            <div class="rounded-lg border border-slate-200 bg-white p-6">
                <h2 class="mb-6 text-lg font-semibold text-slate-900">
                    Mayores Gastos
                </h2>

                <div class="space-y-3">
                    {
                        expenseReport.topExpenses
                            .slice(0, 10)
                            .map((expense, index) => (
                                <div class="flex items-start gap-3 rounded-lg border border-slate-100 p-3">
                                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-red-100 text-xs font-bold text-red-600">
                                        {index + 1}
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-medium text-slate-900">
                                            {expense.concept}
                                        </p>
                                        <p class="text-xs text-slate-500">
                                            {expense.categoryName}
                                        </p>
                                        {(expense.invoiceNumber || expense.externalReference) && (
                                            <span class="text-xs text-slate-400">
                                                Ref: {expense.invoiceNumber ? `#${expense.invoiceNumber}` : expense.externalReference}
                                            </span>
                                        )}
                                    </div>
                                    <div class="shrink-0 text-right text-sm font-bold text-red-600">
                                        {formatBOB(expense.amount)}
                                    </div>
                                </div>
                            ))
                    }
            </div>
        </div>
    </div>
</FinanceLayout>
