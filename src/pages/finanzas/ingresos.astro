---
// src/pages/reportes/ingresos.astro
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { formatBOB } from "@/utils/formatters";
import { getIncomeAnalysisReport } from "@/services/finances/report-queries";
import { TrendingUp, DollarSign, Clock, ChartColumn } from "@lucide/astro";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login");

const now = new Date();
const startDate = new Date(now.getFullYear(), now.getMonth(), 1);
const endDate = new Date(now.getFullYear(), now.getMonth() + 1, 0, 23, 59, 59);

const incomeReport = await getIncomeAnalysisReport(startDate, endDate);
---

<FinanceLayout title="Análisis de Ingresos" user={user}>
        <!-- Header -->
        <div class="mb-8 flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold text-slate-900">
                    Análisis de Ingresos
                </h1>
                <p class="mt-2 text-slate-600">
                    Análisis detallado de ingresos - {
                        now.toLocaleDateString("es-BO", {
                            month: "long",
                            year: "numeric",
                        })
                    }
                </p>
            </div>
            <button
                onclick="window.print()"
                class="rounded-lg bg-amber-600 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-700"
            >
                Exportar
            </button>
        </div>

        <!-- Summary Cards -->
        <div class="mb-8 grid gap-4 sm:grid-cols-3">
            <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-6">
                <div class="flex items-center justify-between mb-2">
                    <p class="text-sm font-medium text-emerald-700">
                        Total Ingresos
                    </p>
                    <TrendingUp class="h-5 w-5 text-emerald-600" />
                </div>
                <p class="text-3xl font-bold text-emerald-900">
                    {formatBOB(incomeReport.totalIncome)}
                </p>
            </div>

            <div class="rounded-lg border border-slate-200 bg-white p-6">
                <div class="flex items-center justify-between mb-2">
                    <p class="text-sm font-medium text-slate-600">
                        Transacciones
                    </p>
                    <ChartColumn class="h-5 w-5 text-slate-400" />
                </div>
                <p class="text-3xl font-bold text-slate-900">
                    {incomeReport.incomeCount}
                </p>
            </div>

            <div class="rounded-lg border border-slate-200 bg-white p-6">
                <div class="flex items-center justify-between mb-2">
                    <p class="text-sm font-medium text-slate-600">Promedio</p>
                    <DollarSign class="h-5 w-5 text-slate-400" />
                </div>
                <p class="text-3xl font-bold text-slate-900">
                    {formatBOB(incomeReport.avgIncomeAmount)}
                </p>
            </div>
        </div>

        <div class="mb-8 grid gap-6 lg:grid-cols-2">
            <!-- Category Breakdown -->
            <div class="rounded-lg border border-slate-200 bg-white p-6">
                <h2 class="mb-6 text-lg font-semibold text-slate-900">
                    Por Categoría
                </h2>

                <div class="space-y-4">
                    {
                        incomeReport.categoryBreakdown.map((cat) => (
                            <div>
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex-1">
                                        <p class="text-sm font-medium text-slate-900">
                                            {cat.categoryName}
                                        </p>
                                        <p class="text-xs text-slate-500">
                                            {cat.transactionCount} ingresos ·
                                            Promedio {formatBOB(cat.avgAmount)}
                                        </p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm font-bold text-emerald-600">
                                            {formatBOB(cat.totalAmount)}
                                        </p>
                                        <p class="text-xs text-slate-500">
                                            {cat.percentage.toFixed(1)}%
                                        </p>
                                    </div>
                                </div>
                                <div class="bg-slate-100 rounded-full h-2">
                                    <div
                                        class="bg-emerald-500 h-2 rounded-full transition-all"
                                        style={`width: ${cat.percentage}%`}
                                    />
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>

            <!-- Top Income -->
            <div class="rounded-lg border border-slate-200 bg-white p-6">
                <h2 class="mb-6 text-lg font-semibold text-slate-900">
                    Mayores Ingresos
                </h2>

                <div class="space-y-3">
                    {
                        incomeReport.topIncome
                            .slice(0, 10)
                            .map((income, index) => (
                                <div class="flex items-start gap-3 rounded-lg border border-slate-100 p-3">
                                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-xs font-bold text-emerald-600">
                                        {index + 1}
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-medium text-slate-900">
                                            {income.concept}
                                        </p>
                                        <p class="text-xs text-slate-500">
                                            {income.categoryName}
                                        </p>
                                        {income.reference && (
                                            <p class="text-xs text-slate-400 mt-1">
                                                Ref: {income.reference}
                                            </p>
                                        )}
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm font-bold text-emerald-600">
                                            {formatBOB(income.amount)}
                                        </p>
                                        <p class="text-xs text-slate-500">
                                            {new Date(
                                                income.createdAt,
                                            ).toLocaleDateString("es-BO", {
                                                day: "numeric",
                                                month: "short",
                                            })}
                                        </p>
                                    </div>
                                </div>
                            ))
                    }
                </div>
            </div>
        </div>

        <!-- Weekly Growth -->
        <div class="mb-8 rounded-lg border border-slate-200 bg-white p-6">
            <h2 class="mb-6 text-lg font-semibold text-slate-900">
                Crecimiento Semanal
            </h2>

            <div class="space-y-3">
                {
                    incomeReport.incomeGrowth.map((week, index) => (
                        <div class="flex items-center gap-4">
                            <div class="w-20 text-sm text-slate-600">
                                Semana {week.period.split("-")[1]}
                            </div>
                            <div class="flex-1 flex items-center gap-3">
                                <div class="flex-1 bg-slate-100 rounded-full h-8">
                                    <div
                                        class="bg-emerald-500 h-8 rounded-full flex items-center justify-end pr-3"
                                        style={`width: ${Math.min(100, (parseFloat(week.totalIncome) / parseFloat(incomeReport.totalIncome)) * 100 * 4)}%`}
                                    >
                                        <span class="text-xs font-semibold text-white">
                                            {formatBOB(week.totalIncome)}
                                        </span>
                                    </div>
                                </div>
                                {index > 0 && (
                                    <div
                                        class={`text-xs font-semibold ${
                                            week.growthRate >= 0
                                                ? "text-emerald-600"
                                                : "text-red-600"
                                        }`}
                                    >
                                        {week.growthRate >= 0 ? "+" : ""}
                                        {week.growthRate.toFixed(1)}%
                                    </div>
                                )}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Hourly Distribution -->
        <div class="rounded-lg border border-slate-200 bg-white p-6">
            <div class="flex items-center gap-2 mb-6">
                <Clock class="h-5 w-5 text-amber-600" />
                <h2 class="text-lg font-semibold text-slate-900">
                    Distribución por Hora
                </h2>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-3">
                {
                    incomeReport.hourlyDistribution.map((hour) => {
                        const maxHourly = Math.max(
                            ...incomeReport.hourlyDistribution.map((h) =>
                                parseFloat(h.totalAmount),
                            ),
                        );
                        const heightPercent =
                            maxHourly > 0
                                ? (parseFloat(hour.totalAmount) / maxHourly) *
                                  100
                                : 0;

                        return (
                            <div class="text-center">
                                <div
                                    class="mb-2 flex items-end justify-center"
                                    style="height: 100px;"
                                >
                                    <div
                                        class="w-full bg-emerald-500 rounded-t"
                                        style={`height: ${heightPercent}%`}
                                        title={formatBOB(hour.totalAmount)}
                                    />
                                </div>
                                <p class="text-xs font-medium text-slate-900">
                                    {hour.hour}:00
                                </p>
                                <p class="text-xs text-slate-500">
                                    {hour.count} ops
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
</FinanceLayout>
