---
import { db } from "@/db";
import { invoiceRanges, transactionCategories } from "@/db/schema";
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import InvoiceRangeCreateDialog from "@/components/svelte/invoice-ranges/InvoiceRangeCreateDialog.svelte";
import InvoiceRangeEditDialog from "@/components/svelte/invoice-ranges/InvoiceRangeEditDialog.svelte";
import InvoiceRangeDeleteButton from "@/components/svelte/invoice-ranges/InvoiceRangeDeleteButton.svelte";
import { desc, asc, eq } from "drizzle-orm";
import InvoiceRangeAssignDialog from "@/components/svelte/invoice-ranges/InvoiceRangeAssignDialog.svelte";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");

const ranges = await db
    .select()
    .from(invoiceRanges)
    .orderBy(desc(invoiceRanges.current), desc(invoiceRanges.category));

const allCatsWithRange = await db
    .select({
        id:             transactionCategories.id,
        name:           transactionCategories.name,
        type:           transactionCategories.type,
        invoiceRangeId: transactionCategories.invoiceRangeId,
        status:         transactionCategories.status,
    })
    .from(transactionCategories)
    .where(eq(transactionCategories.status, true))
    .orderBy(asc(transactionCategories.type), asc(transactionCategories.name));

const catsByRange = new Map<string, typeof allCatsWithRange>();
for (const cat of allCatsWithRange) {
    if (!cat.invoiceRangeId) continue;
    const list = catsByRange.get(cat.invoiceRangeId) ?? [];
    list.push(cat);
    catsByRange.set(cat.invoiceRangeId, list);
}

const total     = ranges.length;
const active    = ranges.filter((r) => Number(r.current) < Number(r.rangeEnd)).length;
const exhausted = ranges.filter((r) => Number(r.current) >= Number(r.rangeEnd)).length;
const warning   = ranges.filter((r) => {
    const used  = Number(r.current)  - Number(r.rangeStart);
    const span  = Number(r.rangeEnd) - Number(r.rangeStart);
    const pct   = span > 0 ? (used / span) * 100 : 0;
    return pct >= 80 && Number(r.current) < Number(r.rangeEnd);
}).length;

type RangeStatus = "activo" | "warning" | "exhausted";

function getRangeStatus(r: typeof ranges[number]): RangeStatus {
    const used = Number(r.current)  - Number(r.rangeStart);
    const span = Number(r.rangeEnd) - Number(r.rangeStart);
    const pct  = span > 0 ? (used / span) * 100 : 0;
    if (Number(r.current) >= Number(r.rangeEnd)) return "exhausted";
    if (pct >= 80) return "warning";
    return "activo";
}

function getPct(r: typeof ranges[number]): number {
    const used = Number(r.current)  - Number(r.rangeStart);
    const span = Number(r.rangeEnd) - Number(r.rangeStart);
    return span > 0 ? Math.min(Math.round((used / span) * 100), 100) : 0;
}
---

<FinanceLayout title="Talonarios" user={user}>
        <div class="flex items-start justify-between gap-4 mb-2">
            <div>
                <h1 class="text-xl font-semibold text-slate-900">Talonarios</h1>
                <p class="text-sm text-slate-500 mt-0.5">
                    Gestiona los talonarios de numeración por cuenta de talonario.
                </p>
            </div>
            <InvoiceRangeCreateDialog client:only="svelte" />
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-2">
            <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm">
                <p class="text-xs text-slate-500 mb-1">Total talonarios</p>
                <p class="text-2xl font-semibold text-slate-900">{total}</p>
            </div>
            <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm">
                <p class="text-xs text-slate-500 mb-1">Activos</p>
                <p class="text-2xl font-semibold text-emerald-600">{active}</p>
            </div>
            <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm">
                <p class="text-xs text-slate-500 mb-1">Por agotarse</p>
                <p class="text-2xl font-semibold text-amber-500">{warning}</p>
            </div>
            <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm">
                <p class="text-xs text-slate-500 mb-1">Agotados</p>
                <p class="text-2xl font-semibold text-red-500">{exhausted}</p>
            </div>
        </div>

        <div class="rounded-lg border border-slate-200 bg-white shadow-sm overflow-hidden">
            {ranges.length > 0 ? (
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50">
                                <th class="w-8 px-2 py-3"></th>
                                <th class="px-4 py-3 font-medium text-slate-600 text-xs uppercase tracking-wide">Categoría</th>
                                <th class="px-4 py-3 font-medium text-slate-600 text-xs uppercase tracking-wide">Progreso</th>
                                <th class="px-4 py-3 font-medium text-slate-600 text-xs uppercase tracking-wide">Estado</th>
                                <th class="px-4 py-3 font-medium text-slate-600 text-xs uppercase tracking-wide">Cuentas</th>
                                <th class="px-4 py-3 font-medium text-slate-600 text-xs uppercase tracking-wide text-right">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            {ranges.map((range) => {
                                const status  = getRangeStatus(range);
                                const pct     = getPct(range);
                                const cats    = catsByRange.get(range.id) ?? [];
                                const catCount = cats.length;
                                const rowId   = `acc-${range.id}`;

                                const rowBg =
                                    status === "exhausted" ? "bg-red-50/40"
                                    : status === "warning"  ? "bg-amber-50/40"
                                    : "";

                                const barColor =
                                    status === "exhausted" ? "bg-red-500"
                                    : status === "warning"  ? "bg-amber-400"
                                    : "bg-emerald-500";

                                const badgeClass =
                                    status === "exhausted" ? "bg-red-100 text-red-700"
                                    : status === "warning"  ? "bg-amber-100 text-amber-700"
                                    : "bg-emerald-100 text-emerald-700";

                                const dotColor =
                                    status === "exhausted" ? "bg-red-500"
                                    : status === "warning"  ? "bg-amber-400"
                                    : "bg-emerald-500";

                                const badgeLabel =
                                    status === "exhausted" ? "Agotado"
                                    : status === "warning"  ? "Por agotarse"
                                    : "Activo";

                                const pctCardBg =
                                    status === "exhausted" ? "bg-red-50 border-red-200"
                                    : status === "warning"  ? "bg-amber-50 border-amber-200"
                                    : "bg-slate-100 border-slate-200";

                                const pctTextColor =
                                    status === "exhausted" ? "text-red-700"
                                    : status === "warning"  ? "text-amber-700"
                                    : "text-slate-600";

                                const remaining = Number(range.rangeEnd) - Number(range.current);

                                return (
                                    <>
                                        <tr
                                            class={`transition-colors hover:bg-slate-50/60 ${rowBg} ${catCount > 0 ? "cursor-pointer" : ""}`}
                                            data-accordion-trigger={catCount > 0 ? rowId : undefined}
                                        >
                                            <td class="w-8 px-2 py-3.5 text-center">
                                                {catCount > 0 ? (
                                                    <span
                                                        class="acc-chevron inline-flex items-center justify-center w-5 h-5 rounded text-slate-400 transition-transform duration-200"
                                                        data-target={rowId}
                                                    >
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="m9 18 6-6-6-6"/>
                                                        </svg>
                                                    </span>
                                                ) : (
                                                    <span class="inline-block w-5 h-5" />
                                                )}
                                            </td>

                                            <td class="px-4 py-3.5">
                                                <a href={`/talonarios/${range.id}`} class="font-medium text-blue-600 hover:text-blue-800 hover:underline capitalize">{range.category}
                                                    {range.prefix && (
                                                    <span class="inline-block font-mono text-xs px-2 py-0.5 rounded-md text-slate-400 border border-slate-200 ml-1.5">
                                                        {range.prefix}
                                                    </span>
                                                    )}
                                                </a>
                                            </td>

                                            <td class="px-4 py-3.5">
                                                <div class="flex items-center gap-2.5 min-w-52">
                                                    <span class={`inline-flex items-center justify-center rounded-md border px-2 py-0.5 font-mono text-xs font-semibold shrink-0 ${pctCardBg} ${pctTextColor}`}>
                                                        {pct}%
                                                    </span>
                                                    <div class="flex-1 min-w-0">
                                                        <div class="flex items-center gap-1.5">
                                                            <span class="font-mono text-[10px] text-slate-400 shrink-0">{Number(range.rangeStart).toLocaleString("es-BO")}</span>
                                                            <div class="flex-1 bg-slate-200 rounded-full h-1.5 overflow-hidden">
                                                                <div class={`h-full rounded-full ${barColor}`} style={`width: ${pct}%`} />
                                                            </div>
                                                            <span class="font-mono text-[10px] text-slate-400 shrink-0">{Number(range.rangeEnd).toLocaleString("es-BO")}</span>
                                                        </div>
                                                        <p class="font-mono text-[10px] text-slate-400 mt-0.5">
                                                            actual {Number(range.current).toLocaleString("es-BO")} · {remaining > 0 ? `${remaining.toLocaleString("es-BO")} restantes` : "sin restantes"}
                                                        </p>
                                                    </div>
                                                </div>
                                            </td>

                                            <td class="px-4 py-3.5">
                                                <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium ${badgeClass}`}>
                                                    <span class={`w-1.5 h-1.5 rounded-full shrink-0 ${dotColor}`} />
                                                    {badgeLabel}
                                                </span>
                                            </td>

                                            <td class="px-4 py-3.5">
                                                {catCount > 0 ? (
                                                    <span class="inline-flex text-nowrap items-center gap-1 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 tabular-nums">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                                        </svg>
                                                        {catCount} {catCount === 1 ? "cuenta" : "cuentas"}
                                                    </span>
                                                ) : (
                                                    <span class="inline-flex text-nowrap items-center gap-1 rounded-full bg-red-50 border border-red-100 px-2.5 py-1 text-xs font-medium text-red-500">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/>
                                                        </svg>
                                                        Sin cuentas
                                                    </span>
                                                )}
                                            </td>

                                            <td class="px-4 py-3.5">
                                                <div class="flex items-center justify-end gap-1.5">
                                                    <InvoiceRangeEditDialog range={range} client:only="svelte" />
                                                    <InvoiceRangeDeleteButton
                                                        range={range}
                                                        client:only="svelte"
                                                    />
                                                    <InvoiceRangeAssignDialog
                                                      rangeId={range.id}
                                                      rangeLabel={`${range.category} (${range.prefix ?? '—'})`}
                                                      prefix={range.prefix}
                                                      current={range.current}
                                                      rangeEnd={range.rangeEnd}
                                                      client:load
                                                    />
                                                </div>
                                            </td>
                                        </tr>

                                        {catCount > 0 && (
                                            <tr
                                                id={rowId}
                                                class="acc-panel hidden bg-slate-50/60 border-t-0"
                                            >
                                                <td class="w-8" />
                                                <td colspan="5" class="px-4 py-3 pb-4">
                                                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-2.5">
                                                        Cuentas asignadas a este talonario
                                                    </p>
                                                    <div class="flex flex-wrap gap-2">
                                                        {cats.map((cat) => (
                                                            <span class={`inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1 text-xs font-medium ${
                                                                cat.type === "income"
                                                                    ? "bg-emerald-50 border-emerald-200 text-emerald-700"
                                                                    : "bg-red-50 border-red-200 text-red-700"
                                                            }`}>
                                                                <span class={`w-1.5 h-1.5 rounded-full shrink-0 ${cat.type === "income" ? "bg-emerald-500" : "bg-red-400"}`} />
                                                                {cat.name}
                                                                <span class={`ml-0.5 text-[10px] opacity-60`}>
                                                                    {cat.type === "income" ? "ingreso" : "egreso"}
                                                                </span>
                                                            </span>
                                                        ))}
                                                    </div>
                                                </td>
                                            </tr>
                                        )}
                                    </>
                                );
                            })}
                        </tbody>
                    </table>
                </div>
            ) : (
                <div class="flex flex-col items-center justify-center py-16 px-4 text-center">
                    <div class="rounded-full bg-slate-100 p-4 mb-4">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-8 w-8 text-slate-400"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z" />
                            <path d="M14 8H8" />
                            <path d="M16 12H8" />
                            <path d="M13 16H8" />
                        </svg>
                    </div>
                    <p class="text-sm font-medium text-slate-700">No hay talonarios</p>
                    <p class="text-xs text-slate-500 mt-1 max-w-xs">
                        Crea el primer talonario con el botón "Nuevo talonario" para empezar a gestionar la numeración de facturas.
                    </p>
                </div>
            )}
        </div>

        {ranges.length > 0 && (
            <p class="text-xs text-slate-400 mt-3 text-right">
                {total} {total === 1 ? "talonario" : "talonarios"} en total
            </p>
        )}
</FinanceLayout>

<script>
    document.querySelectorAll<HTMLTableRowElement>("[data-accordion-trigger]").forEach((row) => {
        row.addEventListener("click", (e) => {
            if ((e.target as HTMLElement).closest("button, a, [role='dialog']")) return;

            const panelId = row.dataset.accordionTrigger!;
            const panel   = document.getElementById(panelId);
            const chevron = row.querySelector<HTMLElement>(`.acc-chevron[data-target="${panelId}"]`);
            if (!panel || !chevron) return;

            const isOpen = !panel.classList.contains("hidden");

            panel.classList.toggle("hidden", isOpen);
            chevron.style.transform = isOpen ? "" : "rotate(90deg)";
        });
    });
</script>
