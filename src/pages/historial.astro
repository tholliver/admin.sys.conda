---
import { db } from "@/db";
import { TrendingUp, TrendingDown, Search, SlidersHorizontal, Filter } from "@lucide/astro";
import InputDate from "@/components/forms/InputDate.astro";
import { transactions, transactionCategories, cashboxes } from "@/db/schema";
import { TRANSACTION_STATUS, TRANSACTION_TYPE } from "@/db/finance.types";
import { DecimalService } from "@/services/finances/decimal.service";
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import PaginationControls from "@/components/affiliates/PaginationControls.astro";
import TxStatusBadge from "@/components/financial/TxStatusBadge.astro";
import { date } from "@/utils/dates";
import { bob } from "@/utils/currency";
import VoidTransactionDialog from "@/components/svelte/finance/VoidTransactionDialog.svelte";
import { actions, isActionError } from "astro:actions";
import { decodeSimpleCursor, encodeSimpleCursor } from "@/utils/cursor-pagination";
import { eq, and, gte, lte, ilike, or, desc, count, sql, lt, asc, type SQL } from "drizzle-orm";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");

// ─── VOID RESULT ─────────────────────────────────────────────────────────────
const voidResult = Astro.getActionResult(actions.finance.voidTransaction);
const voidError = isActionError(voidResult?.error) ? voidResult.error.message : null;
const voidSuccess = !voidResult?.error && voidResult?.data?.message ? voidResult.data.message : null;

// ─── QUERY PARAMS ─────────────────────────────────────────────────────────────
const PAGE_SIZE_DEFAULT = 10;
const pageSizeRaw = parseInt(
  Astro.url.searchParams.get("pageSize") ?? `${PAGE_SIZE_DEFAULT}`,
  10,
);
const pageSize = Number.isFinite(pageSizeRaw)
  ? Math.min(100, Math.max(1, pageSizeRaw))
  : PAGE_SIZE_DEFAULT;
const pageNumber = Math.max(
  1,
  parseInt(Astro.url.searchParams.get("page") ?? "1", 10),
);
const currentCursor = Astro.url.searchParams.get("cursor") ?? null;
const decodedCursor = currentCursor ? decodeSimpleCursor(currentCursor) : null;
const search = Astro.url.searchParams.get("q")?.trim() ?? "";
const typeFilter = Astro.url.searchParams.get("type") ?? "all";
const statusFilter = Astro.url.searchParams.get("status") ?? "all";
const cashboxFilter = Astro.url.searchParams.get("cashbox") ?? "";
const dateFrom = Astro.url.searchParams.get("from") ?? "";
const dateTo = Astro.url.searchParams.get("to") ?? "";
const paginationParams = new URLSearchParams();
if (search) paginationParams.set("q", search);
if (typeFilter !== "all") paginationParams.set("type", typeFilter);
if (statusFilter !== "all") paginationParams.set("status", statusFilter);
if (cashboxFilter) paginationParams.set("cashbox", cashboxFilter);
if (dateFrom) paginationParams.set("from", dateFrom);
if (dateTo) paginationParams.set("to", dateTo);
const paginationQuery = paginationParams.toString();

// ─── BUILD WHERE CONDITIONS ───────────────────────────────────────────────────
const conditions: SQL[] = [];

if (typeFilter === TRANSACTION_TYPE.DEPOSIT) {
  conditions.push(eq(transactions.type, TRANSACTION_TYPE.DEPOSIT));
} else if (typeFilter === TRANSACTION_TYPE.WITHDRAW) {
  conditions.push(eq(transactions.type, TRANSACTION_TYPE.WITHDRAW));
}

if (statusFilter === TRANSACTION_STATUS.COMPLETED) {
  conditions.push(eq(transactions.status, TRANSACTION_STATUS.COMPLETED));
} else if (statusFilter === "cancelled") {
  conditions.push(eq(transactions.status, TRANSACTION_STATUS.CANCELLED));
} else if (statusFilter === "pending") {
  conditions.push(eq(transactions.status, TRANSACTION_STATUS.PENDING));
}

if (dateFrom) conditions.push(gte(transactions.createdAt, new Date(`${dateFrom}T00:00:00-04:00`)));
if (dateTo) conditions.push(lte(transactions.createdAt, new Date(`${dateTo}T23:59:59-04:00`)));
if (cashboxFilter) conditions.push(eq(transactions.cashboxId, cashboxFilter));

if (search) {
  conditions.push(
    or(
      ilike(transactions.concept, `%${search}%`),
      ilike(transactions.externalReference, `%${search}%`),
    )!,
  );
}

const whereClause = conditions.length > 0 ? and(...conditions) : undefined;

// ─── COUNT TOTAL ──────────────────────────────────────────────────────────────
const [{ total }] = await db
  .select({ total: count() })
  .from(transactions)
  .where(whereClause);

const pageConditions = decodedCursor
  ? [...conditions, lt(transactions.createdAt, decodedCursor)]
  : conditions;
const pageWhereClause =
  pageConditions.length > 0 ? and(...pageConditions) : undefined;

// ─── FETCH PAGE ───────────────────────────────────────────────────────────────
const pageTransactions = await db
  .select({
    id: transactions.id,
    type: transactions.type,
    amount: transactions.amount,
    concept: transactions.concept,
    externalReference: transactions.externalReference,
    invoiceNumber: transactions.invoiceNumber,
    status: transactions.status,
    balanceAfter: transactions.balanceAfter,
    createdAt: transactions.createdAt,
    authorizedBy: transactions.authorizedBy,
    metadata: transactions.metadata,
    categoryName: transactionCategories.name,
    cashboxName: cashboxes.name,
    cashboxCode: cashboxes.code,
  })
  .from(transactions)
  .leftJoin(transactionCategories, eq(transactions.categoryId, transactionCategories.id))
  .leftJoin(cashboxes, eq(transactions.cashboxId, cashboxes.id))
  .where(pageWhereClause)
  .orderBy(desc(transactions.createdAt))
  .limit(pageSize + 1);

const hasNextPage = pageTransactions.length > pageSize;
const visibleTransactions = hasNextPage
  ? pageTransactions.slice(0, pageSize)
  : pageTransactions;
const lastTransaction = visibleTransactions.at(-1);
const nextCursor =
  hasNextPage && lastTransaction
    ? encodeSimpleCursor(lastTransaction.createdAt)
    : null;

// ─── FILTERED TOTALS ─────────────────────────────────────────────────────────
const [filteredTotals] = await db
  .select({
    totalIngresos: sql<string>`COALESCE(SUM(CASE WHEN ${transactions.type} = ${TRANSACTION_TYPE.DEPOSIT} AND ${transactions.status} = ${TRANSACTION_STATUS.COMPLETED} THEN CAST(${transactions.amount} AS NUMERIC) ELSE 0 END), 0)`,
    totalRetiros: sql<string>`COALESCE(SUM(CASE WHEN ${transactions.type} = ${TRANSACTION_TYPE.WITHDRAW} AND ${transactions.status} = ${TRANSACTION_STATUS.COMPLETED} THEN CAST(${transactions.amount} AS NUMERIC) ELSE 0 END), 0)`,
  })
  .from(transactions)
  .where(whereClause);

const allCashboxes = await db
  .select({ id: cashboxes.id, name: cashboxes.name, code: cashboxes.code })
  .from(cashboxes)
  .where(eq(cashboxes.status, "activo"))
  .orderBy(asc(cashboxes.name));

const neto = DecimalService.subtract(filteredTotals.totalIngresos, filteredTotals.totalRetiros);
const isNetoPositive = DecimalService.compare(neto, "0") >= 0;

const canVoid = ["ADMIN", "ADMON"].includes(user.role);

const isFiltered = search || typeFilter !== "all" || statusFilter !== "all" || cashboxFilter || dateFrom || dateTo;
---

<FinanceLayout title="Historial de Transacciones" user={user}>
  <div class="px-3 py-4 sm:px-6 lg:px-8 space-y-4">

    <!-- Alerts -->
    {voidSuccess && (
      <div class="rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
        {voidSuccess}
      </div>
    )}
    {voidError && (
      <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        {voidError}
      </div>
    )}

    <!-- Summary Cards -->
    <div class="grid grid-cols-3 gap-3">
      <!-- Ingresos -->
      <div class="rounded-xl border border-slate-200 bg-white p-4 flex flex-col gap-1">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wide">Ingresos</span>
          <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100">
            <TrendingUp class="h-3 w-3 text-emerald-600" />
          </span>
        </div>
        <p class="text-xl font-bold text-emerald-600 tabular-nums">{bob(filteredTotals.totalIngresos)}</p>
        {isFiltered && <span class="text-[10px] text-slate-400 leading-none">con filtros</span>}
      </div>

      <!-- Egresos -->
      <div class="rounded-xl border border-slate-200 bg-white p-4 flex flex-col gap-1">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wide">Egresos</span>
          <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-red-100">
            <TrendingDown class="h-3 w-3 text-red-600" />
          </span>
        </div>
        <p class="text-xl font-bold text-red-600 tabular-nums">{bob(filteredTotals.totalRetiros)}</p>
        {isFiltered && <span class="text-[10px] text-slate-400 leading-none">con filtros</span>}
      </div>

      <!-- Neto -->
      <div class={`rounded-xl border-2 p-4 flex flex-col gap-1 ${isNetoPositive ? "border-emerald-200 bg-emerald-50" : "border-red-200 bg-red-50"}`}>
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wide">Neto</span>
          <span class={`inline-flex h-6 w-6 items-center justify-center rounded-full ${isNetoPositive ? "bg-emerald-200" : "bg-red-200"}`}>
            {isNetoPositive ? <TrendingUp class="h-3 w-3 text-emerald-700" /> : <TrendingDown class="h-3 w-3 text-red-700" />}
          </span>
        </div>
        <p class={`text-xl font-bold tabular-nums ${isNetoPositive ? "text-emerald-600" : "text-red-600"}`}>
          {bob(neto)}
        </p>
      </div>
    </div>

    <!-- Filters -->
    <form method="GET" class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">

      <!-- Search row -->
      <div class="px-3 pt-3 pb-2 flex items-center gap-2">
        <div class="relative flex-1">
          <Search class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400 pointer-events-none" />
          <input
            type="search"
            autocomplete="off"
            name="q"
            value={search}
            placeholder="Buscar cuenta o referencia..."
            class="w-full rounded-lg border border-slate-200 bg-slate-50 pl-9 pr-3 py-2 text-sm text-slate-900 placeholder-slate-400 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-100 transition"
          />
        </div>
        <button
          type="button"
          id="toggle-filters"
          class={`inline-flex items-center gap-2 px-3 py-2 rounded-lg border text-sm font-medium transition-colors shrink-0 ${isFiltered ? "border-blue-300 bg-blue-50 text-blue-700" : "border-slate-200 bg-slate-50 text-slate-600 hover:bg-slate-100"}`}
        >
          <SlidersHorizontal class="h-4 w-4" />
          <span class="hidden sm:inline">Filtros</span>
          {isFiltered && (
            <span class="inline-flex items-center justify-center h-4 w-4 rounded-full bg-blue-600 text-white text-[10px] font-bold">
              {[search, typeFilter !== "all", statusFilter !== "all", cashboxFilter, dateFrom, dateTo].filter(Boolean).length}
            </span>
          )}
        </button>
        <button
          type="submit"
          class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-blue-600 text-sm font-semibold text-white hover:bg-blue-700 active:bg-blue-800 transition-colors shrink-0"
        >
          <Search class="h-4 w-4" />
          <span class="hidden sm:inline">Buscar</span>
        </button>
      </div>

      <!-- Meta row: count left, chips right -->
      <div class="px-3 py-1.5 flex items-center justify-between gap-3 border-t border-slate-100 min-h-8">
        <span class="text-xs text-slate-400 shrink-0 flex items-center gap-1">
          <Filter class="h-3 w-3" />
          {total} resultado{total !== 1 ? "s" : ""}
        </span>
        {isFiltered && (
          <div class="flex flex-wrap gap-1.5 justify-end">
            {search && (
              <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 border border-blue-200 px-2 py-0.5 text-[11px] text-blue-700">
                "{search}"
              </span>
            )}
            {typeFilter !== "all" && (
              <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 border border-blue-200 px-2 py-0.5 text-[11px] text-blue-700">
                {typeFilter === "deposit" ? "Solo Ingresos" : "Solo Egresos"}
              </span>
            )}
            {statusFilter !== "all" && (
              <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 border border-blue-200 px-2 py-0.5 text-[11px] text-blue-700">
                {statusFilter === "completado" ? "Completadas" : statusFilter === "cancelled" ? "Anuladas" : "Pendientes"}
              </span>
            )}
            {cashboxFilter && (
              <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 border border-blue-200 px-2 py-0.5 text-[11px] text-blue-700">
                {allCashboxes.find((c) => c.id === cashboxFilter)?.name ?? "Caja"}
              </span>
            )}
            {dateFrom && (
              <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 border border-blue-200 px-2 py-0.5 text-[11px] text-blue-700">
                Desde: {dateFrom}
              </span>
            )}
            {dateTo && (
              <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 border border-blue-200 px-2 py-0.5 text-[11px] text-blue-700">
                Hasta: {dateTo}
              </span>
            )}
            <a
              href="/historial"
              class="inline-flex items-center rounded-full border border-slate-200 px-2 py-0.5 text-[11px] text-slate-500 hover:bg-slate-50 transition-colors"
            >
              Limpiar
            </a>
          </div>
        )}
      </div>

      <!-- Collapsible filters -->
      <div id="filters-panel" class={`border-t border-slate-100 ${isFiltered ? "" : "hidden"}`}>
        <div class="w-full px-3 py-2.5 grid grid-cols-2 sm:grid-cols-5 gap-2">
          <select
            name="type"
            class="w-full rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-xs text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100 transition"
          >
            <option value="all" selected={typeFilter === "all"}>Todos los tipos</option>
            <option value="deposit" selected={typeFilter === "deposit"}>Solo Ingresos</option>
            <option value="withdraw" selected={typeFilter === "withdraw"}>Solo Egresos</option>
          </select>

          <select
            name="status"
            class="w-full rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-xs text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100 transition"
          >
            <option value="all" selected={statusFilter === "all"}>Todos los estados</option>
            <option value="completado" selected={statusFilter === "completado"}>Completadas</option>
            <option value="cancelled" selected={statusFilter === "cancelled"}>Anuladas</option>
            <option value="pending" selected={statusFilter === "pending"}>Pendientes</option>
          </select>

          <select
            name="cashbox"
            class="w-full rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-xs text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100 transition"
          >
            <option value="" selected={!cashboxFilter}>Todas las cajas</option>
            {allCashboxes.map((c) => (
              <option value={c.id} selected={cashboxFilter === c.id}>{c.name}</option>
            ))}
          </select>

          <div class="flex items-center gap-1 text-xs text-slate-500 min-w-0 sm:col-span-2">
            <span class="shrink-0">Desde</span>
            <div class="flex-1 min-w-0">
              <InputDate id="from" name="from" value={dateFrom} aria-label="Fecha desde" class="py-1! px-2! text-xs!" />
            </div>
            <span class="shrink-0">–</span>
            <div class="flex-1 min-w-0">
              <InputDate id="to" name="to" value={dateTo} aria-label="Fecha hasta" class="py-1! px-2! text-xs!" />
            </div>
          </div>
        </div>
      </div>


    </form>

    <script>
      const toggleBtn = document.getElementById("toggle-filters");
      const filtersPanel = document.getElementById("filters-panel");
      if (toggleBtn && filtersPanel) {
        toggleBtn.addEventListener("click", () => {
          filtersPanel.classList.toggle("hidden");
          toggleBtn.classList.toggle("border-blue-300");
          toggleBtn.classList.toggle("bg-blue-50");
          toggleBtn.classList.toggle("text-blue-700");
          toggleBtn.classList.toggle("border-slate-200");
          toggleBtn.classList.toggle("bg-slate-50");
          toggleBtn.classList.toggle("text-slate-600");
        });
      }
    </script>

    <!-- Table -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full min-w-max text-sm text-left">
          <thead class="bg-slate-50 border-b border-slate-200">
            <tr>
                <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide whitespace-nowrap">Tipo</th>
                <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide whitespace-nowrap">Cuenta / Categoría</th>
                <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide whitespace-nowrap">Caja</th>
                <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide whitespace-nowrap">Estado</th>
                <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide whitespace-nowrap">Fecha</th>
                <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide whitespace-nowrap text-right">Monto</th>
                <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide whitespace-nowrap text-right">Saldo GEN</th>
              {canVoid && <th class="px-4 py-3 text-xs font-semibold text-slate-500 uppercase whitespace-nowrap tracking-wide text-center">Anular</th>}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {visibleTransactions.length === 0 ? (
              <tr>
                <td colspan={canVoid ? 8 : 7} class="px-4 py-12 text-center text-slate-400 text-sm">
                  <div class="flex flex-col items-center gap-2">
                    <Filter class="h-8 w-8 text-slate-200" />
                    No hay transacciones con los filtros seleccionados.
                  </div>
                </td>
              </tr>
            ) : (
              visibleTransactions.map((tx) => {
                const isCancelled = tx.status === "cancelado";
                let voidMeta: { reason?: string } = {};
                try { voidMeta = JSON.parse(tx.metadata ?? "{}"); } catch {}

                return (
                  <tr class={`hover:bg-slate-50 transition-colors ${isCancelled ? "opacity-55" : ""}`}>
                    <td class="px-4 py-3">
                      <div
                        title={tx.type === "deposit" ? "Ingreso" : "Egreso"}
                        aria-label={tx.type === "deposit" ? "Ingreso" : "Egreso"}
                        class={`inline-flex h-7 w-7 items-center justify-center rounded-full ${tx.type === "deposit" ? "bg-emerald-100 text-emerald-700" : "bg-red-100 text-red-700"}`}
                      >
                        {tx.type === "deposit" ? <TrendingUp class="h-3.5 w-3.5" /> : <TrendingDown class="h-3.5 w-3.5" />}
                      </div>
                    </td>
                    <td class="px-4 py-3">
                      <p class="font-medium text-slate-900">{tx.concept}</p>
                      <p class="text-xs text-slate-400 mt-0.5">{tx.invoiceNumber ? `#${tx.invoiceNumber}` : tx.externalReference || "—"}</p>
                    </td>
                    <td class="px-4 py-3">
                      {tx.cashboxCode === "GEN"
                        ? <span class="text-xs text-slate-400">GEN</span>
                        : <span class="inline-flex items-center rounded-full bg-slate-100 border border-slate-200 px-2 py-0.5 text-[10px] font-medium text-slate-600">{tx.cashboxCode}</span>
                      }
                    </td>
                    <td class="px-4 py-3">
                      <TxStatusBadge status={tx.status} iconOnly />
                      {isCancelled && voidMeta.reason && (
                        <p class="mt-1 text-xs text-slate-400 max-w-32 truncate" title={voidMeta.reason}>
                          {voidMeta.reason}
                        </p>
                      )}
                    </td>
                    <td class="px-4 py-3 text-xs text-slate-500 whitespace-nowrap">
                      {date(tx.createdAt)}
                    </td>
                    <td class={`px-4 py-3 text-right font-semibold whitespace-nowrap tabular-nums ${tx.type === "deposit" ? "text-emerald-600" : "text-red-600"} ${isCancelled ? "line-through" : ""}`}>
                      {tx.type === "deposit" ? "+" : "-"}{bob(tx.amount)}
                    </td>
                    <td class="px-4 py-3 text-right text-slate-500 whitespace-nowrap tabular-nums text-xs">
                      {tx.balanceAfter ? bob(tx.balanceAfter) : "—"}
                    </td>
                    {canVoid && (
                      <td class="px-4 py-3 text-center">
                        {!isCancelled ? (
                          <VoidTransactionDialog
                            transactionId={tx.id}
                            concept={tx.concept}
                            amount={tx.amount}
                            client:load
                          />
                        ) : (
                          <span class="text-xs text-slate-400">Anulada</span>
                        )}
                      </td>
                    )}
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>

    {total > 0 && (
      <PaginationControls
        nextCursor={nextCursor}
        prevCursor={currentCursor}
        hasNextPage={hasNextPage}
        totalCount={total}
        pageSize={pageSize}
        currentPageCount={visibleTransactions.length}
        pageNumber={pageNumber}
        extraQuery={paginationQuery}
      />
    )}

  </div>
</FinanceLayout>
