---
import { db } from "@/db";
import { TrendingUp, TrendingDown, Search } from "@lucide/astro";
import InputDate from "@/components/forms/InputDate.astro";
import { transactions, transactionCategories } from "@/db/schema";
import { DecimalService } from "@/services/finances/decimal.service";
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import PaginationControls from "@/components/affiliates/history/PaginationControls.astro";
import TxStatusBadge from "@/components/financial/TxStatusBadge.astro";
import { formatter } from "@/utils/timex";
import { formatBOB } from "@/utils/formatters";
import VoidTransactionDialog from "@/components/svelte/finance/VoidTransactionDialog.svelte";
import { actions, isActionError } from "astro:actions";
import { decodeSimpleCursor, encodeSimpleCursor } from "@/utils/cursor-pagination";
import { eq, and, gte, lte, ilike, or, desc, count, sql, lt } from "drizzle-orm";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");

// ─── VOID RESULT ─────────────────────────────────────────────────────────────
const voidResult = Astro.getActionResult(actions.finance.voidTransaction);
const voidError = isActionError(voidResult?.error) ? voidResult.error.message : null;
const voidSuccess = !voidResult?.error && voidResult?.data?.message ? voidResult.data.message : null;

// ─── QUERY PARAMS ─────────────────────────────────────────────────────────────
const PAGE_SIZE_DEFAULT = 10;
const pageSizeRaw = parseInt(
  Astro.url.searchParams.get("pageSize") ?? `${PAGE_SIZE_DEFAULT}`,
  10,
);
const pageSize = Number.isFinite(pageSizeRaw)
  ? Math.min(100, Math.max(1, pageSizeRaw))
  : PAGE_SIZE_DEFAULT;
const pageNumber = Math.max(
  1,
  parseInt(Astro.url.searchParams.get("page") ?? "1", 10),
);
const currentCursor = Astro.url.searchParams.get("cursor") ?? null;
const decodedCursor = currentCursor ? decodeSimpleCursor(currentCursor) : null;
const search = Astro.url.searchParams.get("q")?.trim() ?? "";
const typeFilter = Astro.url.searchParams.get("type") ?? "all";
const statusFilter = Astro.url.searchParams.get("status") ?? "all";
const dateFrom = Astro.url.searchParams.get("from") ?? "";
const dateTo = Astro.url.searchParams.get("to") ?? "";
const paginationParams = new URLSearchParams();
if (search) paginationParams.set("q", search);
if (typeFilter !== "all") paginationParams.set("type", typeFilter);
if (statusFilter !== "all") paginationParams.set("status", statusFilter);
if (dateFrom) paginationParams.set("from", dateFrom);
if (dateTo) paginationParams.set("to", dateTo);
const paginationQuery = paginationParams.toString();

// ─── BUILD WHERE CONDITIONS ───────────────────────────────────────────────────
const conditions: any[] = [];

if (typeFilter === "deposit") conditions.push(eq(transactions.type, "deposit"));
else if (typeFilter === "withdraw") conditions.push(eq(transactions.type, "withdraw"));

if (statusFilter === "completed") conditions.push(eq(transactions.status, "completed"));
else if (statusFilter === "cancelled") conditions.push(eq(transactions.status, "cancelled"));
else if (statusFilter === "pending") conditions.push(eq(transactions.status, "pending"));

if (dateFrom) conditions.push(gte(transactions.createdAt, new Date(`${dateFrom}T00:00:00-04:00`)));
if (dateTo) conditions.push(lte(transactions.createdAt, new Date(`${dateTo}T23:59:59-04:00`)));

if (search) {
  conditions.push(
    or(
      ilike(transactions.concept, `%${search}%`),
      ilike(transactions.reference, `%${search}%`),
    )!,
  );
}

const whereClause = conditions.length > 0 ? and(...conditions) : undefined;

// ─── COUNT TOTAL ──────────────────────────────────────────────────────────────
const [{ total }] = await db
  .select({ total: count() })
  .from(transactions)
  .where(whereClause);

const pageConditions = decodedCursor
  ? [...conditions, lt(transactions.createdAt, decodedCursor)]
  : conditions;
const pageWhereClause =
  pageConditions.length > 0 ? and(...pageConditions) : undefined;

// ─── FETCH PAGE ───────────────────────────────────────────────────────────────
const pageTransactions = await db
  .select({
    id: transactions.id,
    type: transactions.type,
    amount: transactions.amount,
    concept: transactions.concept,
    reference: transactions.reference,
    status: transactions.status,
    balanceAfter: transactions.balanceAfter,
    createdAt: transactions.createdAt,
    authorizedBy: transactions.authorizedBy,
    metadata: transactions.metadata,
    categoryName: transactionCategories.name,
  })
  .from(transactions)
  .leftJoin(transactionCategories, eq(transactions.categoryId, transactionCategories.id))
  .where(pageWhereClause)
  .orderBy(desc(transactions.createdAt))
  .limit(pageSize + 1);

const hasNextPage = pageTransactions.length > pageSize;
const visibleTransactions = hasNextPage
  ? pageTransactions.slice(0, pageSize)
  : pageTransactions;
const lastTransaction = visibleTransactions.at(-1);
const nextCursor =
  hasNextPage && lastTransaction
    ? encodeSimpleCursor(lastTransaction.createdAt)
    : null;

// ─── FILTERED TOTALS ─────────────────────────────────────────────────────────
const [filteredTotals] = await db
  .select({
    totalIngresos: sql<string>`COALESCE(SUM(CASE WHEN ${transactions.type} = 'deposit' AND ${transactions.status} = 'completed' THEN CAST(${transactions.amount} AS NUMERIC) ELSE 0 END), 0)`,
    totalRetiros: sql<string>`COALESCE(SUM(CASE WHEN ${transactions.type} = 'withdraw' AND ${transactions.status} = 'completed' THEN CAST(${transactions.amount} AS NUMERIC) ELSE 0 END), 0)`,
  })
  .from(transactions)
  .where(whereClause);

const neto = DecimalService.subtract(filteredTotals.totalIngresos, filteredTotals.totalRetiros);
const isNetoPositive = DecimalService.compare(neto, "0") >= 0;

const canVoid = ["ADMIN", "ADMON"].includes(user.role);
---

<FinanceLayout title="Historial de Transacciones" user={user}>
    <div class="mx-auto max-w-7xl px-4 py-2 sm:px-6 lg:px-8">

      {voidSuccess && (
        <div class="mb-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
          {voidSuccess}
        </div>
      )}
      {voidError && (
        <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
          {voidError}
        </div>
      )}

      <!-- Summary Cards -->
      <div class="mb-6 grid gap-4 sm:grid-cols-3">
        <div class="rounded-lg border border-slate-200 bg-white p-5">
          <p class="text-sm font-medium text-slate-600">Ingresos (filtro activo)</p>
          <p class="mt-1 text-2xl font-bold text-emerald-600">{formatBOB(filteredTotals.totalIngresos)}</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5">
          <p class="text-sm font-medium text-slate-600">Egresos (filtro activo)</p>
          <p class="mt-1 text-2xl font-bold text-red-600">{formatBOB(filteredTotals.totalRetiros)}</p>
        </div>
        <div class={`rounded-lg border-2 p-5 ${isNetoPositive ? "border-emerald-200 bg-emerald-50" : "border-red-200 bg-red-50"}`}>
          <p class="text-sm font-medium text-slate-600">Neto</p>
          <p class={`mt-1 text-2xl font-bold ${isNetoPositive ? "text-emerald-600" : "text-red-600"}`}>
            {formatBOB(neto)}
          </p>
        </div>
      </div>

      <!-- Filters -->
      <form method="GET" class="mb-6 rounded-lg border border-slate-200 bg-white shadow-sm overflow-hidden">
          <div class="px-3 py-2">
              <div class="relative">
                  <Search class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
                  <input
                    type="search"
                    name="q"
                    value={search}
                    placeholder="Buscar cuenta o referencia..."
                    class="w-full rounded-md border border-slate-300 bg-white pl-9 pr-3 py-1.5 text-sm text-slate-900 placeholder-slate-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100"
                  />
              </div>
          </div>
          <div class="h-px bg-slate-200" />
          <div class="px-3 py-2 flex items-center justify-between gap-1.5">
              <span id="counts" class="text-xs text-slate-500 mr-auto">{total} transacción(es)</span>
              <div class="flex items-center gap-1.5 flex-wrap">
                  <select name="type" class="rounded-md border border-slate-300 px-2.5 py-1.5 text-xs text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100">
                      <option value="all" selected={typeFilter === "all"}>Todos los tipos</option>
                      <option value="deposit" selected={typeFilter === "deposit"}>Solo Ingresos</option>
                      <option value="withdraw" selected={typeFilter === "withdraw"}>Solo Egresos</option>
                  </select>
                  <select name="status" class="rounded-md border border-slate-300 px-2.5 py-1.5 text-xs text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100">
                      <option value="all" selected={statusFilter === "all"}>Todos los estados</option>
                      <option value="completed" selected={statusFilter === "completed"}>Completadas</option>
                      <option value="cancelled" selected={statusFilter === "cancelled"}>Anuladas</option>
                      <option value="pending" selected={statusFilter === "pending"}>Pendientes</option>
                  </select>
                  <div class="flex items-center gap-2 text-xs text-slate-600">
                      <span>Desde:</span>
                      <InputDate id="from" name="from" value={dateFrom} aria-label="Fecha hasta para filtrar eventos" />
                  </div>
                  <div class="flex items-center gap-2 text-xs text-slate-600">
                      <span>Hasta:</span>
                      <InputDate id="to" name="to" value={dateTo} aria-label="Fecha hasta para filtrar eventos" />
                  </div>
                  <button type="submit" class="rounded-md bg-blue-600 px-2.5 py-1.5 text-xs font-semibold text-white hover:bg-blue-700 transition-colors">
                      Filtrar
                  </button>
                  <a href="/historial" class="rounded-md border border-slate-300 px-2.5 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50 transition-colors">
                      Limpiar
                  </a>
              </div>
          </div>
      </form>

      <!-- Table -->
      <div class="rounded-lg border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm text-left">
            <thead class="bg-slate-50 border-b border-slate-200 text-slate-600">
              <tr>
                <th class="px-4 py-3 font-medium">Tipo</th>
                <th class="px-4 py-3 font-medium">Cuenta / Categoría</th>
                <!-- <th class="px-4 py-3 font-medium">Referencia</th> -->
                <th class="px-4 py-3 font-medium">Estado</th>
                <th class="px-4 py-3 font-medium">Fecha</th>
                <th class="px-4 py-3 font-medium text-right">Monto</th>
                <th class="px-4 py-3 font-medium text-right">Saldo</th>
                {canVoid && <th class="px-4 py-3 font-medium text-center">Anular</th>}
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {visibleTransactions.length === 0 ? (
                <tr>
                  <td colspan={canVoid ? 8 : 7} class="px-4 py-10 text-center text-slate-500">
                    No hay transacciones con los filtros seleccionados.
                  </td>
                </tr>
              ) : (
                visibleTransactions.map((tx) => {
                  const isCancelled = tx.status === "cancelled";
                  let voidMeta: { reason?: string } = {};
                  try { voidMeta = JSON.parse(tx.metadata ?? "{}"); } catch {}

                  return (
                    <tr class={`hover:bg-slate-50 transition-colors ${isCancelled ? "opacity-60" : ""}`}>
                      <td class="px-4 py-3">
                        <div class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ${tx.type === "deposit" ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700"}`}>
                          {tx.type === "deposit" ? <TrendingUp class="h-3 w-3" /> : <TrendingDown class="h-3 w-3" />}
                          {tx.type === "deposit" ? "Ingreso" : "Egreso"}
                        </div>
                      </td>
                      <td class="px-4 py-3">
                        <p class="font-medium text-slate-900">{tx.concept}</p>
                         {tx.reference || "—"}
                        <!-- {tx.categoryName && <p class="text-xs text-slate-500">{tx.categoryName}</p>} -->
                      </td>
                      <!-- <td class="px-4 py-3 text-slate-500 max-w-32 truncate" title={tx.reference ?? ""}>
                        {tx.reference || "—"}
                      </td> -->
                      <td class="px-4 py-3">
                        <TxStatusBadge status={tx.status} />
                        {isCancelled && voidMeta.reason && (
                          <p class="mt-1 text-xs text-slate-400 max-w-32 truncate" title={voidMeta.reason}>
                            {voidMeta.reason}
                          </p>
                        )}
                      </td>
                      <td class="px-4 py-3 text-slate-500 whitespace-nowrap">
                        {formatter.format(tx.createdAt)}
                      </td>
                      <td class={`px-4 py-3 text-right font-semibold whitespace-nowrap ${tx.type === "deposit" ? "text-green-600" : "text-red-600"} ${isCancelled ? "line-through" : ""}`}>
                        {tx.type === "deposit" ? "+" : "-"}{formatBOB(tx.amount)}
                      </td>
                      <td class="px-4 py-3 text-right text-slate-600 whitespace-nowrap tabular-nums">
                        {tx.balanceAfter ? formatBOB(tx.balanceAfter) : "—"}
                      </td>
                      {canVoid && (
                        <td class="px-4 py-3 text-center">
                          {!isCancelled ? (
                            <VoidTransactionDialog
                              transactionId={tx.id}
                              concept={tx.concept}
                              amount={tx.amount}
                              client:load
                            />
                          ) : (
                            <span class="text-xs text-slate-400">Anulada</span>
                          )}
                        </td>
                      )}
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>
      </div>

      {total > 0 && (
        <div class="mt-4">
          <PaginationControls
            nextCursor={nextCursor}
            prevCursor={currentCursor}
            hasNextPage={hasNextPage}
            totalCount={total}
            pageSize={pageSize}
            currentPageCount={visibleTransactions.length}
            pageNumber={pageNumber}
            extraQuery={paginationQuery}
          />
        </div>
      )}
    </div>


</FinanceLayout>
