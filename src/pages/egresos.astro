---
// src/pages/egresos.astro
import { db } from "@/db";
import { ArrowUp, TrendingDown, TriangleAlert } from "@lucide/astro";
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import {
    cashboxes,
    transactionCategories,
    transactions,
    invoiceRanges,
    employees
} from "@/db/schema";
import { eq, desc, and, sql, isNull, asc } from "drizzle-orm";
import { date } from "@/utils/dates";
import WithdrawOverdraftForm from "@/components/svelte/finance/WithdrawOverdraftForm.svelte";
import { bob } from "@/utils/currency";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");

// ============================================================================
// DATA FETCHING
// ============================================================================

const activeWithdrawalTransactionCategories = await db
    .select({
        id: transactionCategories.id,
        name: transactionCategories.name,
        code: transactionCategories.code,
        type: transactionCategories.type,
        description: transactionCategories.description,
        icon: transactionCategories.icon,
        status: transactionCategories.status,
        requiresAuthorization: transactionCategories.requiresAuthorization,
        invoiceRangeId: transactionCategories.invoiceRangeId,
        invoiceRangePrefix: invoiceRanges.prefix,
        invoiceRangeStart: invoiceRanges.rangeStart,
        invoiceRangeCurrent: invoiceRanges.current,
        invoiceRangeEnd: invoiceRanges.rangeEnd,
        invoiceRangeIsActive: invoiceRanges.isActive,
    })
    .from(transactionCategories)
    .leftJoin(
        invoiceRanges,
        eq(transactionCategories.invoiceRangeId, invoiceRanges.id),
    )
    .where(
        and(
            eq(transactionCategories.status, true),
            eq(transactionCategories.type, "outcome"),
        ),
    )
    .orderBy(asc(transactionCategories.sortOrder));

// Change quickCashboxes query to select isQuick field, or just drop it entirely
const activeCashboxes = await db
    .select()
    .from(cashboxes)
    .where(eq(cashboxes.status, "activo"));

const genBalance = Number(activeCashboxes.find((box) => box.code === "GEN")?.balance ?? 0);

const recentWithdrawals = await db
    .select({
        id: transactions.id,
        concept: transactions.concept,
        amount: transactions.amount,
        authorizedBy: transactions.authorizedBy,
        externalReference: transactions.externalReference,
        invoiceNumber: transactions.invoiceNumber,
        createdAt: transactions.createdAt,
        cashboxName: cashboxes.name,
    })
    .from(transactions)
    .innerJoin(cashboxes, eq(transactions.cashboxId, cashboxes.id))
    .where(eq(transactions.type, "withdraw"))
    .orderBy(desc(transactions.createdAt))
    .limit(10);

const todaysSummary = await db
    .select({
        totalWithdrawals: sql<string>`
      COALESCE(ROUND(SUM(${transactions.amount}), 2)::numeric, 0)::text
    `,
        withdrawalCount: sql<number>`COUNT(*)`,
    })
    .from(transactions)
    .where(
        and(
            eq(transactions.type, "withdraw"),
            sql`DATE(${transactions.createdAt}) = CURRENT_DATE`,
        ),
    );

const summary = todaysSummary[0] || {
    totalWithdrawals: "0.00",
    withdrawalCount: 0,
};

const activeEmployees = await db
    .select({
        id:          employees.id,
        fullName:    employees.fullName,
        chargeTitle: employees.chargeTitle,
    })
    .from(employees)
    .where(and(eq(employees.status, "activo"), isNull(employees.deletedAt)))
    .orderBy(asc(employees.fullName));

---

<FinanceLayout title="Registro de Egresos" user={user}>
    <div class="min-h-screen bg-linear-to-br from-slate-50 to-slate-100">
        <div class="grid gap-8 lg:grid-cols-3">
            {/* Main Form Section */}
            <div class="lg:col-span-2 space-y-6">
                {/* Form Card */}
                <div
                    class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm"
                >
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-3">
                            <div class="rounded-lg bg-red-100 p-3">
                                <ArrowUp class="size-4 text-red-600" />
                            </div>
                            <div>
                                <h1 class="text-lg font-bold text-slate-900">
                                    Egresos
                                </h1>
                                <p class="text-sm text-slate-600">
                                    Registra egresos atribuidos por Caja
                                </p>
                            </div>
                        </div>
                    </div>
                    <WithdrawOverdraftForm
                        concepts={activeWithdrawalTransactionCategories as any}
                        cashboxes={activeCashboxes}
                        employees={activeEmployees}
                        genBalance={genBalance}
                        client:load
                    />
                </div>

                {/* Recent Withdrawals */}
                <div
                    class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm"
                    data-testid="recent-withdrawals-list"
                >
                    <div class="flex justify-between">
                        <h3 class="mb-4 text-lg font-semibold text-slate-900">
                            Egresos Recientes
                        </h3>
                        <span class="text-sm text-slate-500">
                            Mostrando ultimos {recentWithdrawals.length} egresos
                        </span>
                    </div>
                    {
                        recentWithdrawals.length === 0 ? (
                            <p class="text-slate-500 text-center py-8">
                                No hay egresos registrados
                            </p>
                        ) : (
                            <div class="space-y-3">
                                {recentWithdrawals.map((tx) => (
                                    <div
                                        class="flex items-center gap-3 rounded-lg bg-slate-50 p-4 border border-slate-200 hover:border-slate-300 hover:bg-slate-100/50 transition"
                                        data-testid="recent-withdrawal-item"
                                    >
                                        <div class="shrink-0">
                                            <div class="rounded-lg bg-red-100 p-2.5">
                                                <TrendingDown class="h-5 w-5 text-red-600" />
                                            </div>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-baseline justify-between gap-2 mb-1">
                                                <p class="font-medium text-slate-900 truncate">
                                                    {tx.concept}
                                                </p>
                                                <p class="font-semibold text-red-600 shrink-0">
                                                    -{bob(tx.amount)}
                                                </p>
                                            </div>
                                            <div class="flex items-center gap-2 text-xs text-slate-600 truncate">
                                                <span>Caja: {tx.cashboxName}</span>
                                                {tx.invoiceNumber && (
                                                    <>
                                                        <span>•</span>
                                                        <span class="truncate">
                                                            #{tx.invoiceNumber}
                                                        </span>
                                                    </>
                                                )}
                                                {tx.externalReference && !tx.invoiceNumber && (
                                                    <>
                                                        <span>•</span>
                                                        <span class="truncate">
                                                            {tx.externalReference}
                                                        </span>
                                                    </>
                                                )}
                                                <span class="ml-auto text-slate-500 shrink-0">
                                                    {date(tx.createdAt)}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        )
                    }
                </div>
            </div>

            {/* Sidebar */}
            <div class="space-y-6">
                {/* Today's Summary */}
                <div
                    class="rounded-lg border border-red-200 bg-linear-to-br from-red-50 to-red-100 p-6 shadow-sm"
                >
                    <h3 class="font-semibold text-red-900 mb-4">
                        Resumen del Día
                    </h3>
                    <div class="space-y-4">
                        <div>
                            <p class="text-sm text-red-700">Total Egresos</p>
                            <p
                                class="text-3xl font-bold text-red-600"
                                data-testid="withdraw-total-withdrawals"
                            >
                                -{bob(summary.totalWithdrawals)}
                            </p>
                        </div>
                        <div class="border-t border-red-200 pt-4">
                            <p class="text-sm text-red-700">Transacciones</p>
                            <p
                                class="text-2xl font-semibold text-red-900"
                                data-testid="withdraw-count"
                            >
                                {summary.withdrawalCount}
                            </p>
                        </div>
                    </div>
                </div>

                {/* Warning Box */}
                <div
                    class="rounded-lg border border-yellow-200 bg-yellow-50 p-6"
                >
                    <div class="flex gap-2 mb-3">
                        <TriangleAlert
                            class="h-5 w-5 text-yellow-600 shrink-0"
                        />
                        <h4 class="font-semibold text-yellow-900">
                            Importante
                        </h4>
                    </div>
                    <ul class="space-y-2 text-sm text-yellow-700">
                        <li>• Verifica el saldo disponible en GEN antes de retirar</li>
                        <li>• Todo egreso requiere autorización</li>
                        <li>• Documenta la cuentas correctamente</li>
                        <li>• Mantén referencias de comprobantes</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</FinanceLayout>
