---
/**
 * /inquilinos
 * Lista de inquilinos con estado de pago mensual
 */
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { actions } from "astro:actions";
import { db } from "@/db";
import { tenants, tenantPayments } from "@/db/schema";
import { eq, and, sql } from "drizzle-orm";
import { Building, CheckCircle, AlertCircle, Clock } from "@lucide/astro";
import CreateTenantDialog from "@/components/svelte/tenants/CreateTenantDialog.svelte";
import DeleteConfirmDialog from "@/components/svelte/dialogs/DeleteConfirmDialog.svelte";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");

// Current period
const now = new Date();
const currentPeriod = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;

// Load all tenants with their current period payment status
const allTenants = await db
    .select({
        id: tenants.id,
        uuid: tenants.uuid,
        fullName: tenants.fullName,
        phone: tenants.phone,
        monthlyRent: tenants.monthlyRent,
        status: tenants.status,
        startDate: tenants.startDate,
    })
    .from(tenants)
    .orderBy(tenants.fullName);

// Load current period payments for all tenants
const currentPayments = await db
    .select({
        tenantId: tenantPayments.tenantId,
        status: tenantPayments.status,
        amount: tenantPayments.amount,
    })
    .from(tenantPayments)
    .where(eq(tenantPayments.period, currentPeriod));

// Overdue: pending payments from ANY past period
const overduePayments = await db
    .select({
        tenantId: tenantPayments.tenantId,
        period: tenantPayments.period,
    })
    .from(tenantPayments)
    .where(
        and(
            eq(tenantPayments.status, "pendiente"),
            sql`${tenantPayments.period} < ${currentPeriod}`,
        ),
    );

const overdueCount = overduePayments.length;
const overdueTenantsSet = new Set(overduePayments.map((p) => p.tenantId));

const paymentByTenant = Object.fromEntries(
    currentPayments.map((p) => [p.tenantId, p]),
);

const totalRent = allTenants
    .filter((t) => t.status === "activo")
    .reduce((s, t) => s + Number(t.monthlyRent), 0);

const activeTenants = allTenants.filter((t) => t.status === "activo");
const activeTenantIds = new Set(activeTenants.map((t) => t.id));

const paidCount = currentPayments.filter(
    (p) => p.status === "pagado" && activeTenantIds.has(p.tenantId),
).length;
const pendingCount = Math.max(0, activeTenantIds.size - paidCount);
const allPaid = activeTenantIds.size > 0 && pendingCount === 0;

const STATUS_LABELS: Record<string, string> = {
    activo: "Activo",
    inactivo: "Inactivo",
    moroso: "Moroso",
};
const STATUS_COLORS: Record<string, string> = {
    activo: "bg-emerald-100 text-emerald-700",
    inactivo: "bg-slate-100 text-slate-500",
    moroso: "bg-red-100 text-red-700",
};
const PAYMENT_COLORS: Record<string, string> = {
    pagado: "bg-emerald-100 text-emerald-700",
    pendiente: "bg-amber-100 text-amber-700",
    parcial: "bg-blue-100 text-blue-700",
    anulado: "bg-slate-100 text-slate-400",
};
const PAYMENT_LABELS: Record<string, string> = {
    pagado: "Pagado",
    pendiente: "Pendiente",
    parcial: "Parcial",
    anulado: "Anulado",
};

const monthName = now.toLocaleDateString("es-BO", {
    month: "long",
    year: "numeric",
});
---

<FinanceLayout title="Inquilinos" user={user}>
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Inquilinos</h1>
            <p class="text-sm text-slate-500 mt-0.5 capitalize">
                Control de alquiler — {monthName}
            </p>
        </div>
        <CreateTenantDialog client:load />
    </div>

    <!-- OVERDUE BANNER — pending payments from past periods -->
    {
        overdueCount > 0 && (
            <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 flex items-center justify-between gap-4">
                <div class="flex items-center gap-2.5 text-sm text-red-800 min-w-0">
                    <Clock class="size-4 shrink-0 text-red-500" />
                    <span>
                        <strong>
                            {overdueCount}{" "}
                            {overdueCount === 1
                                ? "pago atrasado"
                                : "pagos atrasados"}
                        </strong>{" "}
                        de meses anteriores sin registrar.
                    </span>
                </div>
                <a
                    href="/inquilinos?filter=atrasados"
                    class="shrink-0 rounded-md bg-red-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-red-700 transition-colors"
                >
                    Revisar
                </a>
            </div>
        )
    }

    <!-- PERIOD STATUS ALERT -->
    {
        activeTenantIds.size > 0 && pendingCount > 0 && (
            <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 flex items-center justify-between gap-4">
                <div class="flex items-center gap-2.5 text-sm text-amber-800 min-w-0">
                    <AlertCircle class="size-4 shrink-0 text-amber-500" />
                    <span>
                        <strong>
                            {pendingCount}{" "}
                            {pendingCount === 1
                                ? "inquilino pendiente"
                                : "inquilinos pendientes"}
                        </strong>{" "}
                        de pagar en <span class="capitalize">{monthName}</span>.
                    </span>
                </div>
            </div>
        )
    }

    {
        allPaid && (
            <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 flex items-center gap-2.5 text-sm text-emerald-800">
                <CheckCircle class="size-4 shrink-0 text-emerald-500" />
                <span>
                    Todos los inquilinos activos pagaron en{" "}
                    <span class="capitalize">{monthName}</span>. ✓
                </span>
            </div>
        )
    }

    <!-- KPIs -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs text-slate-500 uppercase tracking-wide mb-2">
                Total Inquilinos
            </p>
            <p class="text-3xl font-bold text-slate-900 tabular-nums">
                {activeTenants.length}
            </p>
        </div>
        <div class="rounded-xl border-2 border-emerald-200 bg-emerald-50 p-5">
            <div class="flex items-center justify-between mb-2">
                <p class="text-xs text-emerald-600 uppercase tracking-wide">
                    Pagaron
                </p>
                <CheckCircle class="h-4 w-4 text-emerald-500" />
            </div>
            <p class="text-3xl font-bold text-emerald-900 tabular-nums">
                {paidCount}
            </p>
        </div>
        <div class="rounded-xl border-2 border-amber-200 bg-amber-50 p-5">
            <div class="flex items-center justify-between mb-2">
                <p class="text-xs text-amber-600 uppercase tracking-wide">
                    Pendientes
                </p>
                <AlertCircle class="h-4 w-4 text-amber-500" />
            </div>
            <p class="text-3xl font-bold text-amber-900 tabular-nums">
                {pendingCount}
            </p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs text-slate-500 uppercase tracking-wide mb-2">
                Ingreso Mensual
            </p>
            <p class="text-xl font-bold text-slate-900 tabular-nums">
                Bs {
                    totalRent.toLocaleString("es-BO", {
                        minimumFractionDigits: 2,
                    })
                }
            </p>
        </div>
    </div>

    <!-- Table -->
    <div
        class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden"
    >
        <div
            class="flex items-center justify-between px-6 py-4 border-b border-slate-100"
        >
            <div class="flex items-center gap-2">
                <Building class="h-5 w-5 text-slate-400" />
                <h2 class="font-semibold text-slate-900">
                    Lista de Inquilinos
                </h2>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead
                    class="bg-slate-50 text-xs text-slate-500 border-b border-slate-100"
                >
                    <tr>
                        <th class="py-3 px-4 text-left font-medium"
                            >Inquilino</th
                        >
                        <th class="py-3 px-4 text-left font-medium">Teléfono</th
                        >
                        <th class="py-3 px-4 text-right font-medium"
                            >Alquiler/Mes</th
                        >
                        <th class="py-3 px-4 text-center font-medium capitalize"
                            >{monthName}</th
                        >
                        <th class="py-3 px-4 text-center font-medium">Estado</th
                        >
                        {
(
                                <th class="py-3 px-4 text-right font-medium">
                                    Acciones
                                </th>
                            )
                        }
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    {
                        allTenants.length === 0 ? (
                            <tr>
                                <td
                                    colspan="7"
                                    class="py-12 text-center text-slate-400 text-sm"
                                >
                                    No hay inquilinos registrados todavía.
                                </td>
                            </tr>
                        ) : (
                            allTenants.map((tenant) => {
                                const payment = paymentByTenant[tenant.id];
                                const payStatus =
                                    payment?.status ?? "pendiente";
                                const isPaid = payStatus === "pagado";
                                const isOverdue = overdueTenantsSet.has(
                                    tenant.id,
                                );
                                return (
                                    <tr
                                        class:list={[
                                            "hover:bg-slate-50/60 transition-colors",
                                            isOverdue && !isPaid
                                                ? "bg-red-50/30"
                                                : "",
                                        ]}
                                    >
                                    <td class="py-3.5 px-4">
                                        <a href={`/inquilinos/${tenant.id}`} class="group">
                                            <p class="font-medium text-slate-900 group-hover:text-blue-600 group-hover:underline transition-colors">
                                                {tenant.fullName}
                                            </p>
                                            {isOverdue && (
                                                <p class="text-[10px] text-red-500 font-medium mt-0.5">
                                                    Tiene pagos atrasados
                                                </p>
                                            )}
                                        </a>
                                    </td>
                                        <td class="py-3.5 px-4 text-sm text-slate-500">
                                            {tenant.phone ?? "—"}
                                        </td>
                                        <td class="py-3.5 px-4 text-right font-mono font-semibold text-slate-700">
                                            Bs{" "}
                                            {Number(
                                                tenant.monthlyRent,
                                            ).toLocaleString("es-BO", {
                                                minimumFractionDigits: 2,
                                            })}
                                        </td>
                                        <td class="py-3.5 px-4 text-center">
                                            <span
                                                class:list={[
                                                    "rounded-full px-2.5 py-0.5 text-xs font-semibold",
                                                    PAYMENT_COLORS[payStatus] ??
                                                        "bg-slate-100 text-slate-500",
                                                ]}
                                            >
                                                {PAYMENT_LABELS[payStatus] ??
                                                    payStatus}
                                            </span>
                                        </td>
                                        <td class="py-3.5 px-4 text-center">
                                            <span
                                                class:list={[
                                                    "rounded-full px-2 py-0.5 text-xs font-medium",
                                                    STATUS_COLORS[
                                                        tenant.status
                                                    ] ??
                                                        "bg-slate-100 text-slate-500",
                                                ]}
                                            >
                                                {STATUS_LABELS[tenant.status] ??
                                                    tenant.status}
                                            </span>
                                        </td>
                                            <td class="py-3.5 px-4 text-right">
                                                <div class="flex items-center justify-end gap-2">
                                                    {!isPaid && tenant.status === "activo" && (
                                                        <form
                                                            method="POST"
                                                            action={actions.inquilinos.registerRentPayment}
                                                            class="inline"
                                                        >
                                                            <input type="hidden" name="tenantId" value={tenant.id} />
                                                            <input type="hidden" name="period" value={currentPeriod} />
                                                            <input type="hidden" name="tenantName" value={tenant.fullName} />
                                                            <input type="hidden" name="amount" value={tenant.monthlyRent} />
                                                            <button
                                                                type="submit"
                                                                onclick={`return confirm('Registrar pago de Bs ${Number(tenant.monthlyRent).toLocaleString("es-BO")} para ${tenant.fullName}?')`}
                                                                class="rounded border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700 hover:bg-emerald-100 transition-colors"
                                                            >
                                                                Pagar
                                                            </button>
                                                        </form>
                                                    )}

                                                    {tenant.status !== "activo" && (
                                                        <form method="POST" action={actions.inquilinos.updateTenantStatus} class="inline">
                                                            <input type="hidden" name="id" value={tenant.id} />
                                                            <input type="hidden" name="status" value="activo" />
                                                            <button
                                                                type="submit"
                                                                onclick={`return confirm('¿Reactivar a ${tenant.fullName}?')`}
                                                                class="rounded border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-medium text-blue-700 hover:bg-blue-100 transition-colors"
                                                            >
                                                                Reactivar
                                                            </button>
                                                        </form>
                                                    )}

                                                    {tenant.status === "activo" && (
                                                        <form method="POST" action={actions.inquilinos.updateTenantStatus} class="inline">
                                                            <input type="hidden" name="id" value={tenant.id} />
                                                            <input type="hidden" name="status" value="moroso" />
                                                            <button
                                                                type="submit"
                                                                onclick={`return confirm('¿Marcar a ${tenant.fullName} como moroso?')`}
                                                                class="rounded border border-red-200 bg-red-50 px-3 py-1 text-xs font-medium text-red-700 hover:bg-red-100 transition-colors"
                                                            >
                                                                Moroso
                                                            </button>
                                                        </form>
                                                    )}

                                                    {tenant.status === "activo" && (
                                                        <DeleteConfirmDialog
                                                            client:load
                                                            entityType="tenant"
                                                            entityId={tenant.id}
                                                            entityName={tenant.fullName}
                                                            entityLabel={`Amb. ${tenant.roomNumber}`}
                                                        />
                                                    )}
                                                </div>
                                            </td>
                                    </tr>
                                );
                            })
                        )
                    }
                </tbody>
            </table>
        </div>
    </div>
</FinanceLayout>
