---
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { db } from "@/db";
import { cashboxes, sectors, employees, transactionCategories } from "@/db/schema";
import { eq, asc, count, sum, and } from "drizzle-orm";
import { actions } from "astro:actions";
import { Wallet, Building2, Users } from "@lucide/astro";
import CreateCashboxDialog from "@/components/svelte/dialogs/CreateCashboxDialog.svelte";
import CashboxDepositDialog from "@/components/svelte/dialogs/CashboxDepositDialog.svelte";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");
if (!["ADMIN", "ADMON"].includes(user.role ?? "")) return Astro.redirect("/");

const [allCashboxes, sectorStats, employeeStats, incomeCategories] = await Promise.all([
  db.select({
      id: cashboxes.id,
      name: cashboxes.name,
      code: cashboxes.code,
      balance: cashboxes.balance,
      status: cashboxes.status,
      description: cashboxes.description,
      isQuick: cashboxes.isQuick,   // ← add
  })
    .from(cashboxes)
    .where(eq(cashboxes.status, "activo"))
    .orderBy(asc(cashboxes.name)),

  db
    .select({
      cashboxId: sectors.cashboxId,
      sectorCount: count(sectors.id),
    })
    .from(sectors)
    .where(eq(sectors.isActive, true))
    .groupBy(sectors.cashboxId),

  db
    .select({
      cashboxId: sectors.cashboxId,
      employeeCount: count(employees.id),
      totalSalary: sum(employees.baseSalary),
    })
    .from(sectors)
    .innerJoin(employees, eq(employees.sectorId, sectors.id))
    .where(eq(sectors.isActive, true))
    .groupBy(sectors.cashboxId),

  db
    .select({
      id: transactionCategories.id,
      name: transactionCategories.name,
      code: transactionCategories.code,
    })
    .from(transactionCategories)
    .where(
      and(
        eq(transactionCategories.type, "income"),
        eq(transactionCategories.status, true),
      )
    )
    .orderBy(asc(transactionCategories.sortOrder)),
]);

const sectorMap = new Map(sectorStats.map((s) => [s.cashboxId, s.sectorCount]));
const employeeMap = new Map(
  employeeStats.map((e) => [
    e.cashboxId,
    { count: e.employeeCount, salary: Number(e.totalSalary ?? 0) },
  ]),
);
---

<FinanceLayout title="Cajas" user={user}>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-xl font-bold text-slate-900">Cajas</h1>
      <p class="text-sm text-slate-500 mt-0.5">Cada caja agrupa sectores y centraliza su presupuesto.</p>
    </div>
    <CreateCashboxDialog client:load />
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    {allCashboxes.map((box) => {
      const balance = Number(box.balance ?? 0);
      const emp = employeeMap.get(box.id);
      const sectorCount = sectorMap.get(box.id) ?? 0;
      const canCover = emp ? balance >= emp.salary : true;

      return (
      <div class="rounded-xl border border-slate-200 bg-white overflow-hidden hover:border-slate-300 transition-colors">

        <!-- Row 1: identity + deposit -->
        <div class="flex items-center justify-between gap-2 px-4 py-3">
          <div class="flex items-center gap-2 min-w-0">
            <form method="POST" action={actions.finance.toggleQuickCashbox}>
              <input type="hidden" name="cashboxId" value={box.id} />
              <input type="hidden" name="isQuick" value={String(!box.isQuick)} />
              <button type="submit" class:list={[
                "inline-flex items-center gap-1 rounded-md border px-1.5 py-1 text-[11px] font-medium transition-colors",
                box.isQuick
                  ? "border-amber-200 bg-amber-50 text-amber-700"
                  : "border-transparent text-slate-300 hover:text-slate-400",
              ]}>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24"
                  fill={box.isQuick ? "currentColor" : "none"} stroke="currentColor" stroke-width="2">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
                {box.isQuick && "Rápido"}
              </button>
            </form>
            <a href={`/cajas/${box.id}`} class="flex items-center gap-2 group min-w-0">
              <div class="flex items-center justify-center w-7 h-7 rounded-md bg-slate-100 shrink-0">
                <Wallet class="h-3.5 w-3.5 text-slate-400" />
              </div>
              <div class="min-w-0">
                <p class="text-sm font-medium text-slate-800 group-hover:text-emerald-700 transition-colors truncate">{box.name}</p>
                <p class="text-[11px] text-slate-400 font-mono">{box.code}</p>
              </div>
            </a>
          </div>
          <CashboxDepositDialog
            cashboxId={box.id} cashboxName={box.name}
            currentBalance={balance} monthlySalary={emp?.salary ?? 0}
            categories={incomeCategories as any}
            triggerLabel="Depositar"
            triggerClass="inline-flex items-center gap-1 rounded-md border border-emerald-200 bg-emerald-50 px-2.5 py-1.5 text-xs font-medium text-emerald-700 hover:bg-emerald-100 transition-colors"
            client:load
          />
        </div>

        <!-- Row 2: balance full width -->
        <div class="px-4 pb-3 border-t border-slate-100">
          <p class="text-[11px] text-slate-400 mt-2.5 mb-0.5">Saldo</p>
          <p class:list={[
            "text-[22px] font-semibold tabular-nums leading-none",
            canCover ? "text-emerald-600" : "text-red-500",
          ]}>
            Bs {balance.toLocaleString("es-BO", { minimumFractionDigits: 2 })}
          </p>
        </div>

        <!-- Row 3: stats strip -->
        <a href={`/cajas/${box.id}`} class="grid grid-cols-3 border-t border-slate-100">
          <div class="py-2.5 text-center">
            <p class="text-[11px] text-slate-400">Sectores</p>
            <p class="text-sm font-medium text-slate-700">{sectorCount}</p>
          </div>
          <div class="py-2.5 text-center border-x border-slate-100">
            <p class="text-[11px] text-slate-400">Personal</p>
            <p class="text-sm font-medium text-slate-700">{emp?.count ?? 0}</p>
          </div>
          <div class:list={["py-2.5 text-center", canCover ? "" : "bg-red-50"]}>
            <p class="text-[11px] text-slate-400">Masa salarial</p>
            <p class:list={["text-sm font-medium tabular-nums", canCover ? "text-slate-700" : "text-red-500"]}>
              Bs {(emp?.salary ?? 0).toLocaleString("es-BO", { minimumFractionDigits: 0 })}
            </p>
          </div>
        </a>

      </div>
      );
    })}
  </div>
</FinanceLayout>
