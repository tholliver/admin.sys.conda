---
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { db } from "@/db";
import { cashboxes, sectors, employees, transactionCategories } from "@/db/schema";
import { eq, asc, count, sum, and } from "drizzle-orm";
import { actions } from "astro:actions";
import { Wallet } from "@lucide/astro";
import CreateCashboxDialog from "@/components/svelte/dialogs/CreateCashboxDialog.svelte";
import CashboxDepositDialog from "@/components/svelte/dialogs/CashboxDepositDialog.svelte";
import CashboxManager from "@/components/svelte/CashboxManager.svelte";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");
if (!["ADMIN", "ADMON"].includes(user.role ?? "")) return Astro.redirect("/");

const [allCashboxes, sectorStats, employeeStats, incomeCategories] = await Promise.all([
  db.select({
      id: cashboxes.id,
      name: cashboxes.name,
      code: cashboxes.code,
      balance: cashboxes.balance,
      status: cashboxes.status,
      description: cashboxes.description,
      isQuick: cashboxes.isQuick,
  })
    .from(cashboxes)
    .where(eq(cashboxes.status, "activo"))
    .orderBy(asc(cashboxes.name)),

  db
    .select({
      cashboxId: sectors.cashboxId,
      sectorCount: count(sectors.id),
    })
    .from(sectors)
    .where(eq(sectors.isActive, true))
    .groupBy(sectors.cashboxId),

  db
    .select({
      cashboxId: sectors.cashboxId,
      employeeCount: count(employees.id),
      totalSalary: sum(employees.baseSalary),
    })
    .from(sectors)
    .innerJoin(employees, eq(employees.sectorId, sectors.id))
    .where(eq(sectors.isActive, true))
    .groupBy(sectors.cashboxId),

  db
    .select({
      id: transactionCategories.id,
      name: transactionCategories.name,
      code: transactionCategories.code,
    })
    .from(transactionCategories)
    .where(
      and(
        eq(transactionCategories.type, "income"),
        eq(transactionCategories.status, true),
      )
    )
    .orderBy(asc(transactionCategories.sortOrder)),
]);

const sectorMap = new Map(sectorStats.map((s) => [s.cashboxId, s.sectorCount]));
const employeeMap = new Map(
  employeeStats.map((e) => [
    e.cashboxId,
    { count: e.employeeCount, salary: Number(e.totalSalary ?? 0) },
  ]),
);

// allCashboxes shaped for ManageSectorsDialog: { id, name }
const cashboxOptions = allCashboxes.map((c) => ({ id: c.id, name: c.name }));
---

<FinanceLayout title="Cajas" user={user}>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-xl font-bold text-slate-900">Cajas</h1>
      <p class="text-sm text-slate-500 mt-0.5">Cada caja agrupa sectores y centraliza su presupuesto.</p>
    </div>
    <CreateCashboxDialog client:load />
  </div>

  <div class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-slate-100 bg-slate-50">
          <th class="text-left px-5 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Caja</th>
          <th class="text-right px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Saldo</th>
          <th class="text-center px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Sectores</th>
          <th class="text-center px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Personal</th>
          <th class="text-right px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Planilla</th>
          <th class="text-center px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Cobertura</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {allCashboxes.map((box) => {
          const balance = Number(box.balance ?? 0);
          const emp = employeeMap.get(box.id);
          const sectorCount = sectorMap.get(box.id) ?? 0;
          const canCover = emp ? balance >= emp.salary : true;
          const salary = emp?.salary ?? 0;
          const coveragePct = salary > 0 ? Math.min((balance / salary) * 100, 999) : 100;

          return (
            <tr class="hover:bg-slate-50/70 transition-colors group">

              {/* Cashbox name + code */}
              <td class="px-5 py-3.5">
                <a href={`/cajas/${box.id}`} class="flex items-center gap-2.5 group/link">
                  <div class:list={["shrink-0 w-1.5 h-8 rounded-full", canCover ? "bg-emerald-400" : "bg-red-400"]} />
                  <div class="shrink-0 w-7 h-7 rounded bg-slate-100 group-hover/link:bg-blue-50 transition-colors flex items-center justify-center">
                    <Wallet class="w-3.5 h-3.5 text-slate-500 group-hover/link:text-blue-600 transition-colors" />
                  </div>
                  <div>
                    <p class="font-semibold text-slate-800 group-hover/link:text-blue-600 transition-colors leading-tight">{box.name}</p>
                    <p class="text-[11px] text-slate-400 font-mono">{box.code}</p>
                  </div>
                </a>
              </td>

              {/* Balance */}
              <td class="px-4 py-3.5 text-right tabular-nums">
                <span class:list={["font-bold", canCover ? "text-slate-800" : "text-red-600"]}>
                  Bs {balance >= 1000 ? `${(balance / 1000).toFixed(1)}K` : balance.toLocaleString("es-BO", { minimumFractionDigits: 2 })}
                </span>
              </td>

              {/* Sectors */}
              <td class="px-4 py-3.5 text-center">
                <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-slate-100 text-slate-700 text-xs font-bold">{sectorCount}</span>
              </td>

              {/* Staff */}
              <td class="px-4 py-3.5 text-center">
                <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-slate-100 text-slate-700 text-xs font-bold">{emp?.count ?? 0}</span>
              </td>

              {/* Monthly salary */}
              <td class="px-4 py-3.5 text-right tabular-nums text-slate-600">
                {salary > 0
                  ? `Bs ${salary >= 1000 ? `${(salary / 1000).toFixed(1)}K` : salary.toLocaleString("es-BO", { minimumFractionDigits: 2 })}`
                  : <span class="text-slate-300">—</span>
                }
              </td>

              {/* Coverage bar */}
              <td class="px-4 py-3.5">
                <div class="flex items-center gap-2 justify-center">
                  <div class="w-20 h-1.5 rounded-full bg-slate-100 overflow-hidden">
                    <div
                      class:list={["h-full rounded-full transition-all", canCover ? "bg-emerald-400" : "bg-red-400"]}
                      style={`width: ${Math.min(coveragePct, 100)}%`}
                    />
                  </div>
                  <span class:list={["text-[11px] font-semibold tabular-nums w-9 text-right", canCover ? "text-emerald-600" : "text-red-500"]}>
                    {salary > 0 ? `${Math.round(coveragePct)}%` : "—"}
                  </span>
                </div>
              </td>

              {/* Actions */}
              <td class="px-4 py-3.5">
                <div class="flex items-center gap-1 justify-end">
                  <form method="POST" action={actions.finance.toggleQuickCashbox}>
                    <input type="hidden" name="cashboxId" value={box.id} />
                    <input type="hidden" name="isQuick" value={String(!box.isQuick)} />
                    <button title={box.isQuick ? "Desactivar rápido" : "Activar rápido"} type="submit"
                      class:list={[
                        "inline-flex items-center rounded border px-1.5 py-1 text-[11px] font-medium transition-colors",
                        box.isQuick
                          ? "border-amber-200 bg-amber-50 text-amber-700"
                          : "border-transparent text-slate-300 hover:text-slate-400",
                      ]}>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24"
                        fill={box.isQuick ? "currentColor" : "none"} stroke="currentColor" stroke-width="2">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                      </svg>
                    </button>
                  </form>
                  <CashboxDepositDialog
                    cashboxId={box.id} cashboxName={box.name}
                    currentBalance={balance} monthlySalary={emp?.salary ?? 0}
                    categories={incomeCategories as any}
                    triggerLabel="Depositar"
                    triggerClass="px-2 py-1 text-xs font-medium text-slate-700 hover:bg-slate-100 rounded transition-colors"
                    client:load
                  />
                  <CashboxManager
                    cashboxId={box.id}
                    cashboxName={box.name}
                    allCashboxes={allCashboxes}
                    client:load
                  />
                </div>
              </td>

            </tr>
          );
        })}
      </tbody>
    </table>

    {allCashboxes.length === 0 && (
      <div class="py-16 text-center text-slate-400 text-sm">No hay cajas activas.</div>
    )}
  </div>
</FinanceLayout>
