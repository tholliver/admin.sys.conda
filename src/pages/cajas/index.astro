---
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { db } from "@/db";
import { cashboxes, sectors, employees, transactionCategories } from "@/db/schema";
import { eq, asc, count, sum, and } from "drizzle-orm";
import { Wallet, Building2, Users } from "@lucide/astro";
import CreateCashboxDialog from "@/components/svelte/dialogs/CreateCashboxDialog.svelte";
import CashboxDepositDialog from "@/components/svelte/dialogs/CashboxDepositDialog.svelte";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");
if (!["ADMIN", "ADMON"].includes(user.role ?? "")) return Astro.redirect("/");

const [allCashboxes, sectorStats, employeeStats, incomeCategories] = await Promise.all([
  db
    .select({
      id: cashboxes.id,
      name: cashboxes.name,
      code: cashboxes.code,
      balance: cashboxes.balance,
      status: cashboxes.status,
      description: cashboxes.description,
    })
    .from(cashboxes)
    .where(eq(cashboxes.status, "active"))
    .orderBy(asc(cashboxes.name)),

  db
    .select({
      cashboxId: sectors.cashboxId,
      sectorCount: count(sectors.id),
    })
    .from(sectors)
    .where(eq(sectors.isActive, true))
    .groupBy(sectors.cashboxId),

  db
    .select({
      cashboxId: sectors.cashboxId,
      employeeCount: count(employees.id),
      totalSalary: sum(employees.baseSalary),
    })
    .from(sectors)
    .innerJoin(employees, eq(employees.sectorId, sectors.id))
    .where(eq(sectors.isActive, true))
    .groupBy(sectors.cashboxId),

  db
    .select({
      id: transactionCategories.id,
      name: transactionCategories.name,
      code: transactionCategories.code,
    })
    .from(transactionCategories)
    .where(
      and(
        eq(transactionCategories.type, "income"),
        eq(transactionCategories.status, true),
      )
    )
    .orderBy(asc(transactionCategories.sortOrder)),
]);

const sectorMap = new Map(sectorStats.map((s) => [s.cashboxId, s.sectorCount]));
const employeeMap = new Map(
  employeeStats.map((e) => [
    e.cashboxId,
    { count: e.employeeCount, salary: Number(e.totalSalary ?? 0) },
  ]),
);
---

<FinanceLayout title="Cajas" user={user}>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-xl font-bold text-slate-900">Cajas</h1>
      <p class="text-sm text-slate-500 mt-0.5">Cada caja agrupa sectores y centraliza su presupuesto.</p>
    </div>
    <CreateCashboxDialog client:load />
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    {allCashboxes.map((box) => {
      const balance = Number(box.balance ?? 0);
      const emp = employeeMap.get(box.id);
      const sectorCount = sectorMap.get(box.id) ?? 0;
      const canCover = emp ? balance >= emp.salary : true;

      return (
        <div class="rounded-xl border border-slate-200 bg-white shadow-sm p-5 hover:border-slate-300 hover:shadow-md transition-all">
            <div class="flex items-center justify-between gap-3 mb-4">
              <a href={`/cajas/${box.id}`} class="flex items-center gap-2 group min-w-0">
                <Wallet class="h-4 w-4 text-slate-400 shrink-0" />
                <div class="min-w-0">
                  <p class="font-semibold text-slate-900 group-hover:text-emerald-700 transition-colors truncate">
                    {box.name}
                  </p>
                  <p class="text-xs text-slate-400 font-mono">{box.code}</p>
                </div>
              </a>

              <div class="flex items-center gap-3 shrink-0">
                <div class="text-right">
                  <p class="text-xs text-slate-500">Saldo</p>
                  <p class:list={[
                    "text-xl font-bold tabular-nums leading-tight",
                    canCover ? "text-emerald-600" : "text-red-600",
                  ]}>
                    Bs {balance.toLocaleString("es-BO", { minimumFractionDigits: 2 })}
                  </p>
                </div>

                <div class="w-px h-8 bg-slate-200" />

                <CashboxDepositDialog
                  cashboxId={box.id}
                  cashboxName={box.name}
                  currentBalance={balance}
                  monthlySalary={emp?.salary ?? 0}
                  categories={incomeCategories as any}
                  triggerLabel="Depositar"
                  triggerClass="inline-flex items-center gap-1 rounded-lg border border-emerald-200 bg-emerald-50 px-2.5 py-1.5 text-xs font-medium text-emerald-700 hover:bg-emerald-100 transition-colors"
                  client:load
                />
              </div>
            </div>

          <!-- Stats -->
          <a href={`/cajas/${box.id}`} class="grid grid-cols-3 gap-2 text-center text-xs">
            <div class="rounded-lg bg-slate-50 p-2">
              <p class="text-slate-500">Sectores</p>
              <p class="font-bold text-slate-800 text-base">{sectorCount}</p>
            </div>
            <div class="rounded-lg bg-slate-50 p-2">
              <p class="text-slate-500">Personal</p>
              <p class="font-bold text-slate-800 text-base">{emp?.count ?? 0}</p>
            </div>
            <div class:list={["rounded-lg p-2", canCover ? "bg-slate-50" : "bg-red-50"]}>
              <p class="text-slate-500">Masa Salarial</p>
              <p class:list={["font-bold tabular-nums", canCover ? "text-slate-800" : "text-red-600"]}>
                Bs {(emp?.salary ?? 0).toLocaleString("es-BO", { minimumFractionDigits: 0 })}
              </p>
            </div>
          </a>
        </div>
      );
    })}
  </div>
</FinanceLayout>
