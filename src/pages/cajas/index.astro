---
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { db } from "@/db";
import { cashboxes, sectors, employees } from "@/db/schema";
import { eq, asc, count, sum } from "drizzle-orm";
import { Wallet, Building2, Users, PlusCircle } from "@lucide/astro";
import CreateCashboxDialog from "@/components/svelte/dialogs/CreateCashboxDialog.svelte";
import CreateSectorDialog from "@/components/svelte/dialogs/CreateSectorDialog.svelte";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");
if (!["ADMIN", "ADMON"].includes(user.role ?? "")) return Astro.redirect("/");

// All active cashboxes with their sector count and employee count
const allCashboxes = await db
    .select({
        id: cashboxes.id,
        name: cashboxes.name,
        code: cashboxes.code,
        balance: cashboxes.balance,
        status: cashboxes.status,
        description: cashboxes.description,
    })
    .from(cashboxes)
    .where(eq(cashboxes.status, "active"))
    .orderBy(asc(cashboxes.name));

// For each cashbox: count sectors and employees
const sectorStats = await db
    .select({
        cashboxId: sectors.cashboxId,
        sectorCount: count(sectors.id),
    })
    .from(sectors)
    .where(eq(sectors.isActive, true))
    .groupBy(sectors.cashboxId);

const employeeStats = await db
    .select({
        cashboxId: sectors.cashboxId,
        employeeCount: count(employees.id),
        totalSalary: sum(employees.baseSalary),
    })
    .from(sectors)
    .innerJoin(employees, eq(employees.sectorId, sectors.id))
    .where(eq(sectors.isActive, true))
    .groupBy(sectors.cashboxId);

const sectorMap = new Map(sectorStats.map((s) => [s.cashboxId, s.sectorCount]));
const employeeMap = new Map(
    employeeStats.map((e) => [
        e.cashboxId,
        { count: e.employeeCount, salary: Number(e.totalSalary ?? 0) },
    ]),
);
---

<FinanceLayout title="Cajas" user={user}>
    <main class="mx-auto max-w-5xl px-4 py-2 sm:px-6 lg:px-8 space-y-6">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h1 class="text-xl font-bold text-slate-900">Cajas</h1>
                <p class="text-sm text-slate-500 mt-0.5">
                    Cada caja agrupa sectores. Los sectores tienen empleados.
                </p>
            </div>
            <CreateCashboxDialog client:load />
        </div>

        <div class="grid gap-4 md:grid-cols-2">
            {
                allCashboxes.map((box) => {
                    const balance = Number(box.balance ?? 0);
                    const emp = employeeMap.get(box.id);
                    const sectorCount = sectorMap.get(box.id) ?? 0;
                    const canCover = emp ? balance >= emp.salary : true;

                    return (
                        <a
                            href={`/cajas/${box.id}`}
                            class="block rounded-xl border border-slate-200 bg-white shadow-sm p-5 hover:border-slate-300 hover:shadow-md transition-all group"
                        >
                            <div class="flex items-start justify-between gap-3 mb-4">
                                <div class="flex items-center gap-2">
                                    <Wallet class="h-4 w-4 text-slate-400 shrink-0" />
                                    <div>
                                        <p class="font-semibold text-slate-900 group-hover:text-emerald-700 transition-colors">
                                            {box.name}
                                        </p>
                                        <p class="text-xs text-slate-400 font-mono">
                                            {box.code}
                                        </p>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <p class="text-xs text-slate-500">Saldo</p>
                                    <p
                                        class:list={[
                                            "text-xl font-bold tabular-nums",
                                            canCover
                                                ? "text-emerald-600"
                                                : "text-red-600",
                                        ]}
                                    >
                                        Bs{" "}
                                        {balance.toLocaleString("es-BO", {
                                            minimumFractionDigits: 2,
                                        })}
                                    </p>
                                </div>
                            </div>

                            <div class="grid grid-cols-3 gap-2 text-center text-xs">
                                <div class="rounded-lg bg-slate-50 p-2">
                                    <p class="text-slate-500">Sectores</p>
                                    <p class="font-bold text-slate-800 text-base">
                                        {sectorCount}
                                    </p>
                                </div>
                                <div class="rounded-lg bg-slate-50 p-2">
                                    <p class="text-slate-500">Empleados</p>
                                    <p class="font-bold text-slate-800 text-base">
                                        {emp?.count ?? 0}
                                    </p>
                                </div>
                                <div
                                    class:list={[
                                        "rounded-lg p-2",
                                        canCover ? "bg-slate-50" : "bg-red-50",
                                    ]}
                                >
                                    <p class="text-slate-500">Masa Salarial</p>
                                    <p
                                        class:list={[
                                            "font-bold tabular-nums",
                                            canCover
                                                ? "text-slate-800"
                                                : "text-red-600",
                                        ]}
                                    >
                                        Bs{" "}
                                        {(emp?.salary ?? 0).toLocaleString(
                                            "es-BO",
                                            { minimumFractionDigits: 0 },
                                        )}
                                    </p>
                                </div>
                            </div>
                        </a>
                    );
                })
            }
        </div>
    </main>
</FinanceLayout>
