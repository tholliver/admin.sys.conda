---
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { actions } from "astro:actions";
import { db } from "@/db";
import { cashboxes, employees, transactionCategories, transactions } from "@/db/schema";
import { eq, asc, and, desc, gt, sum as sqlSum } from "drizzle-orm";
import {
  Wallet,
  Building2,
  TriangleAlert,
  ChevronLeft,
  CirclePause,
  CirclePlay,
  Pencil,
  ArrowRightLeft,
  AlertCircle,
} from "@lucide/astro";
import CashboxOperationsDialog from "@/components/svelte/CashboxOperationsDialog.svelte";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");
if (!["ADMIN"].includes(user.role ?? "")) return Astro.redirect("/");

const { id } = Astro.params;

const [cashbox] = await db.select().from(cashboxes).where(eq(cashboxes.id, id!));
if (!cashbox) return Astro.redirect("/cajas");

const [
  cashboxDetails,
  sectorEmployees,
  incomeCategories,
  outcomeCategories,
  recentTransactions,
  overdraftTransactions,
  overdraftSum,
] = await Promise.all([
  db.select({ id: cashboxes.id, name: cashboxes.name, description: cashboxes.description })
    .from(cashboxes)
    .where(eq(cashboxes.id, id!))
    .orderBy(asc(cashboxes.name)),

  db.select({
      cashboxId: cashboxes.id,
      employeeId: employees.id,
      fullName: employees.fullName,
      chargeTitle: employees.chargeTitle,
      baseSalary: employees.baseSalary,
    })
    .from(employees)
    .innerJoin(cashboxes, eq(cashboxes.id, employees.cashboxId))
    .where(and(eq(employees.status, "activo"), eq(cashboxes.id, id!))),

  db.select({ id: transactionCategories.id, name: transactionCategories.name, code: transactionCategories.code })
    .from(transactionCategories)
    .where(and(eq(transactionCategories.type, "income"), eq(transactionCategories.status, true)))
    .orderBy(asc(transactionCategories.sortOrder)),

  db.select({ id: transactionCategories.id, name: transactionCategories.name, code: transactionCategories.code })
    .from(transactionCategories)
    .where(and(eq(transactionCategories.type, "outcome"), eq(transactionCategories.status, true)))
    .orderBy(asc(transactionCategories.sortOrder)),

  db.select({
      id: transactions.id,
      concept: transactions.concept,
      type: transactions.type,
      amount: transactions.amount,
      balanceAfter: transactions.balanceAfter,
      status: transactions.status,
      overdraftAmount: transactions.overdraftAmount,
      createdAt: transactions.createdAt,
    })
    .from(transactions)
    .where(eq(transactions.cashboxId, id!))
    .orderBy(desc(transactions.createdAt))
    .limit(15),

  db.select({
      id: transactions.id,
      concept: transactions.concept,
      amount: transactions.amount,
      overdraftAmount: transactions.overdraftAmount,
      authorizedBy: transactions.authorizedBy,
      status: transactions.status,
      createdAt: transactions.createdAt,
    })
    .from(transactions)
    .where(and(eq(transactions.cashboxId, id!), gt(transactions.overdraftAmount, "0")))
    .orderBy(desc(transactions.createdAt)),

  db.select({ total: sqlSum(transactions.overdraftAmount) })
    .from(transactions)
    .where(and(eq(transactions.cashboxId, id!), gt(transactions.overdraftAmount, "0"))),
]);

const empBySector = new Map<number, typeof sectorEmployees>();
for (const emp of sectorEmployees) {
  const key = Number(emp.cashboxId);
  if (!empBySector.has(key)) empBySector.set(key, []);
  empBySector.get(key)!.push(emp);
}

const balance = Number(cashbox.balance ?? 0);
const totalSalary = sectorEmployees.reduce((s, e) => s + Number(e.baseSalary ?? 0), 0);
const canCover = balance >= totalSalary;
const activeSectors = cashboxDetails.filter((s) => s.isActive);
const isActive = cashbox.status === "activo";
const totalOverdraft = Number(overdraftSum[0]?.total ?? 0);

const fmtBs = (n: number) => `Bs ${n.toLocaleString("es-BO", { minimumFractionDigits: 2 })}`;
const fmtDate = (d: Date | string) =>
  new Date(d).toLocaleDateString("es-BO", { day: "2-digit", month: "short", year: "numeric" });

const statusClass: Record<string, string> = {
  completado: "bg-emerald-100 text-emerald-700",
  pendiente:  "bg-amber-100 text-amber-700",
  fallido:    "bg-red-100 text-red-700",
  cancelado:  "bg-slate-100 text-slate-500",
};
---

<FinanceLayout title={cashbox.name} user={user}>

  {/* ── Header ── */}
  <div class="flex items-start justify-between gap-4">
    <div>
      <a href="/cajas" class="text-xs text-slate-500 hover:text-slate-700 flex items-center gap-1 mb-1">
        <ChevronLeft class="h-3 w-3" /> Cajas
      </a>
      <div class="flex items-center gap-2 flex-wrap">
        <Wallet class="h-5 w-5 text-slate-400" />
        <h1 class="text-xl font-bold text-slate-900">{cashbox.name}</h1>
        <span class="font-mono text-xs text-slate-400 bg-slate-100 px-2 py-0.5 rounded">{cashbox.code}</span>
        <span class:list={["text-xs font-semibold px-2 py-0.5 rounded-full", isActive ? "bg-emerald-100 text-emerald-700" : "bg-slate-100 text-slate-500"]}>
          {cashbox.status}
        </span>
      </div>
      <p class:list={["text-2xl font-bold tabular-nums mt-1", canCover ? "text-emerald-600" : "text-red-600"]}>
        {fmtBs(balance)}
      </p>
    </div>

    <div class="flex items-center gap-2 shrink-0 flex-wrap justify-end">
      {isActive && (
        <CashboxOperationsDialog
          cashboxId={cashbox.id}
          cashboxName={cashbox.name}
          currentBalance={balance}
          monthlySalary={totalSalary}
          incomeCategories={incomeCategories as any}
          outcomeCategories={outcomeCategories as any}
          client:load
        />
      )}
      <a href={`/cajas/${id}/editar`}
        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 transition-colors">
        <Pencil class="h-3.5 w-3.5" /> Editar
      </a>
      <form method="post" action={actions.finance.toggleCashboxStatus}
        onsubmit={`return confirm(${JSON.stringify(isActive
          ? `¿Desactivar la caja "${cashbox.name}"?`
          : `¿Reactivar la caja "${cashbox.name}"?`)})`}>
        <input type="hidden" name="cashboxId" value={cashbox.id} />
        <input type="hidden" name="status" value={isActive ? "inactivo" : "activo"} />
        <button type="submit" class:list={[
          "inline-flex items-center gap-1.5 rounded-lg border px-3 py-2 text-xs font-medium transition-colors",
          isActive ? "border-amber-200 bg-amber-50 text-amber-700 hover:bg-amber-100"
                   : "border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100",
        ]}>
          {isActive ? <CirclePause class="h-3.5 w-3.5" /> : <CirclePlay class="h-3.5 w-3.5" />}
          {isActive ? "Desactivar" : "Reactivar"}
        </button>
      </form>
    </div>
  </div>

  {/* ── Alerts ── */}
  {!canCover && totalSalary > 0 && (
    <div class="flex items-center gap-2 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <TriangleAlert class="h-4 w-4 shrink-0" />
      Faltan {fmtBs(totalSalary - balance)} para cubrir la masa salarial total.
    </div>
  )}
  {!isActive && (
    <div class="flex items-center gap-2 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700">
      <TriangleAlert class="h-4 w-4 shrink-0" />
      Esta caja está inactiva. No se pueden registrar transacciones ni vincular sectores.
    </div>
  )}

  {/* ── Metric strip ── */}
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-500">Sectores activos</p>
      <p class="text-2xl font-bold text-slate-900 mt-0.5">{activeSectors.length}</p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-500">Personal</p>
      <p class="text-2xl font-bold text-slate-900 mt-0.5">{sectorEmployees.length}</p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-500">Masa salarial</p>
      <p class:list={["text-lg font-bold tabular-nums mt-0.5", canCover ? "text-slate-900" : "text-red-600"]}>
        {fmtBs(totalSalary)}
      </p>
    </div>
    <div class:list={[
      "rounded-xl border p-4 shadow-sm",
      totalOverdraft > 0 ? "border-amber-200 bg-amber-50" : "border-slate-200 bg-white",
    ]}>
      <p class:list={["text-xs", totalOverdraft > 0 ? "text-amber-700" : "text-slate-500"]}>Descubierto acum.</p>
      <p class:list={["text-lg font-bold tabular-nums mt-0.5", totalOverdraft > 0 ? "text-amber-700" : "text-slate-400"]}>
        {totalOverdraft > 0 ? fmtBs(totalOverdraft) : "—"}
      </p>
    </div>
  </div>

  {/* ── Overdraft report ── */}
  {overdraftTransactions.length > 0 && (
    <div class="rounded-xl border border-amber-200 bg-white overflow-hidden shadow-sm">
      <div class="flex items-center justify-between px-5 py-3 bg-amber-50 border-b border-amber-200">
        <div class="flex items-center gap-2">
          <AlertCircle class="h-4 w-4 text-amber-600 shrink-0" />
          <span class="text-sm font-semibold text-amber-800">Movimientos en descubierto</span>
          <span class="text-xs text-amber-600">— egresos que superaron el saldo disponible</span>
        </div>
        <span class="text-xs font-semibold bg-amber-200 text-amber-800 px-2 py-0.5 rounded-full">
          {overdraftTransactions.length} {overdraftTransactions.length === 1 ? "registro" : "registros"}
        </span>
      </div>
      <table class="w-full text-xs">
        <thead>
          <tr class="border-b border-slate-100 bg-slate-50">
            <th class="text-left px-4 py-2.5 font-semibold text-slate-500 uppercase tracking-wide">Fecha</th>
            <th class="text-left px-4 py-2.5 font-semibold text-slate-500 uppercase tracking-wide">Concepto</th>
            <th class="text-right px-4 py-2.5 font-semibold text-slate-500 uppercase tracking-wide">Monto</th>
            <th class="text-right px-4 py-2.5 font-semibold text-amber-600 uppercase tracking-wide">Descubierto</th>
            <th class="text-left px-4 py-2.5 font-semibold text-slate-500 uppercase tracking-wide">Autorizado por</th>
            <th class="text-center px-4 py-2.5 font-semibold text-slate-500 uppercase tracking-wide">Estado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {overdraftTransactions.map((tx) => (
            <tr class="bg-amber-50/40 hover:bg-amber-50 transition-colors">
              <td class="px-4 py-2.5 text-slate-500 whitespace-nowrap">{fmtDate(tx.createdAt)}</td>
              <td class="px-4 py-2.5 text-slate-800 font-medium">{tx.concept}</td>
              <td class="px-4 py-2.5 text-right tabular-nums text-slate-700">{fmtBs(Number(tx.amount))}</td>
              <td class="px-4 py-2.5 text-right tabular-nums font-semibold text-amber-700">
                {fmtBs(Number(tx.overdraftAmount))}
              </td>
              <td class="px-4 py-2.5 text-slate-500">{tx.authorizedBy ?? <span class="text-slate-300">—</span>}</td>
              <td class="px-4 py-2.5 text-center">
                <span class:list={["text-[10px] font-semibold px-2 py-0.5 rounded-full", statusClass[tx.status] ?? "bg-slate-100 text-slate-500"]}>
                  {tx.status}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr class="border-t border-amber-200 bg-amber-50">
            <td colspan="3" class="px-4 py-2.5 text-xs font-semibold text-amber-800 text-right">Total descubierto</td>
            <td class="px-4 py-2.5 text-right tabular-nums font-bold text-amber-800">{fmtBs(totalOverdraft)}</td>
            <td colspan="2" />
          </tr>
        </tfoot>
      </table>
    </div>
  )}

  {/* ── Recent transactions ── */}
  <div class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm">
    <div class="flex items-center justify-between px-5 py-3 border-b border-slate-100">
      <span class="text-sm font-semibold text-slate-800">Últimas transacciones</span>
      <a href={`/cajas/${id}/transacciones`}
        class="text-xs text-blue-600 hover:text-blue-800 font-medium transition-colors">
        Ver todas →
      </a>
    </div>
    {recentTransactions.length === 0 ? (
      <p class="py-10 text-center text-sm text-slate-400">Sin transacciones registradas.</p>
    ) : (
      <table class="w-full text-xs">
        <thead>
          <tr class="border-b border-slate-100 bg-slate-50">
            <th class="text-left px-4 py-2.5 font-semibold text-slate-500 uppercase tracking-wide">Fecha</th>
            <th class="text-left px-4 py-2.5 font-semibold text-slate-500 uppercase tracking-wide">Concepto</th>
            <th class="text-center px-4 py-2.5 font-semibold text-slate-500 uppercase tracking-wide">Tipo</th>
            <th class="text-right px-4 py-2.5 font-semibold text-slate-500 uppercase tracking-wide">Monto</th>
            <th class="text-right px-4 py-2.5 font-semibold text-slate-500 uppercase tracking-wide">Saldo post-tx</th>
            <th class="text-center px-4 py-2.5 font-semibold text-slate-500 uppercase tracking-wide">Estado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {recentTransactions.map((tx) => {
            const isOverdraft = Number(tx.overdraftAmount ?? 0) > 0;
            return (
              <tr class:list={["hover:bg-slate-50/70 transition-colors", isOverdraft && "bg-amber-50/30"]}>
                <td class="px-4 py-2.5 text-slate-500 whitespace-nowrap">{fmtDate(tx.createdAt)}</td>
                <td class="px-4 py-2.5 text-slate-800 font-medium">
                  {tx.concept}
                  {isOverdraft && (
                    <span class="ml-1.5 text-[10px] font-semibold bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded-full">
                      descubierto
                    </span>
                  )}
                </td>
                <td class="px-4 py-2.5 text-center">
                  <span class:list={[
                    "text-[10px] font-semibold px-2 py-0.5 rounded-full",
                    tx.type === "deposit" ? "bg-emerald-100 text-emerald-700" : "bg-red-100 text-red-700",
                  ]}>
                    {tx.type === "deposit" ? "ingreso" : "egreso"}
                  </span>
                </td>
                <td class:list={[
                  "px-4 py-2.5 text-right tabular-nums font-semibold",
                  tx.type === "deposit" ? "text-emerald-700" : "text-red-600",
                ]}>
                  {tx.type === "deposit" ? "+" : "-"}{fmtBs(Number(tx.amount))}
                </td>
                <td class="px-4 py-2.5 text-right tabular-nums text-slate-500">
                  {tx.balanceAfter != null ? fmtBs(Number(tx.balanceAfter)) : <span class="text-slate-300">—</span>}
                </td>
                <td class="px-4 py-2.5 text-center">
                  <span class:list={["text-[10px] font-semibold px-2 py-0.5 rounded-full", statusClass[tx.status] ?? "bg-slate-100 text-slate-500"]}>
                    {tx.status}
                  </span>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    )}
  </div>

  {/* ── Sectors (compact table) ── */}
  <div>
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-sm font-semibold text-slate-800">Sectores vinculados</h2>
      <!-- <a href="/rrhh/sectores"
        class="inline-flex items-center gap-1.5 text-xs text-blue-600 hover:text-blue-800 font-medium transition-colors">
        <ArrowRightLeft class="h-3.5 w-3.5" /> Gestionar sectores en RRHH
      </a> -->
    </div>

    {cashboxDetails.length === 0 ? (
      <div class="rounded-xl border-2 border-dashed border-slate-200 p-10 text-center text-slate-400">
        <Building2 class="h-8 w-8 mx-auto mb-2 opacity-30" />
        <p class="text-sm">Esta caja no tiene sectores vinculados.</p>
        <a href="/rrhh/sectores" class="mt-2 inline-block text-xs text-blue-500 hover:underline">
          Ir a RRHH → Sectores para crear o vincular
        </a>
      </div>
    ) : (
      <div class="rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm">
        <table class="w-full text-xs">
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50">
              <th class="text-left px-4 py-2.5 font-semibold text-slate-500 uppercase tracking-wide">Sector</th>
              <th class="text-center px-4 py-2.5 font-semibold text-slate-500 uppercase tracking-wide">Personal</th>
              <th class="text-right px-4 py-2.5 font-semibold text-slate-500 uppercase tracking-wide">Masa salarial</th>
              <th class="text-center px-4 py-2.5 font-semibold text-slate-500 uppercase tracking-wide">Cobertura</th>
              <th class="text-center px-4 py-2.5 font-semibold text-slate-500 uppercase tracking-wide">Estado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {cashboxDetails.map((cashB) => {
              const emps = empBySector.get(cashB.id) ?? [];
              const sectorSalary = emps.reduce((s, e) => s + Number(e.baseSalary ?? 0), 0);
              const sectorCoverage = sectorSalary > 0 ? Math.min((balance / sectorSalary) * 100, 100) : 100;
              const covers = balance >= sectorSalary;
              return (
                <tr class:list={["hover:bg-slate-50/70 transition-colors", !cashB.isActive && "opacity-50"]}>
                  <td class="px-4 py-3">
                    <div class="flex items-center gap-2">
                      <Building2 class="h-3.5 w-3.5 text-slate-400 shrink-0" />
                      <div>
                        <p class="font-semibold text-slate-800">{cashB.name}</p>
                        {cashB.description && <p class="text-slate-400 truncate max-w-[200px]">{cashB.description}</p>}
                      </div>
                    </div>
                  </td>
                  <td class="px-4 py-3 text-center">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-slate-100 text-slate-700 font-bold">
                      {emps.length}
                    </span>
                  </td>
                  <td class="px-4 py-3 text-right tabular-nums text-slate-700 font-medium">
                    {sectorSalary > 0 ? fmtBs(sectorSalary) : <span class="text-slate-300">—</span>}
                  </td>
                  <td class="px-4 py-3">
                    <div class="flex items-center gap-2 justify-center">
                      <div class="w-16 h-1.5 rounded-full bg-slate-100 overflow-hidden">
                        <div class:list={["h-full rounded-full", covers ? "bg-emerald-400" : "bg-red-400"]}
                          style={`width:${Math.round(sectorCoverage)}%`} />
                      </div>
                      <span class:list={["font-semibold tabular-nums w-8 text-right", covers ? "text-emerald-600" : "text-red-500"]}>
                        {sectorSalary > 0 ? `${Math.round(sectorCoverage)}%` : "—"}
                      </span>
                    </div>
                  </td>
                  <td class="px-4 py-3 text-center">
                    <span class:list={[
                      "text-[10px] font-semibold px-2 py-0.5 rounded-full",
                      cashB.isActive ? "bg-emerald-100 text-emerald-700" : "bg-slate-100 text-slate-400",
                    ]}>
                      {cashB.isActive ? "Activo" : "Inactivo"}
                    </span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>

</FinanceLayout>
