---
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { actions } from "astro:actions";
import { db } from "@/db";
import { cashboxes, sectors, employees, transactionCategories } from "@/db/schema";
import { eq, asc, and, count, sum } from "drizzle-orm";
import {
  Wallet,
  Building2,
  TriangleAlert,
  ChevronLeft,
  CirclePause,
  CirclePlay,
  Pencil,
  ArrowRightLeft,
} from "@lucide/astro";
import CashboxDepositDialog from "@/components/svelte/dialogs/CashboxDepositDialog.svelte";
import SectorManager from "@/components/svelte/SectorManager.svelte";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");
if (!["ADMIN"].includes(user.role ?? "")) return Astro.redirect("/");

const { id } = Astro.params;

const [cashbox] = await db
  .select()
  .from(cashboxes)
  .where(eq(cashboxes.id, id!));

if (!cashbox) return Astro.redirect("/cajas");

// Sectors linked to this cashbox (all, active + inactive for display)
const cashboxSectors = await db
  .select({
    id: sectors.id,
    name: sectors.name,
    description: sectors.description,
    isActive: sectors.isActive,
  })
  .from(sectors)
  .where(eq(sectors.cashboxId, id!))
  .orderBy(asc(sectors.name));

// Employee stats per sector
const sectorEmployees = await db
  .select({
    sectorId: employees.sectorId,
    employeeId: employees.id,
    fullName: employees.fullName,
    chargeTitle: employees.chargeTitle,
    baseSalary: employees.baseSalary,
  })
  .from(employees)
  .innerJoin(sectors, eq(sectors.id, employees.sectorId))
  .where(and(eq(employees.status, "activo"), eq(sectors.cashboxId, id!)));

const empBySector = new Map<number, typeof sectorEmployees>();
for (const emp of sectorEmployees) {
  const key = Number(emp.sectorId);
  if (!empBySector.has(key)) empBySector.set(key, []);
  empBySector.get(key)!.push(emp);
}

// Income categories for deposit dialog
const incomeCategories = await db
  .select({ id: transactionCategories.id, name: transactionCategories.name, code: transactionCategories.code })
  .from(transactionCategories)
  .where(and(eq(transactionCategories.type, "income"), eq(transactionCategories.status, true)))
  .orderBy(asc(transactionCategories.sortOrder));

const balance = Number(cashbox.balance ?? 0);
const totalSalary = sectorEmployees.reduce((sum, e) => sum + Number(e.baseSalary ?? 0), 0);
const canCover = balance >= totalSalary;
const activeSectors = cashboxSectors.filter((s) => s.isActive);
const isActive = cashbox.status === "activo";

// All active cashboxes for the reassign dropdown
const allActiveCashboxes = await db
  .select({ id: cashboxes.id, name: cashboxes.name, code: cashboxes.code, balance: cashboxes.balance })
  .from(cashboxes)
  .where(eq(cashboxes.status, "activo"))
  .orderBy(asc(cashboxes.name));
---

<FinanceLayout title={cashbox.name} user={user}>
    <!-- Remove the old read-only sector grid and replace with: -->
    <SectorManager
      cashboxId={cashbox.id}
      cashboxIsActive={isActive}
      initialSectors={cashboxSectors as any}
      allCashboxes={allActiveCashboxes as any}
      client:load
    />
  <!-- Breadcrumb + Header -->
  <div class="flex items-start justify-between gap-4">
    <div>
      <a href="/cajas" class="text-xs text-slate-500 hover:text-slate-700 flex items-center gap-1 mb-1">
        <ChevronLeft class="h-3 w-3" /> Cajas
      </a>
      <div class="flex items-center gap-2 flex-wrap">
        <Wallet class="h-5 w-5 text-slate-400" />
        <h1 class="text-xl font-bold text-slate-900">{cashbox.name}</h1>
        <span class="font-mono text-xs text-slate-400 bg-slate-100 px-2 py-0.5 rounded">{cashbox.code}</span>
        <span class:list={[
          "text-xs font-semibold px-2 py-0.5 rounded-full",
          isActive
            ? "bg-emerald-100 text-emerald-700"
            : "bg-slate-100 text-slate-500"
        ]}>
          {cashbox.status}
        </span>
      </div>
      <p class:list={["text-2xl font-bold tabular-nums mt-1", canCover ? "text-emerald-600" : "text-red-600"]}>
        Bs {balance.toLocaleString("es-BO", { minimumFractionDigits: 2 })}
      </p>
    </div>

    <!-- Cashbox Controls -->
    <div class="flex items-center gap-2 shrink-0 flex-wrap justify-end">
      <!-- Deposit -->
      {isActive && (
        <CashboxDepositDialog
          cashboxId={cashbox.id}
          cashboxName={cashbox.name}
          currentBalance={balance}
          monthlySalary={totalSalary}
          categories={incomeCategories as any}
          triggerLabel="Depositar"
          triggerClass="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-3 py-2 text-xs font-semibold text-white hover:bg-emerald-700 transition-colors"
          client:load
        />
      )}

      <!-- Edit cashbox (name/description) — link to inline edit or dialog -->
      <a
        href={`/cajas/${id}/editar`}
        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 transition-colors"
      >
        <Pencil class="h-3.5 w-3.5" />
        Editar
      </a>

      <!-- Toggle status -->
      <form
        method="post"
        action={actions.finance.toggleCashboxStatus}
        onsubmit={`return confirm(${JSON.stringify(
          isActive
            ? `¿Desactivar la caja "${cashbox.name}"? Las transacciones existentes no se verán afectadas.`
            : `¿Reactivar la caja "${cashbox.name}"?`
        )})`}
      >
        <input type="hidden" name="cashboxId" value={cashbox.id} />
        <input type="hidden" name="status" value={isActive ? "inactivo" : "activo"} />
        <button
          type="submit"
          class:list={[
            "inline-flex items-center gap-1.5 rounded-lg border px-3 py-2 text-xs font-medium transition-colors",
            isActive
              ? "border-amber-200 bg-amber-50 text-amber-700 hover:bg-amber-100"
              : "border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100"
          ]}
        >
          {isActive
            ? <CirclePause class="h-3.5 w-3.5" />
            : <CirclePlay class="h-3.5 w-3.5" />}
          {isActive ? "Desactivar" : "Reactivar"}
        </button>
      </form>
    </div>
  </div>

  <!-- Salary coverage warning -->
  {!canCover && totalSalary > 0 && (
    <div class="flex items-center gap-2 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <TriangleAlert class="h-4 w-4 shrink-0" />
      Faltan Bs {(totalSalary - balance).toLocaleString("es-BO", { minimumFractionDigits: 2 })} para cubrir la masa salarial total.
    </div>
  )}

  {!isActive && (
    <div class="flex items-center gap-2 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700">
      <TriangleAlert class="h-4 w-4 shrink-0" />
      Esta caja está inactiva. No se pueden registrar transacciones ni vincular sectores.
    </div>
  )}

  <!-- Summary strip -->
  <div class="grid grid-cols-3 gap-3">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-500">Sectores activos</p>
      <p class="text-2xl font-bold text-slate-900 mt-0.5">{activeSectors.length}</p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-500">Personal</p>
      <p class="text-2xl font-bold text-slate-900 mt-0.5">{sectorEmployees.length}</p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-500">Masa salarial</p>
      <p class:list={["text-lg font-bold tabular-nums mt-0.5", canCover ? "text-slate-900" : "text-red-600"]}>
        Bs {totalSalary.toLocaleString("es-BO", { minimumFractionDigits: 0 })}
      </p>
    </div>
  </div>

  <!-- Sectors section — READ ONLY, manage from RRHH > Sectores -->
  <div>
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-sm font-semibold text-slate-800">Sectores vinculados</h2>
      <a
        href="/rrhh/sectores"
        class="inline-flex items-center gap-1.5 text-xs text-blue-600 hover:text-blue-800 font-medium transition-colors"
      >
        <ArrowRightLeft class="h-3.5 w-3.5" />
        Gestionar sectores en RRHH
      </a>
    </div>

    {cashboxSectors.length === 0 ? (
      <div class="rounded-xl border-2 border-dashed border-slate-200 p-10 text-center text-slate-400">
        <Building2 class="h-8 w-8 mx-auto mb-2 opacity-30" />
        <p class="text-sm">Esta caja no tiene sectores vinculados.</p>
        <a href="/rrhh/sectores" class="mt-2 inline-block text-xs text-blue-500 hover:underline">
          Ir a RRHH → Sectores para crear o vincular
        </a>
      </div>
    ) : (
      <div class="sector-grid">
        {cashboxSectors.map((sector) => {
          const emps = empBySector.get(sector.id) ?? [];
          const sectorSalary = emps.reduce((s, e) => s + Number(e.baseSalary ?? 0), 0);

          return (
            <div class:list={[
              "rounded-xl border bg-white shadow-sm p-5",
              sector.isActive ? "border-slate-200" : "border-slate-100 opacity-60"
            ]}>
              <div class="flex items-start justify-between gap-3 mb-4">
                <div class="flex items-center gap-2 min-w-0">
                  <Building2 class="h-4 w-4 text-slate-400 shrink-0" />
                  <div class="min-w-0">
                    <h3 class="font-semibold text-slate-900 truncate">{sector.name}</h3>
                    {sector.description && (
                      <p class="text-xs text-slate-400 truncate">{sector.description}</p>
                    )}
                  </div>
                </div>
                <span class:list={[
                  "shrink-0 text-[10px] font-semibold px-2 py-0.5 rounded-full",
                  sector.isActive
                    ? "bg-emerald-100 text-emerald-700"
                    : "bg-slate-100 text-slate-400"
                ]}>
                  {sector.isActive ? "Activo" : "Inactivo"}
                </span>
              </div>

              <div class="grid grid-cols-2 gap-2 text-center text-xs mb-4">
                <div class="rounded-lg bg-slate-50 p-2">
                  <p class="text-slate-500">Personal</p>
                  <p class="font-bold text-slate-800 text-base">{emps.length}</p>
                </div>
                <div class="rounded-lg bg-slate-50 p-2">
                  <p class="text-slate-500">Masa Salarial</p>
                  <p class="font-bold text-slate-800 tabular-nums">
                    Bs {sectorSalary.toLocaleString("es-BO", { minimumFractionDigits: 0 })}
                  </p>
                </div>
              </div>

              {emps.length > 0 && (
                <div class="rounded-lg border border-slate-100 overflow-hidden">
                  <table class="w-full text-xs">
                    <thead class="bg-slate-50 border-b border-slate-100">
                      <tr>
                        <th class="px-3 py-2 text-left font-medium text-slate-500">Nombre</th>
                        <th class="px-3 py-2 text-left font-medium text-slate-500">Cargo</th>
                        <th class="px-3 py-2 text-right font-medium text-slate-500">Salario</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                      {emps.map((emp) => (
                        <tr class="hover:bg-slate-50/50">
                          <td class="px-3 py-2 font-medium text-slate-800">{emp.fullName}</td>
                          <td class="px-3 py-2 text-slate-500">{emp.chargeTitle}</td>
                          <td class="px-3 py-2 text-right tabular-nums text-slate-700">
                            Bs {Number(emp.baseSalary).toLocaleString("es-BO", { minimumFractionDigits: 2 })}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          );
        })}
      </div>
    )}
  </div>
</FinanceLayout>

<style>
  .sector-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .sector-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
