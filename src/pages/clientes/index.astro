---
/**
 * /inquilinos/clientes
 * Lista completa de clientes/inquilinos con filtros y gestión
 */
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { db } from "@/db";
import { tenants } from "@/db/schema";
import { asc, ilike, eq, or } from "drizzle-orm";
import { Users, UserPlus, Search, Filter } from "@lucide/astro";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");
const canEdit = (["ADMIN", "ADMON"] as const).includes(user.role as any);

const search = Astro.url.searchParams.get("search") ?? "";
const statusFilter = Astro.url.searchParams.get("status") ?? "all";

let query = db.select().from(tenants);

const allTenants = await db
    .select()
    .from(tenants)
    .orderBy(asc(tenants.roomNumber));

const filtered = allTenants.filter((t) => {
    const matchSearch =
        !search ||
        t.name.toLowerCase().includes(search.toLowerCase()) ||
        (t.ci ?? "").includes(search) ||
        t.roomNumber.includes(search);
    const matchStatus = statusFilter === "all" || t.status === statusFilter;
    return matchSearch && matchStatus;
});

const STATUS_LABELS: Record<string, string> = {
    activo: "Activo",
    inactivo: "Inactivo",
    moroso: "Moroso",
};
const STATUS_COLORS: Record<string, string> = {
    activo: "bg-emerald-100 text-emerald-700",
    inactivo: "bg-slate-100 text-slate-500",
    moroso: "bg-red-100 text-red-700",
};

const successMsg = Astro.url.searchParams.get("created")
    ? "Inquilino registrado correctamente."
    : null;
const deletedMsg = Astro.url.searchParams.get("deleted")
    ? "Inquilino eliminado."
    : null;
---

<FinanceLayout title="Clientes — Inquilinos" user={user}>
    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8 space-y-5">
        <!-- Header -->
        <div class="flex items-center justify-between">
            <div>
                <div
                    class="flex items-center gap-1.5 text-sm text-slate-500 mb-1"
                >
                    <a href="/inquilinos" class="hover:text-slate-700"
                        >Inquilinos</a
                    >
                    <span>/</span>
                    <span class="text-slate-900 font-medium">Clientes</span>
                </div>
                <h1 class="text-xl font-bold text-slate-900">
                    Clientes ({filtered.length})
                </h1>
            </div>
            {
                canEdit && (
                    <a
                        href="/inquilinos/clientes/nuevo"
                        class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700 transition-colors"
                    >
                        <UserPlus class="h-4 w-4" />
                        Registrar
                    </a>
                )
            }
        </div>

        <!-- Feedback -->
        {
            successMsg && (
                <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
                    {successMsg}
                </div>
            )
        }
        {
            deletedMsg && (
                <div class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600">
                    {deletedMsg}
                </div>
            )
        }

        <!-- Filters -->
        <form
            method="GET"
            class="flex flex-wrap gap-3 items-end rounded-xl border border-slate-200 bg-white p-4 shadow-sm"
        >
            <div class="flex-1 min-w-40">
                <label class="block text-xs font-medium text-slate-600 mb-1"
                    >Buscar</label
                >
                <div class="relative">
                    <Search
                        class="absolute left-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-slate-400"
                    />
                    <input
                        type="text"
                        name="search"
                        value={search}
                        placeholder="Nombre, CI, ambiente..."
                        class="w-full pl-9 pr-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                </div>
            </div>
            <div>
                <label class="block text-xs font-medium text-slate-600 mb-1"
                    >Estado</label
                >
                <select
                    name="status"
                    class="text-sm border border-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
                >
                    <option value="all" selected={statusFilter === "all"}
                        >Todos</option
                    >
                    <option value="activo" selected={statusFilter === "activo"}
                        >Activo</option
                    >
                    <option
                        value="inactivo"
                        selected={statusFilter === "inactivo"}>Inactivo</option
                    >
                    <option value="moroso" selected={statusFilter === "moroso"}
                        >Moroso</option
                    >
                </select>
            </div>
            <button
                type="submit"
                class="inline-flex items-center gap-2 rounded-lg bg-slate-800 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700 transition-colors"
            >
                <Filter class="h-3.5 w-3.5" />
                Filtrar
            </button>
        </form>

        <!-- Table -->
        <div
            class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden"
        >
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead
                        class="bg-slate-50 text-xs text-slate-500 border-b border-slate-200"
                    >
                        <tr>
                            <th class="py-3 px-5 font-medium">Cliente</th>
                            <th class="py-3 px-4 font-medium">CI</th>
                            <th class="py-3 px-4 font-medium">Ambiente</th>
                            <th class="py-3 px-4 font-medium">Teléfono</th>
                            <th class="py-3 px-4 text-right font-medium"
                                >Alquiler/Mes</th
                            >
                            <th class="py-3 px-4 font-medium"
                                >Inicio Contrato</th
                            >
                            <th class="py-3 px-4 font-medium">Estado</th>
                            {
                                canEdit && (
                                    <th class="py-3 px-4 text-right font-medium">
                                        Acciones
                                    </th>
                                )
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {
                            filtered.length === 0 ? (
                                <tr>
                                    <td
                                        colspan="8"
                                        class="py-12 text-center text-slate-400 text-sm"
                                    >
                                        No se encontraron clientes con los
                                        filtros actuales.
                                    </td>
                                </tr>
                            ) : (
                                filtered.map((t) => (
                                    <tr class="hover:bg-slate-50/60 transition-colors">
                                        <td class="py-3.5 px-5">
                                            <p class="font-medium text-slate-900">
                                                {t.name}
                                            </p>
                                            {t.email && (
                                                <p class="text-xs text-slate-400">
                                                    {t.email}
                                                </p>
                                            )}
                                        </td>
                                        <td class="py-3.5 px-4 font-mono text-xs text-slate-500">
                                            {t.ci ?? "—"}
                                        </td>
                                        <td class="py-3.5 px-4">
                                            <span class="font-bold text-slate-700 font-mono">
                                                Amb. {t.roomNumber}
                                            </span>
                                            {t.floor && (
                                                <span class="text-xs text-slate-400 ml-1">
                                                    P{t.floor}
                                                </span>
                                            )}
                                        </td>
                                        <td class="py-3.5 px-4 text-slate-500">
                                            {t.phone ?? "—"}
                                        </td>
                                        <td class="py-3.5 px-4 text-right font-mono font-semibold text-slate-700">
                                            Bs{" "}
                                            {Number(
                                                t.monthlyRent,
                                            ).toLocaleString("es-BO", {
                                                minimumFractionDigits: 2,
                                            })}
                                        </td>
                                        <td class="py-3.5 px-4 text-xs text-slate-500">
                                            {t.startDate
                                                ? new Date(
                                                      t.startDate,
                                                  ).toLocaleDateString("es-BO")
                                                : "—"}
                                        </td>
                                        <td class="py-3.5 px-4">
                                            <span
                                                class:list={[
                                                    "rounded-full px-2.5 py-0.5 text-xs font-medium",
                                                    STATUS_COLORS[t.status] ??
                                                        "bg-slate-100 text-slate-500",
                                                ]}
                                            >
                                                {STATUS_LABELS[t.status] ??
                                                    t.status}
                                            </span>
                                        </td>
                                        {canEdit && (
                                            <td class="py-3.5 px-4 text-right">
                                                <div class="flex items-center justify-end gap-2">
                                                    <a
                                                        href={`/inquilinos/clientes/${t.id}`}
                                                        class="rounded border border-slate-200 px-3 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50 transition-colors"
                                                    >
                                                        Ver
                                                    </a>
                                                    <a
                                                        href={`/inquilinos/clientes/${t.id}/editar`}
                                                        class="rounded border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-medium text-blue-700 hover:bg-blue-100 transition-colors"
                                                    >
                                                        Editar
                                                    </a>
                                                    <form
                                                        method="POST"
                                                        action="/api/inquilinos/eliminar"
                                                        class="inline"
                                                        onsubmit="return confirm('¿Eliminar este inquilino? Esta acción no se puede deshacer.')"
                                                    >
                                                        <input
                                                            type="hidden"
                                                            name="id"
                                                            value={t.id}
                                                        />
                                                        <button
                                                            type="submit"
                                                            class="rounded border border-red-200 bg-red-50 px-3 py-1 text-xs font-medium text-red-700 hover:bg-red-100 transition-colors"
                                                        >
                                                            Eliminar
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        )}
                                    </tr>
                                ))
                            )
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</FinanceLayout>
