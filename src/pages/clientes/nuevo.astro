---
/**
 * /inquilinos/clientes/nuevo
 * Formulario de registro de nuevo inquilino
 */
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { actions, isActionError, isInputError } from "astro:actions";
import { Building, AlertTriangle } from "@lucide/astro";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");
if (!["ADMIN", "ADMON"].includes(user.role ?? "")) return Astro.redirect("/inquilinos");

const result = Astro.getActionResult(actions.inquilinos?.createTenant);
const inputErrors = isInputError(result?.error) ? result.error.fields : {};
const errorMessage = isActionError(result?.error) ? result.error.message : null;

if (!result?.error && result?.data?.success) {
  return Astro.redirect("/inquilinos/clientes?created=1");
}
---

<FinanceLayout title="Registrar Inquilino" user={user}>
  <main class="mx-auto max-w-2xl px-4 py-8 sm:px-6 lg:px-8">

    <!-- Breadcrumb -->
    <div class="text-sm text-slate-500 mb-4 flex items-center gap-1.5">
      <a href="/inquilinos" class="hover:text-slate-700">Inquilinos</a>
      <span>/</span>
      <a href="/inquilinos/clientes" class="hover:text-slate-700">Clientes</a>
      <span>/</span>
      <span class="text-slate-900 font-medium">Nuevo</span>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white shadow-sm p-6">
      <div class="flex items-center gap-3 mb-6">
        <div class="rounded-lg bg-emerald-100 p-2">
          <Building class="h-5 w-5 text-emerald-600" />
        </div>
        <div>
          <h1 class="text-lg font-bold text-slate-900">Registrar Inquilino</h1>
          <p class="text-xs text-slate-500">Complete los datos del nuevo cliente</p>
        </div>
      </div>

      {errorMessage && (
        <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3">
          <p class="text-sm text-red-700">{errorMessage}</p>
        </div>
      )}

      <form method="POST" action={actions.inquilinos?.createTenant} class="space-y-5">

        <!-- Datos del cliente -->
        <fieldset class="space-y-4">
          <legend class="text-sm font-semibold text-slate-700 border-b border-slate-100 pb-2 w-full">
            Datos del Cliente
          </legend>

          <div class="grid grid-cols-2 gap-4">
            <div class="col-span-2">
              <label class="block text-sm font-medium text-slate-700 mb-1">
                Nombre Completo <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                name="name"
                required
                placeholder="Juan Pérez López"
                class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
              {inputErrors.name && <p class="mt-1 text-xs text-red-600">{inputErrors.name}</p>}
            </div>

            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">CI</label>
              <input
                type="text"
                name="ci"
                placeholder="12345678"
                class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Teléfono</label>
              <input
                type="tel"
                name="phone"
                placeholder="+591 70000000"
                class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
            </div>

            <div class="col-span-2">
              <label class="block text-sm font-medium text-slate-700 mb-1">Correo Electrónico</label>
              <input
                type="email"
                name="email"
                placeholder="cliente@correo.com"
                class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
            </div>
          </div>
        </fieldset>

        <!-- Datos del ambiente -->
        <fieldset class="space-y-4">
          <legend class="text-sm font-semibold text-slate-700 border-b border-slate-100 pb-2 w-full">
            Ambiente / Unidad
          </legend>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">
                N° Ambiente <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                name="roomNumber"
                required
                placeholder="101"
                class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
              {inputErrors.roomNumber && <p class="mt-1 text-xs text-red-600">{inputErrors.roomNumber}</p>}
            </div>

            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Piso</label>
              <input
                type="text"
                name="floor"
                placeholder="1"
                class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
            </div>

            <div class="col-span-2">
              <label class="block text-sm font-medium text-slate-700 mb-1">Descripción del Ambiente</label>
              <input
                type="text"
                name="description"
                placeholder="Ej: Oficina, Depósito, Local comercial..."
                class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
            </div>
          </div>
        </fieldset>

        <!-- Contrato y alquiler -->
        <fieldset class="space-y-4">
          <legend class="text-sm font-semibold text-slate-700 border-b border-slate-100 pb-2 w-full">
            Contrato y Alquiler
          </legend>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">
                Alquiler Mensual (Bs) <span class="text-red-500">*</span>
              </label>
              <input
                type="number"
                name="monthlyRent"
                required
                min="0"
                step="0.01"
                placeholder="500.00"
                class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
              {inputErrors.monthlyRent && <p class="mt-1 text-xs text-red-600">{inputErrors.monthlyRent}</p>}
            </div>

            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Moneda</label>
              <select
                name="currency"
                class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
                <option value="BOB">BOB — Bolivianos</option>
                <option value="USD">USD — Dólares</option>
              </select>
            </div>

            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">
                Fecha de Inicio <span class="text-red-500">*</span>
              </label>
              <input
                type="date"
                name="startDate"
                required
                class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
              {inputErrors.startDate && <p class="mt-1 text-xs text-red-600">{inputErrors.startDate}</p>}
            </div>

            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Fecha de Fin (opcional)</label>
              <input
                type="date"
                name="endDate"
                class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
            </div>
          </div>
        </fieldset>

        <!-- Notas -->
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Notas</label>
          <textarea
            name="notes"
            rows="2"
            placeholder="Observaciones opcionales..."
            class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"
          ></textarea>
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-between border-t border-slate-100 pt-4">
          <a
            href="/inquilinos/clientes"
            class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors"
          >
            Cancelar
          </a>
          <button
            type="submit"
            class="rounded-lg bg-emerald-600 px-6 py-2 text-sm font-semibold text-white hover:bg-emerald-700 transition-colors shadow-sm"
          >
            Registrar Inquilino
          </button>
        </div>
      </form>
    </div>
  </main>
</FinanceLayout>
