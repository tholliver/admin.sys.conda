---
/**
 * /auditoria
 * Payment coverage audit: surfaces missing and pending periods for
 * all active employees and tenants, with inline actions to fix them.
 */
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { actions, isActionError } from "astro:actions";
import { getFullAudit } from "@/services/audit.service";
import { getSectorCashboxLinks } from "@/services/rrhh/rrhh.service";
import {
    CheckCircle,
    Users,
    Building,
    FileWarning,
    TriangleAlert,
    PlusCircle,
    CreditCard,
} from "@lucide/astro";
import { formatBOB } from "@/utils/formatters";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");

const ALLOWED = ["ADMIN", "ADMON", "ACTS", "ACCO"] as const;
if (!ALLOWED.includes(user.role as any)) return Astro.redirect("/panel");
const canEdit = (["ADMIN", "ADMON"] as const).includes(user.role as any);

const generateFeeResult   = Astro.getActionResult(actions.rrhh.createEmployeeFee);
const generateRentResult  = Astro.getActionResult(actions.inquilinos.createPendingRent);

const successMsg =
    (!generateFeeResult?.error  && generateFeeResult?.data?.message)  ||
    (!generateRentResult?.error && generateRentResult?.data?.message) ||
    null;

const errorMsg =
    (isActionError(generateFeeResult?.error)  && generateFeeResult.error.message)  ||
    (isActionError(generateRentResult?.error) && generateRentResult.error.message) ||
    null;

const [audit, cashboxLinks] = await Promise.all([
    getFullAudit(),
    getSectorCashboxLinks(),
]);

const defaultCashboxId = cashboxLinks[0]?.cashboxId ?? "";

const {
    employeeGaps,
    tenantGaps,
    totalMissingEmployeeFees,
    totalPendingEmployeeAmount,
    totalMissingTenantPeriods,
    totalPendingTenantAmount,
} = audit;

// Grouped for display
const employeeGapsGrouped = Object.values(
    employeeGaps.reduce((acc, gap) => {
        const key = gap.employeeId;
        if (!acc[key]) acc[key] = { employeeId: gap.employeeId, fullName: gap.fullName, chargeTitle: gap.chargeTitle, periods: [] };
        acc[key].periods.push(gap);
        return acc;
    }, {} as Record<number, { employeeId: number; fullName: string; chargeTitle: string; periods: typeof employeeGaps }>)
);

const tenantGapsGrouped = Object.values(
    tenantGaps.reduce((acc, gap) => {
        const key = gap.tenantId;
        if (!acc[key]) acc[key] = { tenantId: gap.tenantId, fullName: gap.fullName, roomNumber: gap.roomNumber, periods: [] };
        acc[key].periods.push(gap);
        return acc;
    }, {} as Record<number, { tenantId: number; fullName: string; roomNumber: string; periods: typeof tenantGaps }>)
);

const totalGaps = employeeGaps.length + tenantGaps.length;

const formatPeriod = (p: string) => {
    const [y, m] = p.split("-");
    return new Date(Number(y), Number(m) - 1).toLocaleDateString("es-BO", {
        month: "long",
        year: "numeric",
    });
};

const KIND_BADGE = { missing: "bg-red-100 text-red-700", pending: "bg-amber-100 text-amber-700" };
const KIND_LABEL = { missing: "Sin registro", pending: "Pendiente" };
const KIND_ROW   = { missing: "bg-red-50/40",  pending: "bg-amber-50/30" };
---

<FinanceLayout title="Auditoría de Pagos" user={user}>

<!-- KPIs -->
<div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
    <!-- Total gaps -->
    <div class:list={["rounded-xl border p-4 shadow-sm", totalGaps === 0 ? "border-emerald-200 bg-emerald-50" : "border-red-200 bg-red-50"]}>
        <div class="flex items-center justify-between mb-2">
            <p class:list={["text-xs uppercase tracking-wide", totalGaps === 0 ? "text-emerald-600" : "text-red-600"]}>Total Huecos</p>
            {totalGaps === 0 ? <CheckCircle class="h-4 w-4 text-emerald-500" /> : <FileWarning class="h-4 w-4 text-red-500" />}
        </div>
        <p class:list={["text-3xl font-bold tabular-nums", totalGaps === 0 ? "text-emerald-800" : "text-red-800"]}>{totalGaps}</p>
        <p class:list={["text-xs mt-0.5", totalGaps === 0 ? "text-emerald-600" : "text-red-500"]}>{totalGaps === 0 ? "Todo al día ✓" : "períodos con problemas"}</p>
    </div>

    <!-- Personal count -->
    <div class="rounded-xl border border-violet-200 bg-violet-50 p-4">
        <div class="flex items-center justify-between mb-2">
            <p class="text-xs text-violet-600 uppercase tracking-wide">Personal</p>
            <Users class="h-4 w-4 text-violet-500" />
        </div>
        <p class="text-2xl font-bold text-violet-800 tabular-nums">{employeeGapsGrouped.length}</p>
        <p class="text-xs text-violet-600 mt-0.5">{employeeGaps.length} período{employeeGaps.length !== 1 ? "s" : ""} con problema</p>
    </div>

    <!-- Inquilinos count -->
    <div class="rounded-xl border border-blue-200 bg-blue-50 p-4">
        <div class="flex items-center justify-between mb-2">
            <p class="text-xs text-blue-600 uppercase tracking-wide">Inquilinos</p>
            <Building class="h-4 w-4 text-blue-500" />
        </div>
        <p class="text-2xl font-bold text-blue-800 tabular-nums">{tenantGapsGrouped.length}</p>
        <p class="text-xs text-blue-600 mt-0.5">{tenantGaps.length} período{tenantGaps.length !== 1 ? "s" : ""} con problema</p>
    </div>

    <!-- Deuda personal -->
    <div class="rounded-xl border border-violet-100 bg-white p-4 shadow-sm">
        <div class="flex items-center justify-between mb-2">
            <p class="text-xs text-slate-500 uppercase tracking-wide">Deuda Personal</p>
            <Users class="h-4 w-4 text-violet-300" />
        </div>
        <p class="text-base font-bold text-slate-900 tabular-nums">{formatBOB(totalPendingEmployeeAmount)}</p>
        <p class="text-xs text-slate-400 mt-0.5">{totalMissingEmployeeFees} sin registro</p>
    </div>

    <!-- Deuda alquiler -->
    <div class="rounded-xl border border-blue-100 bg-white p-4 shadow-sm">
        <div class="flex items-center justify-between mb-2">
            <p class="text-xs text-slate-500 uppercase tracking-wide">Deuda Alquiler</p>
            <Building class="h-4 w-4 text-blue-300" />
        </div>
        <p class="text-base font-bold text-slate-900 tabular-nums">{formatBOB(totalPendingTenantAmount)}</p>
        <p class="text-xs text-slate-400 mt-0.5">{totalMissingTenantPeriods} sin registro</p>
    </div>
</div>

{totalGaps === 0 && (
    <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-6 py-12 text-center">
        <CheckCircle class="size-10 text-emerald-400 mx-auto mb-3" />
        <p class="font-semibold text-emerald-800">Sin huecos detectados</p>
        <p class="text-sm text-emerald-600 mt-1">Todos los períodos están registrados y pagados.</p>
    </div>
)}

<!-- EMPLOYEE GAPS -->
{employeeGapsGrouped.length > 0 && (
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100 flex items-center gap-2">
            <Users class="size-4 text-violet-500" />
            <h2 class="font-semibold text-slate-800 text-sm">
                Personal — {employeeGapsGrouped.length} miembro{employeeGapsGrouped.length !== 1 ? "s" : ""} con deuda
            </h2>
        </div>
        <div class="px-5 py-2.5 border-b border-slate-100 bg-slate-50 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500">
            <span class="flex items-center gap-1.5"><span class="inline-block size-2.5 rounded-full bg-red-300"></span>Rojo = mes nunca generado → <strong>"Crear cuota"</strong> lo registra como pendiente</span>
            <span class="flex items-center gap-1.5"><span class="inline-block size-2.5 rounded-full bg-amber-300"></span>Ámbar = generado pero sin pagar → ir a Salarios a pagarlo</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 text-xs text-slate-500 border-b border-slate-200">
                    <tr>
                        <th class="py-3 px-5 text-left font-medium">Empleado</th>
                        <th class="py-3 px-4 text-left font-medium">Meses con problema</th>
                        <th class="py-3 px-4 text-center font-medium">Tipo</th>
                        <th class="py-3 px-4 text-right font-medium">Total deuda</th>
                        {canEdit && <th class="py-3 px-4 text-right font-medium">Acciones</th>}
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {employeeGapsGrouped.map((group) => {
                        const totalAmount = group.periods.reduce(
                            (s, g) => s + (g.kind === "pending" ? g.amount : g.expectedAmount), 0
                        );
                        const missingPeriods = group.periods.filter((g) => g.kind === "missing");
                        const pendingPeriods = group.periods.filter((g) => g.kind === "pending");
                        return (
                            <tr class="transition-colors hover:bg-slate-50/60">
                                <td class="py-3.5 px-5 align-top">
                                    <p class="font-medium text-slate-900">{group.fullName}</p>
                                    <p class="text-xs text-slate-400">{group.chargeTitle}</p>
                                </td>
                                <td class="py-3.5 px-4 align-top">
                                    <div class="flex flex-wrap gap-1.5">
                                        {group.periods.map((gap) => (
                                            <span class:list={[
                                                "inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium capitalize",
                                                gap.kind === "missing"
                                                    ? "bg-red-100 text-red-700"
                                                    : "bg-amber-100 text-amber-700"
                                            ]}>
                                                {formatPeriod(gap.period)}
                                            </span>
                                        ))}
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 text-center align-top">
                                    <div class="flex flex-col items-center gap-1">
                                        {missingPeriods.length > 0 && (
                                            <span class="rounded-full px-2.5 py-0.5 text-xs font-medium bg-red-100 text-red-700">
                                                {missingPeriods.length} sin registro
                                            </span>
                                        )}
                                        {pendingPeriods.length > 0 && (
                                            <span class="rounded-full px-2.5 py-0.5 text-xs font-medium bg-amber-100 text-amber-700">
                                                {pendingPeriods.length} pendiente{pendingPeriods.length !== 1 ? "s" : ""}
                                            </span>
                                        )}
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 text-right font-mono font-semibold text-slate-700 align-top">
                                    {formatBOB(totalAmount)}
                                </td>
                                {canEdit && (
                                    <td class="py-3.5 px-4 text-right align-top">
                                        <div class="flex flex-col items-end gap-1.5">
                                            {missingPeriods.map((gap) => (
                                                <form method="POST" action={actions.rrhh.createEmployeeFee} class="inline">
                                                    <input type="hidden" name="employeeId" value={gap.employeeId} />
                                                    <input type="hidden" name="period"     value={gap.period} />
                                                    <input type="hidden" name="amount"     value={gap.expectedAmount} />
                                                    <input type="hidden" name="cashboxId"  value={defaultCashboxId} />
                                                    <button
                                                        type="submit"
                                                        onclick={`return confirm('Crear cuota\\n\\n${gap.fullName}\\nPeríodo: ${gap.period}\\n${formatBOB(gap.expectedAmount)}\\n\\nQuedará como PENDIENTE.')`}
                                                        class="inline-flex items-center gap-1 rounded border border-violet-200 bg-violet-50 px-2.5 py-1 text-xs font-medium text-violet-700 hover:bg-violet-100 transition-colors whitespace-nowrap"
                                                    >
                                                        <PlusCircle class="size-3 shrink-0" />
                                                        {formatPeriod(gap.period)}
                                                    </button>
                                                </form>
                                            ))}
                                            {pendingPeriods.length > 0 && (
                                                <a
                                                    href="/rrhh/salarios?status=pendiente"
                                                    class="inline-flex items-center gap-1 rounded border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700 hover:bg-amber-100 transition-colors whitespace-nowrap"
                                                >
                                                    <CreditCard class="size-3 shrink-0" />
                                                    Ir a pagar
                                                </a>
                                            )}
                                        </div>
                                    </td>
                                )}
                            </tr>
                        );
                    })}
                </tbody>
            </table>
        </div>
    </div>
)}

<!-- TENANT GAPS -->
{tenantGapsGrouped.length > 0 && (
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100 flex items-center gap-2">
            <Building class="size-4 text-blue-500" />
            <h2 class="font-semibold text-slate-800 text-sm">
                Inquilinos — {tenantGapsGrouped.length} inquilino{tenantGapsGrouped.length !== 1 ? "s" : ""} con deuda
            </h2>
        </div>
        <div class="px-5 py-2.5 border-b border-slate-100 bg-slate-50 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500">
            <span class="flex items-center gap-1.5"><span class="inline-block size-2.5 rounded-full bg-red-300"></span>Rojo = mes nunca registrado → <strong>"Registrar deuda"</strong> lo crea como pendiente</span>
            <span class="flex items-center gap-1.5"><span class="inline-block size-2.5 rounded-full bg-amber-300"></span>Ámbar = registrado pero sin cobrar → ir al perfil del inquilino a cobrarlo</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 text-xs text-slate-500 border-b border-slate-200">
                    <tr>
                        <th class="py-3 px-5 text-left font-medium">Inquilino</th>
                        <th class="py-3 px-4 text-left font-medium">Meses con problema</th>
                        <th class="py-3 px-4 text-center font-medium">Tipo</th>
                        <th class="py-3 px-4 text-right font-medium">Total deuda</th>
                        {canEdit && <th class="py-3 px-4 text-right font-medium">Acciones</th>}
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {tenantGapsGrouped.map((group) => {
                        const totalAmount = group.periods.reduce(
                            (s, g) => s + (g.kind === "pending" ? g.amount : g.expectedAmount), 0
                        );
                        const missingPeriods = group.periods.filter((g) => g.kind === "missing");
                        const pendingPeriods = group.periods.filter((g) => g.kind === "pending");
                        return (
                            <tr class="transition-colors hover:bg-slate-50/60">
                                <td class="py-3.5 px-5 align-top">
                                    <p class="font-medium text-slate-900">{group.fullName}</p>
                                    <p class="text-xs text-slate-400">Amb. {group.roomNumber}</p>
                                </td>
                                <td class="py-3.5 px-4 align-top">
                                    <div class="flex flex-wrap gap-1.5">
                                        {group.periods.map((gap) => (
                                            <span class:list={[
                                                "inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium capitalize",
                                                gap.kind === "missing"
                                                    ? "bg-red-100 text-red-700"
                                                    : "bg-amber-100 text-amber-700"
                                            ]}>
                                                {formatPeriod(gap.period)}
                                            </span>
                                        ))}
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 text-center align-top">
                                    <div class="flex flex-col items-center gap-1">
                                        {missingPeriods.length > 0 && (
                                            <span class="rounded-full px-2.5 py-0.5 text-xs font-medium bg-red-100 text-red-700">
                                                {missingPeriods.length} sin registro
                                            </span>
                                        )}
                                        {pendingPeriods.length > 0 && (
                                            <span class="rounded-full px-2.5 py-0.5 text-xs font-medium bg-amber-100 text-amber-700">
                                                {pendingPeriods.length} pendiente{pendingPeriods.length !== 1 ? "s" : ""}
                                            </span>
                                        )}
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 text-right font-mono font-semibold text-slate-700 align-top">
                                    {formatBOB(totalAmount)}
                                </td>
                                {canEdit && (
                                    <td class="py-3.5 px-4 text-right align-top">
                                        <div class="flex flex-col items-end gap-1.5">
                                            {missingPeriods.map((gap) => (
                                                <form method="POST" action={actions.inquilinos.createPendingRent} class="inline">
                                                    <input type="hidden" name="tenantId" value={gap.tenantId} />
                                                    <input type="hidden" name="period"   value={gap.period} />
                                                    <input type="hidden" name="amount"   value={gap.expectedAmount} />
                                                    <button
                                                        type="submit"
                                                        onclick={`return confirm('Registrar deuda de alquiler\\n\\n${gap.fullName} — Amb. ${gap.roomNumber}\\nPeríodo: ${gap.period}\\n${formatBOB(gap.expectedAmount)}\\n\\nQuedará como PENDIENTE.')`}
                                                        class="inline-flex items-center gap-1 rounded border border-blue-200 bg-blue-50 px-2.5 py-1 text-xs font-medium text-blue-700 hover:bg-blue-100 transition-colors whitespace-nowrap"
                                                    >
                                                        <PlusCircle class="size-3 shrink-0" />
                                                        {formatPeriod(gap.period)}
                                                    </button>
                                                </form>
                                            ))}
                                            {pendingPeriods.length > 0 && (
                                                <a
                                                    href={`/inquilinos/${group.tenantId}`}
                                                    class="inline-flex items-center gap-1 rounded border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700 hover:bg-amber-100 transition-colors whitespace-nowrap"
                                                >
                                                    <CreditCard class="size-3 shrink-0" />
                                                    Ir a cobrar
                                                </a>
                                            )}
                                        </div>
                                    </td>
                                )}
                            </tr>
                        );
                    })}
                </tbody>
            </table>
        </div>
    </div>
)}
</FinanceLayout>
