---
/**
 * /auditoria
 * Summary-only audit. One row per person, severity-driven.
 * Missing > Pending in severity. No per-period buttons here.
 *
 * Employees → /rrhh/salarios?employeeId=X&status=pendiente
 * Tenants   → /inquilinos/[id]#deudas  (granular actions live there)
 */
import FinanceLayout from "@/layouts/FinanceLayout.astro";
import { getFullAudit } from "@/services/audit.service";
import { CheckCircle, Users, Building, FileWarning, ExternalLink, CreditCard } from "@lucide/astro";
import { bob } from "@/utils/currency";

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");

const ALLOWED = ["ADMIN", "ADMON", "ACTS", "ACCO"] as const;
if (!ALLOWED.includes(user.role as any)) return Astro.redirect("/panel");

const [audit] = await Promise.all([getFullAudit()]);

const {
    employeeGaps,
    tenantGaps,
    totalMissingEmployeeFees,
    totalPendingEmployeeAmount,
    totalMissingTenantPeriods,
    totalPendingTenantAmount,
} = audit;

const employeeGapsGrouped = Object.values(
    employeeGaps.reduce((acc, gap) => {
        const key = gap.employeeId;
        if (!acc[key]) acc[key] = { employeeId: gap.employeeId, fullName: gap.fullName, chargeTitle: gap.chargeTitle, periods: [] };
        acc[key].periods.push(gap);
        return acc;
    }, {} as Record<number, { employeeId: number; fullName: string; chargeTitle: string; periods: typeof employeeGaps }>)
);

const tenantGapsGrouped = Object.values(
    tenantGaps.reduce((acc, gap) => {
        const key = gap.tenantId;
        if (!acc[key]) acc[key] = { tenantId: gap.tenantId, fullName: gap.fullName, roomNumber: gap.roomNumber, periods: [] };
        acc[key].periods.push(gap);
        return acc;
    }, {} as Record<number, { tenantId: number; fullName: string; roomNumber: string; periods: typeof tenantGaps }>)
);

const totalGaps = employeeGaps.length + tenantGaps.length;

// any missing → red severity. all pending → amber.
const severity = (periods: { kind: string }[]) =>
    periods.some((p) => p.kind === "missing") ? "missing" : "pending";

const SEVERITY_ROW   = { missing: "bg-red-50/50",   pending: "bg-amber-50/40" };
const SEVERITY_BADGE = { missing: "bg-red-100 text-red-700", pending: "bg-amber-100 text-amber-700" };

const fmtPeriod = (p: string) => {
    const [y, m] = p.split("-");
    return new Date(Number(y), Number(m) - 1).toLocaleDateString("es-BO", { month: "short", year: "numeric" });
};
---

<FinanceLayout title="Auditoría de Pagos" user={user}>

<!-- KPIs -->
<div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
    <div class:list={["rounded-xl border p-4 shadow-sm", totalGaps === 0 ? "border-emerald-200 bg-emerald-50" : "border-red-200 bg-red-50"]}>
        <div class="flex items-center justify-between mb-2">
            <p class:list={["text-xs uppercase tracking-wide", totalGaps === 0 ? "text-emerald-600" : "text-red-600"]}>Total Huecos</p>
            {totalGaps === 0 ? <CheckCircle class="h-4 w-4 text-emerald-500" /> : <FileWarning class="h-4 w-4 text-red-500" />}
        </div>
        <p class:list={["text-3xl font-bold tabular-nums", totalGaps === 0 ? "text-emerald-800" : "text-red-800"]}>{totalGaps}</p>
        <p class:list={["text-xs mt-0.5", totalGaps === 0 ? "text-emerald-600" : "text-red-500"]}>{totalGaps === 0 ? "Todo al día ✓" : "períodos con problemas"}</p>
    </div>
    <div class="rounded-xl border border-violet-200 bg-violet-50 p-4">
        <div class="flex items-center justify-between mb-2">
            <p class="text-xs text-violet-600 uppercase tracking-wide">Personal</p>
            <Users class="h-4 w-4 text-violet-500" />
        </div>
        <p class="text-2xl font-bold text-violet-800 tabular-nums">{employeeGapsGrouped.length}</p>
        <p class="text-xs text-violet-600 mt-0.5">{employeeGaps.length} período{employeeGaps.length !== 1 ? "s" : ""} con problema</p>
    </div>
    <div class="rounded-xl border border-blue-200 bg-blue-50 p-4">
        <div class="flex items-center justify-between mb-2">
            <p class="text-xs text-blue-600 uppercase tracking-wide">Inquilinos</p>
            <Building class="h-4 w-4 text-blue-500" />
        </div>
        <p class="text-2xl font-bold text-blue-800 tabular-nums">{tenantGapsGrouped.length}</p>
        <p class="text-xs text-blue-600 mt-0.5">{tenantGaps.length} período{tenantGaps.length !== 1 ? "s" : ""} con problema</p>
    </div>
    <div class="rounded-xl border border-violet-100 bg-white p-4 shadow-sm">
        <div class="flex items-center justify-between mb-2">
            <p class="text-xs text-slate-500 uppercase tracking-wide">Deuda Personal</p>
            <Users class="h-4 w-4 text-violet-300" />
        </div>
        <p class="text-base font-bold text-slate-900 tabular-nums">{bob(totalPendingEmployeeAmount)}</p>
        <p class="text-xs text-slate-400 mt-0.5">{totalMissingEmployeeFees} sin registro</p>
    </div>
    <div class="rounded-xl border border-blue-100 bg-white p-4 shadow-sm">
        <div class="flex items-center justify-between mb-2">
            <p class="text-xs text-slate-500 uppercase tracking-wide">Deuda Alquiler</p>
            <Building class="h-4 w-4 text-blue-300" />
        </div>
        <p class="text-base font-bold text-slate-900 tabular-nums">{bob(totalPendingTenantAmount)}</p>
        <p class="text-xs text-slate-400 mt-0.5">{totalMissingTenantPeriods} sin registro</p>
    </div>
</div>

{totalGaps === 0 && (
    <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-6 py-12 text-center">
        <CheckCircle class="size-10 text-emerald-400 mx-auto mb-3" />
        <p class="font-semibold text-emerald-800">Sin huecos detectados</p>
        <p class="text-sm text-emerald-600 mt-1">Todos los períodos están registrados y pagados.</p>
    </div>
)}

<!-- PERSONAL — one row, one link to salarios filtered by employee -->
{employeeGapsGrouped.length > 0 && (
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100 flex items-center gap-2">
            <Users class="size-4 text-violet-500" />
            <h2 class="font-semibold text-slate-800 text-sm">
                Personal — {employeeGapsGrouped.length} con deuda
            </h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 text-xs text-slate-500 border-b border-slate-200">
                    <tr>
                        <th class="py-3 px-5 text-left font-medium">Empleado</th>
                        <th class="py-3 px-4 text-left font-medium">Períodos afectados</th>
                        <th class="py-3 px-4 text-center font-medium">Estado</th>
                        <th class="py-3 px-4 text-right font-medium">Deuda total</th>
                        <th class="py-3 px-4 text-right font-medium"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {employeeGapsGrouped.map((group) => {
                        const sev = severity(group.periods);
                        const missing = group.periods.filter(p => p.kind === "missing");
                        const pending = group.periods.filter(p => p.kind === "pending");
                        const total = group.periods.reduce(
                            (s, g) => s + (g.kind === "pending" ? g.amount : g.expectedAmount), 0
                        );
                        return (
                            <tr class:list={["transition-colors hover:brightness-95", SEVERITY_ROW[sev]]}>
                                <td class="py-3.5 px-5 align-middle">
                                    <p class="font-medium text-slate-900">{group.fullName}</p>
                                    <p class="text-xs text-slate-400">{group.chargeTitle}</p>
                                </td>
                                <td class="py-3.5 px-4 align-middle">
                                    <div class="flex flex-wrap gap-1">
                                        {group.periods.map((gap) => (
                                            <span class:list={[
                                                "inline-flex rounded px-1.5 py-0.5 text-xs font-medium",
                                                gap.kind === "missing" ? "bg-red-100 text-red-600" : "bg-amber-100 text-amber-600"
                                            ]}>
                                                {fmtPeriod(gap.period)}
                                            </span>
                                        ))}
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 text-center align-middle">
                                    <span class:list={["rounded-full px-2.5 py-0.5 text-xs font-semibold whitespace-nowrap", SEVERITY_BADGE[sev]]}>
                                        {[
                                            missing.length > 0 && `${missing.length} sin registro`,
                                            pending.length > 0 && `${pending.length} pendiente${pending.length !== 1 ? "s" : ""}`
                                        ].filter(Boolean).join(" · ")}
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 text-right font-mono font-semibold text-slate-700 align-middle">
                                    {bob(total)}
                                </td>
                                <td class="py-3.5 px-4 text-right align-middle">
                                    <a
                                        href={`/rrhh/personal/${group.employeeId}#deudas`}
                                        class="inline-flex items-center gap-1.5 rounded border border-violet-200 bg-violet-50 px-3 py-1.5 text-xs font-medium text-violet-700 hover:bg-violet-100 transition-colors whitespace-nowrap"
                                    >
                                        <CreditCard class="size-3 shrink-0" />
                                        Ver perfil
                                    </a>
                                </td>
                            </tr>
                        );
                    })}
                </tbody>
            </table>
        </div>
    </div>
)}

<!-- INQUILINOS — one row, one link to profile#deudas -->
{tenantGapsGrouped.length > 0 && (
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100 flex items-center gap-2">
            <Building class="size-4 text-blue-500" />
            <h2 class="font-semibold text-slate-800 text-sm">
                Inquilinos — {tenantGapsGrouped.length} con deuda
            </h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 text-xs text-slate-500 border-b border-slate-200">
                    <tr>
                        <th class="py-3 px-5 text-left font-medium">Inquilino</th>
                        <th class="py-3 px-4 text-left font-medium">Períodos afectados</th>
                        <th class="py-3 px-4 text-center font-medium">Estado</th>
                        <th class="py-3 px-4 text-right font-medium">Deuda total</th>
                        <th class="py-3 px-4 text-right font-medium"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {tenantGapsGrouped.map((group) => {
                        const sev = severity(group.periods);
                        const missing = group.periods.filter(p => p.kind === "missing");
                        const pending = group.periods.filter(p => p.kind === "pending");
                        const total = group.periods.reduce(
                            (s, g) => s + (g.kind === "pending" ? g.amount : g.expectedAmount), 0
                        );
                        return (
                            <tr class:list={["transition-colors hover:brightness-95", SEVERITY_ROW[sev]]}>
                                <td class="py-3.5 px-5 align-middle">
                                    <a href={`/inquilinos/${group.tenantId}#deudas`} class="group">
                                        <p class="font-medium text-slate-900 group-hover:text-blue-700 transition-colors">{group.fullName}</p>
                                        <p class="text-xs text-slate-400">Amb. {group.roomNumber}</p>
                                    </a>
                                </td>
                                <td class="py-3.5 px-4 align-middle">
                                    <div class="flex flex-wrap gap-1">
                                        {group.periods.map((gap) => (
                                            <span class:list={[
                                                "inline-flex rounded px-1.5 py-0.5 text-xs font-medium",
                                                gap.kind === "missing" ? "bg-red-100 text-red-600" : "bg-amber-100 text-amber-600"
                                            ]}>
                                                {fmtPeriod(gap.period)}
                                            </span>
                                        ))}
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 text-center align-middle">
                                    <span class:list={["rounded-full px-2.5 py-0.5 text-xs font-semibold whitespace-nowrap", SEVERITY_BADGE[sev]]}>
                                        {[
                                            missing.length > 0 && `${missing.length} sin registro`,
                                            pending.length > 0 && `${pending.length} pendiente${pending.length !== 1 ? "s" : ""}`
                                        ].filter(Boolean).join(" · ")}
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 text-right font-mono font-semibold text-slate-700 align-middle">
                                    {bob(total)}
                                </td>
                                <td class="py-3.5 px-4 text-right align-middle">
                                    <a
                                        href={`/inquilinos/${group.tenantId}#deudas`}
                                        class="inline-flex items-center gap-1.5 rounded border border-blue-200 bg-blue-50 px-3 py-1.5 text-xs font-medium text-blue-700 hover:bg-blue-100 transition-colors whitespace-nowrap"
                                    >
                                        <ExternalLink class="size-3 shrink-0" />
                                        Ver perfil
                                    </a>
                                </td>
                            </tr>
                        );
                    })}
                </tbody>
            </table>
        </div>
    </div>
)}

</FinanceLayout>
