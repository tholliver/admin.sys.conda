{
  "name": "admin-sys-conda",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "bun": ">=1.3.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:init": "bun run src/db/data/migrate.ts",
    "db:drop-all": "bun run src/db/re-init.ts drop-all",
    "db:report": "bun run src/db/re-init.ts report",
    "db:query": "bun run src/db/queries.ts",
    "db:mock": "bun run src/db/mock.ts",
    "db:mock-dev": "bun run src/db/mock.ts && bun run src/db/mock.dev.ts",
    "bk:setup": "bun run src/jobs/setup-cron.ts",
    "bk:remove": "bun run src/jobs/remove-cron.ts",
    "bk:now": "bun run src/jobs/backup.job.ts"
  },
  "dependencies": {
    "3": "^2.1.0",
    "@astrojs/check": "^0.9.8",
    "@astrojs/node": "^10.0.5",
    "@astrojs/svelte": "^8.0.5",
    "@astrojs/vercel": "10.0.4",
    "@lucide/astro": "^1.8.0",
    "@lucide/svelte": "^1.8.0",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "6.1.8",
    "better-auth": "^1.6.5",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "svelte": "^5.55.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
