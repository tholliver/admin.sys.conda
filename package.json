{
  "name": "admin-sys-conda",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "bun": ">=1.3.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:drop-all": "bun run src/db/re-init.ts drop-all",
    "db:init": "bun run db:drop-all && bun run db:generate && bun run db:migrate && bun run db:mock",
    "db:report": "bun run src/db/re-init.ts report",
    "db:query": "bun run src/db/queries.ts",
    "db:mock": "bun run src/db/mock.ts",
    "db:mock-dev": "bun run src/db/mock.ts && bun run src/db/mock.dev.ts",
    "bk:setup": "bun run src/jobs/setup-cron.ts",
    "bk:remove": "bun run src/jobs/remove-cron.ts",
    "bk:now": "bun run src/jobs/backup.job.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/node": "^10.1.0",
    "@astrojs/svelte": "^8.1.0",
    "@lucide/astro": "^1.14.0",
    "@lucide/svelte": "^1.14.0",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "6.3.0",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "svelte": "^5.55.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "svelte-check": "^4.4.8"
  }
}
